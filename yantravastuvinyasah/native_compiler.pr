// ============================================================================
// प्रज्ञा (Prajna) — स्वदेशी-सङ्कलकः (Native Windows PE Compiler)
// सञ्चिका: prajna/yantravastuvinyasah/native_compiler.pr
// ============================================================================

फलनम् सङ्कलक_रचना() {
    चलम् सङ्क = कोष_रचय();
    कोष_स्थापय(सङ्क, "उत्पादन_प्रकारः", "exe");
    कोष_स्थापय(सङ्क, "अनुकूलनम्", सत्यम्);
    प्रत्यागच्छ सङ्क;
}

// सी-शार्प सङ्कलन-आदेश-निर्माणम्
फलनम् csc_आदेश_रचय(स्रोतः_cs, निर्गम_exe, चित्रमयम्) {
    चलम् लक्ष्यम् = "/target:exe";
    यदि (चित्रमयम्) {
        लक्ष्यम् = "/target:winexe";
    }
    चलम् csc = "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe";
    चलम् आदेशः = csc + " /nologo /codepage:65001 /optimize+ " + लक्ष्यम् + " /r:System.dll /r:System.Core.dll /r:Microsoft.CSharp.dll /r:System.Windows.Forms.dll /r:System.Drawing.dll /out:" + निर्गम_exe + " " + स्रोतः_cs;
    प्रत्यागच्छ आदेशः;
}

// स्वदेशी-सङ्कलक-परीक्षणम् (Self-test)
फलनम् स्वदेशी_सङ्कलक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: स्वदेशी-सङ्कलकः] ---";
    चलम् csc_आदेश = csc_आदेश_रचय("test.cs", "test.exe", असत्यम्);
    लिख "निर्मितः CSC आदेशः:";
    लिख csc_आदेश;
    लिख "स्वदेशी-सङ्कलक-परीक्षणं सम्पूर्णम्!\n";
}

स्वदेशी_सङ्कलक_परीक्षणम्();
