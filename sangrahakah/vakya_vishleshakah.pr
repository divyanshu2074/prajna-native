// ============================================================================
// प्रज्ञा (Prajna) — वाक्यविश्लेषकः (Syntax Parser)
// सञ्चिका: prajna/sangrahakah/vakya_vishleshakah.pr
// ============================================================================

// अमूर्त नोड्-निर्माणम् (AST Node Helpers)
फलनम् नोड्_पूर्णाङ्क(संख्या) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "PURNANKA");
    कोष_स्थापय(नो, "मूल्यम्", संख्या);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_सूत्रम्(पाठः) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "SUTRAM");
    कोष_स्थापय(नो, "मूल्यम्", पाठः);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_नामपदम्(नामन्) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "NAMAPADA");
    कोष_स्थापय(नो, "नामन्", नामन्);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_द्विविध(वाम, क्रिया, दक्षिण) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "DVIVIDHA");
    कोष_स्थापय(नो, "वाम", वाम);
    कोष_स्थापय(नो, "क्रिया", क्रिया);
    कोष_स्थापय(नो, "दक्षिण", दक्षिण);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_चलघोषणा(नामन्, मूल्यम्) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "CHALA_GHOSHANA");
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "मूल्यम्", मूल्यम्);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_लिख(अभिव्यक्ति) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "LIKHA");
    कोष_स्थापय(नो, "अभिव्यक्तिः", अभिव्यक्ति);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_यदि(प्रतिबन्धः, सत्यशाखा, अन्यथाशाखा) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "YADI");
    कोष_स्थापय(नो, "प्रतिबन्धः", प्रतिबन्धः);
    कोष_स्थापय(नो, "सत्यशाखा", सत्यशाखा);
    कोष_स्थापय(नो, "अन्यथाशाखा", अन्यथाशाखा);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_यावत्(प्रतिबन्धः, शरीरम्) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "YAVAT");
    कोष_स्थापय(नो, "प्रतिबन्धः", प्रतिबन्धः);
    कोष_स्थापय(नो, "शरीरम्", शरीरम्);
    प्रत्यागच्छ नो;
}

फलनम् नोड्_फलनम्(नामन्, तर्काः, शरीरम्) {
    चलम् नो = कोष_रचय();
    कोष_स्थापय(नो, "प्रकारः", "PHALANAM");
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "तर्काः", तर्काः);
    कोष_स्थापय(नो, "शरीरम्", शरीरम्);
    प्रत्यागच्छ नो;
}

// वाक्यविश्लेषकस्य स्थितिः (Parser State as Dictionary)
फलनम् विश्लेषक_रचय(चिह्नानि) {
    चलम् वि = कोष_रचय();
    कोष_स्थापय(वि, "चिह्नानि", चिह्नानि);
    कोष_स्थापय(वि, "दीर्घता", सूची_दीर्घता(चिह्नानि));
    कोष_स्थापय(वि, "सूचकः", ०);
    प्रत्यागच्छ वि;
}

फलनम् वि_वर्तमान(वि) {
    चलम् सू = कोष_प्राप्नु(वि, "सूचकः");
    चलम् दी = कोष_प्राप्नु(वि, "दीर्घता");
    यदि (सू >= दी) {
        प्रत्यागच्छ "";
    }
    चलम् चि = सूची_प्राप्नु(कोष_प्राप्नु(वि, "चिह्नानि"), सू);
    प्रत्यागच्छ चि;
}

फलनम् वि_अग्रेसर(वि) {
    चलम् सू = कोष_प्राप्नु(वि, "सूचकः");
    कोष_स्थापय(वि, "सूचकः", सू + १);
}

// टोकन-परीक्षणम्
फलनम् टोकन_मूल्यम्(टो) {
    यदि (टो == "") { प्रत्यागच्छ ""; }
    प्रत्यागच्छ कोष_प्राप्नु(टो, "मूल्यम्");
}

फलनम् टोकन_भेदः(टो) {
    यदि (टो == "") { प्रत्यागच्छ ""; }
    प्रत्यागच्छ कोष_प्राप्नु(टो, "भेदः");
}

// प्राथमिक-अभिव्यक्ति-विश्लेषणम् (Primary Expression)
फलनम् विश्लेषय_प्राथमिक(वि) {
    चलम् वर्तमानः = वि_वर्तमान(वि);
    चलम् भेदः = टोकन_भेदः(वर्तमानः);
    चलम् मूल्यम् = टोकन_मूल्यम्(वर्तमानः);

    यदि (भेदः == "PURNANKA") {
        वि_अग्रेसर(वि);
        प्रत्यागच्छ नोड्_पूर्णाङ्क(मूल्यम्);
    }
    यदि (भेदः == "SUTRAM") {
        वि_अग्रेसर(वि);
        प्रत्यागच्छ नोड्_सूत्रम्(मूल्यम्);
    }
    यदि (भेदः == "NAMAN") {
        वि_अग्रेसर(वि);
        प्रत्यागच्छ नोड्_नामपदम्(मूल्यम्);
    }
    यदि (मूल्यम् == "(") {
        वि_अग्रेसर(वि); // (
        चलम् अभ्यन्तरम् = विश्लेषय_योग(वि);
        यदि (टोकन_मूल्यम्(वि_वर्तमान(वि)) == ")") {
            वि_अग्रेसर(वि); // )
        }
        प्रत्यागच्छ अभ्यन्तरम्;
    }

    वि_अग्रेसर(वि);
    प्रत्यागच्छ नोड्_नामपदम्(मूल्यम्);
}

// गुणन-भाग-शेषफलम् (*, /, %)
फलनम् विश्लेषय_गुणन(वि) {
    चलम् वाम = विश्लेषय_प्राथमिक(वि);
    चलम् समाप्तम् = असत्यम्;

    यावत् (समाप्तम् == असत्यम्) {
        चलम् मू = टोकन_मूल्यम्(वि_वर्तमान(वि));
        यदि (मू == "*" वा मू == "/" वा मू == "%") {
            वि_अग्रेसर(वि);
            चलम् दक्षिण = विश्लेषय_प्राथमिक(वि);
            वाम = नोड्_द्विविध(वाम, मू, दक्षिण);
        } अन्यथा {
            समाप्तम् = सत्यम्;
        }
    }
    प्रत्यागच्छ वाम;
}

// योग-व्यवकलनम् (+, -)
फलनम् विश्लेषय_योग(वि) {
    चलम् वाम = विश्लेषय_गुणन(वि);
    चलम् समाप्तम् = असत्यम्;

    यावत् (समाप्तम् == असत्यम्) {
        चलम् मू = टोकन_मूल्यम्(वि_वर्तमान(वि));
        यदि (मू == "+" वा मू == "-") {
            वि_अग्रेसर(वि);
            चलम् दक्षिण = विश्लेषय_गुणन(वि);
            वाम = नोड्_द्विविध(वाम, मू, दक्षिण);
        } अन्यथा {
            समाप्तम् = सत्यम्;
        }
    }
    प्रत्यागच्छ वाम;
}

// वाक्य-विश्लेषणम् (Statement Parser)
फलनम् विश्लेषय_वाक्यम्(वि) {
    चलम् वर्तमानः = वि_वर्तमान(वि);
    चलम् मू = टोकन_मूल्यम्(वर्तमानः);

    // चलम् नाम = मूल्यम्;
    यदि (मू == "चलम्") {
        वि_अग्रेसर(वि); // चलम्
        चलम् नामन् = टोकन_मूल्यम्(वि_वर्तमान(वि));
        वि_अग्रेसर(वि); // नाम
        यदि (टोकन_मूल्यम्(वि_वर्तमान(वि)) == "=") {
            वि_अग्रेसर(वि); // =
        }
        चलम् प्रारम्भ_मूल्यम् = विश्लेषय_योग(वि);
        यदि (टोकन_मूल्यम्(वि_वर्तमान(वि)) == ";") {
            वि_अग्रेसर(वि); // ;
        }
        प्रत्यागच्छ नोड्_चलघोषणा(नामन्, प्रारम्भ_मूल्यम्);
    }

    // लिख अभिव्यक्ति;
    यदि (मू == "लिख") {
        वि_अग्रेसर(वि); // लिख
        चलम् अभि = विश्लेषय_योग(वि);
        यदि (टोकन_मूल्यम्(वि_वर्तमान(वि)) == ";") {
            वि_अग्रेसर(वि); // ;
        }
        प्रत्यागच्छ नोड्_लिख(अभि);
    }

    // सामान्य-अग्रेसरणम्
    वि_अग्रेसर(वि);
    प्रत्यागच्छ नोड्_नामपदम्(मू);
}

// सम्पूर्ण-कार्यक्रम-विश्लेषणम्
फलनम् विश्लेषय_कार्यक्रमम्(वि) {
    चलम् वाक्यानि = सूची_रचय();
    चलम् दी = कोष_प्राप्नु(वि, "दीर्घता");

    यावत् (कोष_प्राप्नु(वि, "सूचकः") < दी) {
        चलम् मू = टोकन_मूल्यम्(वि_वर्तमान(वि));
        यदि (मू == ";") {
            वि_अग्रेसर(वि);
        } अन्यथा {
            चलम् एक_वाक्यम् = विश्लेषय_वाक्यम्(वि);
            सूची_योजय(वाक्यानि, एक_वाक्यम्);
        }
    }
    प्रत्यागच्छ वाक्यानि;
}

// वाक्यविश्लेषक-परीक्षणम् (Self-test)
फलनम् वाक्यविश्लेषक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: वाक्यविश्लेषकः] ---";
    चलम् चि = सूची_रचय();
    चलम् टो१ = कोष_रचय(); कोष_स्थापय(टो१, "भेदः", "KEYWORD"); कोष_स्थापय(टो१, "मूल्यम्", "चलम्"); सूची_योजय(चि, टो१);
    चलम् टो२ = कोष_रचय(); कोष_स्थापय(टो२, "भेदः", "NAMAN"); कोष_स्थापय(टो२, "मूल्यम्", "क्ष"); सूची_योजय(चि, टो२);
    चलम् टो३ = कोष_रचय(); कोष_स्थापय(टो३, "भेदः", "PUNCTUATION"); कोष_स्थापय(टो३, "मूल्यम्", "="); सूची_योजय(चि, टो३);
    चलम् टो४ = कोष_रचय(); कोष_स्थापय(टो४, "भेदः", "PURNANKA"); कोष_स्थापय(टो४, "मूल्यम्", "10"); सूची_योजय(चि, टो४);
    चलम् टो५ = कोष_रचय(); कोष_स्थापय(टो५, "भेदः", "PUNCTUATION"); कोष_स्थापय(टो५, "मूल्यम्", "+"); सूची_योजय(चि, टो५);
    चलम् टो६ = कोष_रचय(); कोष_स्थापय(टो६, "भेदः", "PURNANKA"); कोष_स्थापय(टो६, "मूल्यम्", "20"); सूची_योजय(चि, टो६);
    चलम् टो७ = कोष_रचय(); कोष_स्थापय(टो७, "भेदः", "PUNCTUATION"); कोष_स्थापय(टो७, "मूल्यम्", ";"); सूची_योजय(चि, टो७);
    चलम् टो८ = कोष_रचय(); कोष_स्थापय(टो८, "भेदः", "KEYWORD"); कोष_स्थापय(टो८, "मूल्यम्", "लिख"); सूची_योजय(चि, टो८);
    चलम् टो९ = कोष_रचय(); कोष_स्थापय(टो९, "भेदः", "NAMAN"); कोष_स्थापय(टो९, "मूल्यम्", "क्ष"); सूची_योजय(चि, टो९);
    चलम् टो१० = कोष_रचय(); कोष_स्थापय(टो१०, "भेदः", "PUNCTUATION"); कोष_स्थापय(टो१०, "मूल्यम्", ";"); सूची_योजय(चि, टो१०);

    चलम् वि = विश्लेषक_रचय(चि);
    चलम् कार्य = विश्लेषय_कार्यक्रमम्(वि);
    चलम् संख्या = सूची_दीर्घता(कार्य);
    लिख "विश्लेषितवाक्यानां सङ्ख्या = " + सूत्र_परिवर्तय(संख्या);

    चलम् अ = ०;
    यावत् (अ < संख्या) {
        चलम् एक_वा = सूची_प्राप्नु(कार्य, अ);
        लिख "वाक्यम् " + सूत्र_परिवर्तय(अ) + ": [" + कोष_प्राप्नु(एक_वा, "प्रकारः") + "]";
        अ = अ + १;
    }
    लिख "वाक्यविश्लेषक-परीक्षणं सम्पूर्णम्!\n";
}

वाक्यविश्लेषक_परीक्षणम्();
