}

फलनम् अमूर्त_यदि(प्रतिबन्धः, सत्यशाखा, अन्यथाशाखा, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("YADI", पं, स्त);
    कोष_स्थापय(नो, "प्रतिबन्धः", प्रतिबन्धः);
    कोष_स्थापय(नो, "सत्यशाखा", सत्यशाखा);
    कोष_स्थापय(नो, "अन्यथाशाखा", अन्यथाशाखा);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_यावत्(प्रतिबन्धः, शरीरम्, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("YAVAT", पं, स्त);
    कोष_स्थापय(नो, "प्रतिबन्धः", प्रतिबन्धः);
    कोष_स्थापय(नो, "शरीरम्", शरीरम्);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_फलनम्(नामन्, तर्काः, शरीरम्, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("PHALANAM", पं, स्त);
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "तर्काः", तर्काः);
    कोष_स्थापय(नो, "शरीरम्", शरीरम्);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_प्रत्यागच्छ(अभिव्यक्ति, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("PRATYAGACCHA", पं, स्त);
    कोष_स्थापय(नो, "अभिव्यक्तिः", अभिव्यक्ति);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_आह्वान(नामन्, तर्काः, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("AHVANA", पं, स्त);
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "तर्काः", तर्काः);
    प्रत्यागच्छ नो;
}

// नोड्-विवरणम् (Node description)
फलनम् अमूर्त_विवरणम्(नोड्) {
    चलम् प्र = सूत्र_परिवर्तय(कोष_प्राप्नु(नोड्, "प्रकारः"));
    यदि (प्र == "PURNANKA") {
        प्रत्यागच्छ "पूर्णाङ्क(" + सूत्र_परिवर्तय(कोष_प्राप्नु(नोड्, "मूल्यम्")) + ")";
    }
    यदि (प्र == "SUTRAM") {
        प्रत्यागच्छ "सूत्रम्(" + सूत्र_परिवर्तय(कोष_प्राप्नु(नोड्, "मूल्यम्")) + ")";
    }
    यदि (प्र == "NAMAPADA") {
        प्रत्यागच्छ "नाम(" + सूत्र_परिवर्तय(कोष_प्राप्नु(नोड्, "नामन्")) + ")";
    }
    यदि (प्र == "CHALA_GHOSHANA") {
        प्रत्यागच्छ "चलम्(" + सूत्र_परिवर्तय(कोष_प्राप्नु(नोड्, "नामन्")) + ")";
    }
    यदि (प्र == "LIKHA") {
        प्रत्यागच्छ "लिख(" + अमूर्त_विवरणम्(कोष_प्राप्नु(नोड्, "अभिव्यक्तिः")) + ")";
    }
    प्रत्यागच्छ "नोड्(" + प्र + ")";
}

// वाक्यवृक्ष-परीक्षणम् (Self-test)
फलनम् वाक्यवृक्ष_परीक्षणम्() {
    लिख "--- [परीक्षणम्: अमूर्तवाक्यवृक्षः] ---";
    चलम् अ१ = अमूर्त_पूर्णाङ्क(४२, १, १);
    लिख अमूर्त_विवरणम्(अ१);
    चलम् अ२ = अमूर्त_चलघोषणा("योगः", अ१, १, १);
    लिख अमूर्त_विवरणम्(अ२);
    चलम् अ३ = अमूर्त_लिख(अ१, २, १);
    लिख अमूर्त_विवरणम्(अ३);
    लिख "अमूर्तवाक्यवृक्ष-परीक्षणं सम्पूर्णम्!\n";
}

वाक्यवृक्ष_परीक्षणम्();
