// ============================================================================
// प्रज्ञा (Prajna) — प्रवर्धित-सामर्थ्य-परीक्षणमाला (Expanded Capabilities Test Suite)
// सञ्चिका: parikshanani/test_expanded_capabilities.pr
// ============================================================================

फलनम् प्रवर्धित_परीक्षणम्() {
    लिख "==================================================";
    लिख "प्रज्ञा प्रवर्धित-सामर्थ्य-परीक्षणम् (Expanded Capabilities Test)";
    लिख "==================================================";

    // १. समुच्चयः (Sets)
    लिख "\n--- १. समुच्चय-परीक्षणम् (Set Operations) ---";
    चलम् स१ = समुच्चय_रचय();
    समुच्चय_योजय(स१, "ऋग्वेदः");
    समुच्चय_योजय(स१, "यजुर्वेदः");
    समुच्चय_योजय(स१, "सामवेदः");
    समुच्चय_योजय(स१, "ऋग्वेदः"); // पुनरावृत्ति-निरोधः (No duplicate)
    लिख "समुच्चय-दीर्घता: " + सूत्र_परिवर्तय(समुच्चय_दीर्घता(स१));
    लिख "ऋग्वेदः अस्ति? " + सूत्र_परिवर्तय(समुच्चय_अस्ति(स१, "ऋग्वेदः"));
    लिख "अथर्ववेदः अस्ति? " + सूत्र_परिवर्तय(समुच्चय_अस्ति(स१, "अथर्ववेदः"));

    चलम् स२ = समुच्चय_रचय();
    समुच्चय_योजय(स२, "सामवेदः");
    समुच्चय_योजय(स२, "अथर्ववेदः");
    चलम् मेलनम् = समुच्चय_मेलनम्(स१, स२);
    लिख "मेलन-दीर्घता (Union): " + सूत्र_परिवर्तय(समुच्चय_दीर्घता(मेलनम्));
    चलम् छेदः = समुच्चय_छेदः(स१, स२);
    लिख "छेद-दीर्घता (Intersection): " + सूत्र_परिवर्तय(समुच्चय_दीर्घता(छेदः));

    // २. युग्मम् (Tuples)
    लिख "\n--- २. युग्म-परीक्षणम् (Tuples) ---";
    चलम् युग्म = युग्म_रचय("काशी", २२१००१, सत्यम्);
    लिख "युग्म-दीर्घता: " + सूत्र_परिवर्तय(युग्म_दीर्घता(युग्म));
    लिख "युग्म-स्थानम्: " + सूत्र_परिवर्तय(युग्म_प्राप्नु(युग्म, ०));
    लिख "युग्म-पिनकोड: " + सूत्र_परिवर्तय(युग्म_प्राप्नु(युग्म, १));

    // ३. दोष-नियन्त्रणम् (Exception Handling: प्रयत्नः / गृह्णातु / अन्ते / उत्थापय)
    लिख "\n--- ३. दोष-नियन्त्रण-परीक्षणम् (Try / Catch / Finally) ---";
    चलम् दोष_सङ्केतः = "शान्तिः";
    प्रयत्नः {
        लिख "प्रयत्न-खण्डः प्रारब्धः...";
        उत्थापय "गणितीय-सीमा-उल्लङ्घनम्";
        दोष_सङ्केतः = "न_प्राप्तम्";
    } गृह्णातु (त्रुटि) {
        दोष_सङ्केतः = "दोषः_गृहीतः";
        लिख "सफलतापूर्वकं त्रुटिः गृहीता!";
    } अन्ते {
        लिख "अन्ते-खण्डः निष्पादितः (Finally executed).";
    }
    लिख "दोष-स्थितिः: " + दोष_सङ्केतः;

    // ४. उच्च-क्रम-फलनानि सङ्ग्रह-विधयः च (Functional & Aggregations)
    लिख "\n--- ४. सङ्ग्रह-गणन-परीक्षणम् (Aggregations & Functional) ---";
    चलम् अङ्क_सूची = सूची_रचय();
    सूची_योजय(अङ्क_सूची, १०);
    सूची_योजय(अङ्क_सूची, २५);
    सूची_योजय(अङ्क_सूची, ५);
    सूची_योजय(अङ्क_सूची, ६०);

    चलम् कुल_योगः = योगः(अङ्क_सूची);
    चलम् अल्पतमम् = न्यूनतमम्(अङ्क_सूची);
    चलम् महत्तमम् = अधिकतमम्(अङ्क_सूची);
    लिख "योगः (Sum): " + सूत्र_परिवर्तय(कुल_योगः);
    लिख "न्यूनतमम् (Min): " + सूत्र_परिवर्तय(अल्पतमम्);
    लिख "अधिकतमम् (Max): " + सूत्र_परिवर्तय(महत्तमम्);

    चलम् परि = परिसरः(०, ५, १);
    लिख "परिसरः [०..५]: " + सूत्र_परिवर्तय(सूची_दीर्घता(परि));

    // ५. मार्ग-प्रबन्धनम् (Path Operations)
    लिख "\n--- ५. मार्ग-प्रबन्धन-परीक्षणम् (Path Operations) ---";
    चलम् पूर्ण_मार्गः = मार्ग_संयोजय("prajna", "compiler.pr");
    लिख "संयोजित-मार्गः: " + पूर्ण_मार्गः;
    लिख "मूलनाम (Basename): " + मार्ग_मूलनाम(पूर्ण_मार्गः);
    लिख "विस्तारः (Extension): " + मार्ग_विस्तारः(पूर्ण_मार्गः);

    // ६. गणित-साङ्ख्यिकी च (Advanced Math & Statistics)
    लिख "\n--- ६. गणित-साङ्ख्यिकी-परीक्षणम् (Math & Stats) ---";
    चलम् माध्यम् = गणित_माध्यम्(अङ्क_सूची);
    चलम् मध्यिका = गणित_मध्यिका(अङ्क_सूची);
    लिख "माध्यम् (Mean): " + सूत्र_परिवर्तय(माध्यम्);
    लिख "मध्यिका (Median): " + सूत्र_परिवर्तय(मध्यिका);

    // ७. वस्तु-प्रबन्धनम् (Dynamic Objects / Records)
    लिख "\n--- ७. वस्तु-प्रबन्धन-परीक्षणम् (Object / Records) ---";
    चलम् छात्रः = वस्तु_रचय();
    वस्तु_स्थापय(छात्रः, "नाम", "आर्यभटः");
    वस्तु_स्थापय(छात्रः, "विषयः", "खगोलशास्त्रम्");
    वस्तु_स्थापय(छात्रः, "अङ्काः", १००);
    लिख "छात्र-नाम: " + सूत्र_परिवर्तय(वस्तु_प्राप्नु(छात्रः, "नाम"));
    लिख "छात्र-विषयः: " + सूत्र_परिवर्तय(वस्तु_प्राप्नु(छात्रः, "विषयः"));

    // ८. प्रचालनतन्त्र-परीक्षणम् (Cross-Platform OS Platform Detection)
    लिख "\n--- ८. प्रचालनतन्त्रम् (OS Platform) ---";
    चलम् ओएस = प्रणाली_सञ्चालकः();
    लिख "वर्तमान-प्रचालनतन्त्रम्: " + ओएस;

    लिख "\n==================================================";
    लिख "सर्वे प्रवर्धित-सामर्थ्य-परीक्षणाः सफलाः जाताः!";
    लिख "==================================================";
}

प्रवर्धित_परीक्षणम्();
