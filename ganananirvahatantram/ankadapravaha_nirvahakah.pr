// ============================================================================
// प्रज्ञा (Prajna) — आँकडाप्रवाह-गणनानिर्वाहकः (Dataflow Runtime Engine)
// सञ्चिका: prajna/ganananirvahatantram/ankadapravaha_nirvahakah.pr
// ============================================================================

फलनम् प्रवाह_निर्वाहक_रचय(गण्यान्त्राणि_सङ्ख्या) {
    चलम् निर् = कोष_रचय();
    कोष_स्थापय(निर्, "गण्यान्त्राणि", गण्यान्त्राणि_सङ्ख्या);
    कोष_स्थापय(निर्, "स्मृतिः", कोष_रचय());
    कोष_स्थापय(निर्, "निष्पादित_सङ्ख्या", ०);
    प्रत्यागच्छ निर्;
}

फलनम् प्रवाह_बिन्दु_निष्पादय(निर्, बिन्दुः, जालम्) {
    चलम् क्रिया = कोष_प्राप्नु(बिन्दुः, "क्रिया");
    चलम् निर्देश = कोष_प्राप्नु(बिन्दुः, "निर्देशः");
    चलम् निवेश = कोष_प्राप्नु(बिन्दुः, "निवेश_स्रोतः");
    चलम् दी = सूची_दीर्घता(निवेश);

    चलम् फलम् = ०;

    यदि (क्रिया == "LOAD_CONST") {
        फलम् = पूर्णाङ्क_परिवर्तय(निर्देश);
    }
    अन्यथा यदि (क्रिया == "ADD") {
        चलम् बिन्दवः = कोष_प्राप्नु(जालम्, "बिन्दवः");
        चलम् आइडी१ = सूत्र_परिवर्तय(सूची_प्राप्नु(निवेश, ०));
        चलम् आइडी२ = सूत्र_परिवर्तय(सूची_प्राप्नु(निवेश, १));
        चलम् ब१ = कोष_प्राप्नु(बिन्दवः, आइडी१);
        चलम् ब२ = कोष_प्राप्नु(बिन्दवः, आइडी२);
        फलम् = कोष_प्राप्नु(ब१, "निर्गतम्") + कोष_प्राप्नु(ब२, "निर्गतम्");
    }
    अन्यथा यदि (क्रिया == "PRINT") {
        चलम् बिन्दवः = कोष_प्राप्नु(जालम्, "बिन्दवः");
        चलम् आइडी१ = सूत्र_परिवर्तय(सूची_प्राप्नु(निवेश, ०));
        चलम् ब१ = कोष_प्राप्नु(बिन्दवः, आइडी१);
        फलम् = कोष_प्राप्नु(ब१, "निर्गतम्");
        लिख फलम्;
    }

    कोष_स्थापय(बिन्दुः, "निर्गतम्", फलम्);
    कोष_स्थापय(बिन्दुः, "सम्पूर्णम्", सत्यम्);
    प्रत्यागच्छ फलम्;
}

// आँकडाप्रवाह-निर्वाहक-परीक्षणम् (Self-test)
फलनम् प्रवाह_निर्वाहक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: आँकडाप्रवाह-निर्वाहकः] ---";
    चलम् निर् = प्रवाह_निर्वाहक_रचय(४);

    चलम् जालम् = कोष_रचय();
    चलम् बिन्दवः = कोष_रचय();
    कोष_स्थापय(जालम्, "बिन्दवः", बिन्दवः);

    // बिन्दु १: LOAD_CONST 50
    चलम् ब१ = कोष_रचय();
    कोष_स्थापय(ब१, "क्रमाङ्कः", १);
    कोष_स्थापय(ब१, "क्रिया", "LOAD_CONST");
    कोष_स्थापय(ब१, "निर्देशः", "50");
    कोष_स्थापय(ब१, "निवेश_स्रोतः", सूची_रचय());
    कोष_स्थापय(बिन्दवः, "1", ब१);

    // बिन्दु २: LOAD_CONST 30
    चलम् ब२ = कोष_रचय();
    कोष_स्थापय(ब२, "क्रमाङ्कः", २);
    कोष_स्थापय(ब२, "क्रिया", "LOAD_CONST");
    कोष_स्थापय(ब२, "निर्देशः", "30");
    कोष_स्थापय(ब२, "निवेश_स्रोतः", सूची_रचय());
    कोष_स्थापय(बिन्दवः, "2", ब२);

    // बिन्दु ३: ADD (1, 2)
    चलम् ब३ = कोष_रचय();
    कोष_स्थापय(ब३, "क्रमाङ्कः", ३);
    कोष_स्थापय(ब३, "क्रिया", "ADD");
    कोष_स्थापय(ब३, "निर्देशः", "+");
    चलम् निवेश३ = सूची_रचय(); सूची_योजय(निवेश३, 1); सूची_योजय(निवेश३, 2);
    कोष_स्थापय(ब३, "निवेश_स्रोतः", निवेश३);
    कोष_स्थापय(बिन्दवः, "3", ब३);

    // बिन्दु ४: PRINT (3)
    चलम् ब४ = कोष_रचय();
    कोष_स्थापय(ब४, "क्रमाङ्कः", ४);
    कोष_स्थापय(ब४, "क्रिया", "PRINT");
    कोष_स्थापय(ब४, "निर्देशः", "PRINT");
    चलम् निवेश४ = सूची_रचय(); सूची_योजय(निवेश४, 3);
    कोष_स्थापय(ब४, "निवेश_स्रोतः", निवेश४);
    कोष_स्थापय(बिन्दवः, "4", ब४);

    लिख "आँकडाप्रवाह-गणना फलम्:";
    प्रवाह_बिन्दु_निष्पादय(निर्, ब१, जालम्);
    प्रवाह_बिन्दु_निष्पादय(निर्, ब२, जालम्);
    प्रवाह_बिन्दु_निष्पादय(निर्, ब३, जालम्);
    प्रवाह_बिन्दु_निष्पादय(निर्, ब४, जालम्);

    लिख "आँकडाप्रवाह-निर्वाहक-परीक्षणं सम्पूर्णम्!\n";
}

प्रवाह_निर्वाहक_परीक्षणम्();
