// ============================================================================
// प्रज्ञा (Prajna) — आईआर-तः-आईएसए रूपान्तरकः (IR to ISA Translator)
// सञ्चिका: prajna/yantravastuvinyasah/ir_to_isa.pr
// ============================================================================

फलनम् अनुवादक_रचय() {
    चलम् अनु = कोष_रचय();
    कोष_स्थापय(अनु, "चलराशि_स्थानम्", कोष_रचय());
    कोष_स्थापय(अनु, "अग्रिम_स्थानम्", ०);
    कोष_स्थापय(अनु, "पञ्जिका_चितिः", सूची_रचय());
    कोष_स्थापय(अनु, "उपलब्ध_पञ्जिकाः", सूची_रचय());

    // R2 to R11 available
    चलम् उप = कोष_प्राप्नु(अनु, "उपलब्ध_पञ्जिकाः");
    सूची_योजय(उप, २); सूची_योजय(उप, ३); सूची_योजय(उप, ४); सूची_योजय(उप, ५);
    सूची_योजय(उप, ६); सूची_योजय(उप, ७); सूची_योजय(उप, ८); सूची_योजय(उप, ९);
    सूची_योजय(उप, १०); सूची_योजय(उप, ११);

    प्रत्यागच्छ अनु;
}

फलनम् पञ्जिका_आबण्टनम्(अनु) {
    चलम् उप = कोष_प्राप्नु(अनु, "उपलब्ध_पञ्जिकाः");
    चलम् दी = सूची_दीर्घता(उप);
    यदि (दी == ०) {
        प्रत्यागच्छ २; // fallback
    }
    चलम् पञ्जि = सूची_प्राप्नु(उप, ०);
    सूची_निष्कासय(उप, ०);
    चलम् चिति = कोष_प्राप्नु(अनु, "पञ्जिका_चितिः");
    सूची_योजय(चिति, पञ्जि);
    प्रत्यागच्छ पञ्जि;
}

फलनम् पञ्जिका_मुक्तिः(अनु) {
    चलम् चिति = कोष_प्राप्नु(अनु, "पञ्जिका_चितिः");
    चलम् दी = सूची_दीर्घता(चिति);
    यदि (दी == ०) {
        प्रत्यागच्छ २;
    }
    चलम् पञ्जि = सूची_प्राप्नु(चिति, दी - १);
    सूची_निष्कासय(चिति, दी - १);
    चलम् उप = कोष_प्राप्नु(अनु, "उपलब्ध_पञ्जिकाः");
    सूची_योजय(उप, पञ्जि);
    प्रत्यागच्छ पञ्जि;
}

फलनम् चलराशि_स्थानम्_प्राप्नु(अनु, नामन्) {
    चलम् कोशः = कोष_प्राप्नु(अनु, "चलराशि_स्थानम्");
    यदि (कोष_अस्ति(कोशः, नामन्)) {
        प्रत्यागच्छ कोष_प्राप्नु(कोशः, नामन्);
    }
    चलम् स्था = कोष_प्राप्नु(अनु, "अग्रिम_स्थानम्");
    कोष_स्थापय(कोशः, नामन्, स्था);
    कोष_स्थापय(अनु, "अग्रिम_स्थानम्", स्था + ४);
    प्रत्यागच्छ स्था;
}

// आईआर-सूचीं Prajna-ISA-1 निर्देशेषु परिवर्तयति
फलनम् अनुवादय_आईआर_सूची(अनु, आईआर_सूची) {
    चलम् परिणामाः = सूची_रचय();
    चलम् दी = सूची_दीर्घता(आईआर_सूची);
    चलम् सूचकः = ०;

    यावत् (सूचकः < दी) {
        चलम् नि = सूची_प्राप्नु(आईआर_सूची, सूचकः);
        चलम् प्र = कोष_प्राप्नु(नि, "प्रकारः");
        चलम् त१ = कोष_प्राप्नु(नि, "तर्क१");

        यदि (प्र == "LOAD_CONST") {
            चलम् आर_डी = पञ्जिका_आबण्टनम्(अनु);
            चलम् इसा_नि = कोष_रचय();
            कोष_स्थापय(इसा_नि, "आदेशः", "LI");
            कोष_स्थापय(इसा_नि, "आर_डी", आर_डी);
            कोष_स्थापय(इसा_नि, "तत्कालिकम्", त१);
            सूची_योजय(परिणामाः, इसा_नि);
        }
        अन्यथा यदि (प्र == "LOAD_VAR") {
            चलम् आर_डी = पञ्जिका_आबण्टनम्(अनु);
            चलम् स्था = चलराशि_स्थानम्_प्राप्नु(अनु, त१);
            चलम् इसा_नि = कोष_रचय();
            कोष_स्थापय(इसा_नि, "आदेशः", "LOAD");
            कोष_स्थापय(इसा_नि, "आर_डी", आर_डी);
            कोष_स्थापय(इसा_नि, "आर_एस१", ०);
            कोष_स्थापय(इसा_नि, "तत्कालिकम्", स्था);
            सूची_योजय(परिणामाः, इसा_नि);
        }
        अन्यथा यदि (प्र == "STORE_VAR") {
            चलम् आर_स्रो = पञ्जिका_मुक्तिः(अनु);
            चलम् स्था = चलराशि_स्थानम्_प्राप्नु(अनु, त१);
            चलम् इसा_नि = कोष_रचय();
            कोष_स्थापय(इसा_नि, "आदेशः", "STORE");
            कोष_स्थापय(इसा_नि, "आर_एस२", आर_स्रो);
            कोष_स्थापय(इसा_नि, "आर_एस१", ०);
            कोष_स्थापय(इसा_नि, "तत्कालिकम्", स्था);
            सूची_योजय(परिणामाः, इसा_नि);
        }
        अन्यथा यदि (प्र == "ADD") {
            चलम् आर२ = पञ्जिका_मुक्तिः(अनु);
            चलम् आर१ = पञ्जिका_मुक्तिः(अनु);
            चलम् आर_लक्ष = पञ्जिका_आबण्टनम्(अनु);
            चलम् इसा_नि = कोष_रचय();
            कोष_स्थापय(इसा_नि, "आदेशः", "ADD");
            कोष_स्थापय(इसा_नि, "आर_डी", आर_लक्ष);
            कोष_स्थापय(इसा_नि, "आर_एस१", आर१);
            कोष_स्थापय(इसा_नि, "आर_एस२", आर२);
            सूची_योजय(परिणामाः, इसा_नि);
        }
        अन्यथा यदि (प्र == "PRINT") {
            चलम् आर_स्रो = पञ्जिका_मुक्तिः(अनु);
            चलम् इसा_नि = कोष_रचय();
            कोष_स्थापय(इसा_नि, "आदेशः", "OUT");
            कोष_स्थापय(इसा_नि, "आर_एस१", आर_स्रो);
            सूची_योजय(परिणामाः, इसा_नि);
        }

        सूचकः = सूचकः + १;
    }

    प्रत्यागच्छ परिणामाः;
}

// अनुवादक-परीक्षणम् (Self-test)
फलनम् अनुवादक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: आईआर-तः-आईएसए रूपान्तरकः] ---";
    चलम् अनु = अनुवादक_रचय();

    चलम् आईआर = सूची_रचय();
    चलम् नि१ = कोष_रचय(); कोष_स्थापय(नि१, "प्रकारः", "LOAD_CONST"); कोष_स्थापय(नि१, "तर्क१", १००); सूची_योजय(आईआर, नि१);
    चलम् नि२ = कोष_रचय(); कोष_स्थापय(नि२, "प्रकारः", "LOAD_CONST"); कोष_स्थापय(नि२, "तर्क१", ५०); सूची_योजय(आईआर, नि२);
    चलम् नि३ = कोष_रचय(); कोष_स्थापय(नि३, "प्रकारः", "ADD"); कोष_स्थापय(नि३, "तर्क१", ०); सूची_योजय(आईआर, नि३);
    चलम् नि४ = कोष_रचय(); कोष_स्थापय(नि४, "प्रकारः", "PRINT"); कोष_स्थापय(नि४, "तर्क१", ०); सूची_योजय(आईआर, नि४);

    चलम् इसा_सूची = अनुवादय_आईआर_सूची(अनु, आईआर);
    चलम् दी = सूची_दीर्घता(इसा_सूची);
    लिख "अनुवादित-आईएसए-निर्देशाः = " + सूत्र_परिवर्तय(दी);

    चलम् अ = ०;
    यावत् (अ < दी) {
        चलम् इसा = सूची_प्राप्नु(इसा_सूची, अ);
        लिख "आईएसए " + सूत्र_परिवर्तय(अ) + ": " + कोष_प्राप्नु(इसा, "आदेशः");
        अ = अ + १;
    }

    लिख "आईआर-तः-आईएसए अनुवादक-परीक्षणं सम्पूर्णम्!\n";
}

अनुवादक_परीक्षणम्();
