    // Functional & Higher-Order (योगः, न्यूनतमम्, अधिकतमम्, सर्वम्, किमपि, परिसरः, गणना_सहित, सङ्गमः)
    धावकः = धावकः + "    public static double Yogah(object list) { double sum = 0; if (list is IList) { foreach (var x in (IList)list) { double d = 0; if (double.TryParse(x.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d)) sum += d; } } return sum; }\n";
    धावकः = धावकः + "    public static object Nyunatamam(object list) { if (list is IList) { IList il = (IList)list; if (il.Count > 0) { double min = Convert.ToDouble(il[0]); for (int i = 1; i < il.Count; i++) { double d = Convert.ToDouble(il[i]); if (d < min) min = d; } return min; } } return 0; }\n";
    धावकः = धावकः + "    public static object Adhikatamam(object list) { if (list is IList) { IList il = (IList)list; if (il.Count > 0) { double max = Convert.ToDouble(il[0]); for (int i = 1; i < il.Count; i++) { double d = Convert.ToDouble(il[i]); if (d > max) max = d; } return max; } } return 0; }\n";
    धावकः = धावकः + "    public static bool Sarvam(object list) { if (list is IList) { foreach (var x in (IList)list) if (!ToBool(x)) return false; return true; } return false; }\n";
    धावकः = धावकः + "    public static bool Kimapi(object list) { if (list is IList) { foreach (var x in (IList)list) if (ToBool(x)) return true; return false; } return false; }\n";
    धावकः = धावकः + "    public static List<object> Parisarah(object a, object b, object step) { var res = new List<object>(); int start = Convert.ToInt32(a); int end = Convert.ToInt32(b); int s = Convert.ToInt32(step); if (s == 0) s = 1; if (s > 0) { for (int i = start; i < end; i += s) res.Add((long)i); } else { for (int i = start; i > end; i += s) res.Add((long)i); } return res; }\n";
    धावकः = धावकः + "    public static List<object> GananaSahita(object list) { var res = new List<object>(); if (list is IList) { IList il = (IList)list; for (int i = 0; i < il.Count; i++) { var pair = new List<object>(); pair.Add((long)i); pair.Add(il[i]); res.Add(pair); } } return res; }\n";
    धावकः = धावकः + "    public static List<object> Sangamah(object l1, object l2) { var res = new List<object>(); if (l1 is IList && l2 is IList) { IList i1 = (IList)l1; IList i2 = (IList)l2; int min = Math.Min(i1.Count, i2.Count); for (int i = 0; i < min; i++) { var pair = new List<object>(); pair.Add(i1[i]); pair.Add(i2[i]); res.Add(pair); } } return res; }\n";

