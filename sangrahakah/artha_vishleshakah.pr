// ============================================================================
// प्रज्ञा (Prajna) — अर्थविश्लेषकः (Semantic Analyzer & Scope Table)
// सञ्चिका: prajna/sangrahakah/artha_vishleshakah.pr
// ============================================================================

// परिमण्डल-रचना (Scope / Symbol Table)
फलनम् परिमण्डल_रचय(जनक_परिमण्डलम्) {
    चलम् परि = कोष_रचय();
    कोष_स्थापय(परि, "चलराशयः", कोष_रचय());
    कोष_स्थापय(परि, "स्थिराः", कोष_रचय());
    कोष_स्थापय(परि, "फलनानि", कोष_रचय());
    कोष_स्थापय(परि, "जनकः", जनक_परिमण्डलम्);
    प्रत्यागच्छ परि;
}

// चलराशि-घोषणम्
फलनम् चलराशि_घोषणम्(परिमण्डलम्, नामन्, प्रकार_संकेतः) {
    चलम् कोशः = कोष_प्राप्नु(परिमण्डलम्, "चलराशयः");
    यदि (कोष_अस्ति(कोशः, नामन्)) {
        लिख "[अर्थदोषः] चलराशिः पूर्वमेव घोषितः: " + नामन्;
        प्रत्यागच्छ असत्यम्;
    }
    कोष_स्थापय(कोशः, नामन्, प्रकार_संकेतः);
    प्रत्यागच्छ सत्यम्;
}

// स्थिरराशि-घोषणम्
फलनम् स्थिरराशि_घोषणम्(परिमण्डलम्, नामन्, प्रकार_संकेतः) {
    चलम् कोशः = कोष_प्राप्नु(परिमण्डलम्, "स्थिराः");
    यदि (कोष_अस्ति(कोशः, नामन्)) {
        लिख "[अर्थदोषः] स्थिरराशिः पूर्वमेव घोषितः: " + नामन्;
        प्रत्यागच्छ असत्यम्;
    }
    कोष_स्थापय(कोशः, नामन्, प्रकार_संकेतः);
    प्रत्यागच्छ सत्यम्;
}

// फलन-घोषणम्
फलनम् फलन_घोषणम्(परिमण्डलम्, नामन्, तर्क_संख्या) {
    चलम् कोशः = कोष_प्राप्नु(परिमण्डलम्, "फलनानि");
    कोष_स्थापय(कोशः, नामन्, तर्क_संख्या);
    प्रत्यागच्छ सत्यम्;
}

// चलराशि-अन्वेषणम् (Lookup in current and parent scopes)
फलनम् चलराशि_विद्यते(परिमण्डलम्, नामन्) {
    चलम् वर्तमानम् = परिमण्डलम्;
    चलम् समाप्तम् = असत्यम्;
    यावत् (समाप्तम् == असत्यम्) {
        चलम् च_कोशः = कोष_प्राप्नु(वर्तमानम्, "चलराशयः");
        चलम् स्थ_कोशः = कोष_प्राप्नु(वर्तमानम्, "स्थिराः");

        यदि (कोष_अस्ति(च_कोशः, नामन्) वा कोष_अस्ति(स्थ_कोशः, नामन्)) {
            प्रत्यागच्छ सत्यम्;
        }

        चलम् जनकः = कोष_प्राप्नु(वर्तमानम्, "जनकः");
        यदि (जनकः == ० वा जनकः == "") {
            समाप्तम् = सत्यम्;
        } अन्यथा {
            वर्तमानम् = जनकः;
        }
    }
    प्रत्यागच्छ असत्यम्;
}

// अर्थविश्लेषक-परीक्षणम् (Self-test)
फलनम् अर्थविश्लेषक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: अर्थविश्लेषकः] ---";
    चलम् मुख्य_परि = परिमण्डल_रचय("");
    चलम् यशः१ = चलराशि_घोषणम्(मुख्य_परि, "क", "PURNANKA");
    लिख "चलराशि_घोषणम्('क') = " + सूत्र_परिवर्तय(यशः१);
    चलम् अस्ति_क = चलराशि_विद्यते(मुख्य_परि, "क");
    लिख "चलराशि_विद्यते('क') = " + सूत्र_परिवर्तय(अस्ति_क);
    चलम् अस्ति_ख = चलराशि_विद्यते(मुख्य_परि, "ख");
    लिख "चलराशि_विद्यते('ख') = " + सूत्र_परिवर्तय(अस्ति_ख);
    लिख "अर्थविश्लेषक-परीक्षणं सम्पूर्णम्!\n";
}

अर्थविश्लेषक_परीक्षणम्();
