    धावकः = धावकः + "    public static object VastuPraptnu(object obj, object prop) { if (obj is Dictionary<string, object>) { var d = (Dictionary<string, object>)obj; string p = prop.ToString(); if (d.ContainsKey(p)) return d[p]; } return null; }\n";
