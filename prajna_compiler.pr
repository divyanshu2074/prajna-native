// पद-रूपान्तरणम् (Expression Token to C# Code)
फलनम् पद_रूपान्तरम्(पदम्) {
    यदि (पदम् == "सत्यम्") { प्रत्यागच्छ "true"; }
    यदि (पदम् == "असत्यम्") { प्रत्यागच्छ "false"; }
    यदि (पदम् == "शून्यम्") { प्रत्यागच्छ "null"; }
    यदि (पदम् == "तथा") { प्रत्यागच्छ "&&"; }
    यदि (पदम् == "वा") { प्रत्यागच्छ "||"; }
    यदि (पदम् == "न") { प्रत्यागच्छ "!"; }
    यदि (अन्तर्निर्मितम्_अस्ति(पदम्)) { प्रत्यागच्छ पदम्; }
    यदि (सूत्र_दीर्घता(पदम्) > ० तथा वर्ण_प्राप्नु(पदम्, ०) == "\"") { प्रत्यागच्छ पदम्; }
    यदि (सूत्र_दीर्घता(पदम्) > ० तथा आङ्ग्ल_अङ्कम्(वर्ण_प्राप्नु(पदम्, ०))) { प्रत्यागच्छ पदम्; }
    यदि (विरामचिह्नम्_अस्ति(पदम्)) { प्रत्यागच्छ पदम्; }
    प्रत्यागच्छ "var_" + पदम्;
}

// किं पदम् वाक्यसमाप्तौ योग्यम्?
फलनम् समाप्ति_योग्यम्(पदम्) {
    यदि (पदम् == "" वा पदम् == ";" वा पदम् == "{" वा पदम् == "}" वा पदम् == "(" वा पदम् == "[" वा
         पदम् == "," वा पदम् == "+" वा पदम् == "-" वा पदम् == "*" वा पदम् == "/" वा पदम् == "%" वा
         पदम् == "=" वा पदम् == "==" वा पदम् == "!=" वा पदम् == "<=" वा पदम् == ">=" वा
         पदम् == "<" वा पदम् == ">" वा पदम् == "वा" वा पदम् == "तथा" वा पदम् == "यदि" वा
         पदम् == "यावत्" वा पदम् == "चलम्" वा पदम् == "स्थिरम्" वा पदम् == "फलनम्" वा
         पदम् == "अन्यथा" वा पदम् == "लिख" वा पदम् == "प्रत्यागच्छ") {
        प्रत्यागच्छ असत्यम्;
    }
    प्रत्यागच्छ सत्यम्;
}

// सहायक-पठन-फलनानि
फलनम् सूत्रम्_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "\"";
    चलम् वर्तमान_सूचकः = सूचकः + १;
    चलम् समाप्तम् = असत्यम्;

    यावत् (वर्तमान_सूचकः < दीर्घता तथा समाप्तम् == असत्यम्) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (च == "\\") {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            यदि (वर्तमान_सूचकः < दीर्घता) {
                पाठः = पाठः + वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
                वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            }
        } अन्यथा यदि (च == "\"") {
            पाठः = पाठः + "\"";
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            समाप्तम् = सत्यम्;
        } अन्यथा {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        }
    }

    प्रत्यागच्छ सूची_द्वयम्(पाठः, वर्तमान_सूचकः);
}

फलनम् यावत्_विराम() {
    प्रत्यागच्छ ०;
}

फलनम् अङ्कम्_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "";
    चलम् वर्तमान_सूचकः = सूचकः;
    चलम् दशांशयुक्तम् = असत्यम्;

    यावत् (वर्तमान_सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (देवनागरी_अङ्कम्(च) वा आङ्ग्ल_अङ्कम्(च)) {
            पाठः = पाठः + अङ्क_परिवर्तनम्(च);
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        } अन्यथा यदि (च == "." तथा दशांशयुक्तम् == असत्यम् तथा वर्तमान_सूचकः + १ < दीर्घता तथा (देवनागरी_अङ्कम्(वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः + १)) वा आङ्ग्ल_अङ्कम्(वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः + १)))) {
            पाठः = पाठः + ".";
            दशांशयुक्तम् = सत्यम्;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        } अन्यथा {
            यावत्_विराम();
            चलम् शेषः = दीर्घता - वर्तमान_सूचकः;
            वर्तमान_सूचकः = वर्तमान_सूचकः + शेषः;
        }
    }

    चलम् परिणाम_सूचकः = सूचकः + सूत्र_दीर्घता(पाठः);
    यदि (दशांशयुक्तम्) {
        प्रत्यागच्छ सूची_द्वयम्(पाठः + "D", परिणाम_सूचकः);
    }
    प्रत्यागच्छ सूची_द्वयम्(पाठः + "L", परिणाम_सूचकः);
}

फलनम् नाम_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "";
    चलम् वर्तमान_सूचकः = सूचकः;

    यावत् (वर्तमान_सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (रिक्तस्थानम्_अस्ति(च) वा विरामचिह्नम्_अस्ति(च) वा च == "\"") {
            चलम् शेषः = दीर्घता - वर्तमान_सूचकः;
            वर्तमान_सूचकः = वर्तमान_सूचकः + शेषः;
        } अन्यथा {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        }
    }

    चलम् परिणाम_सूचकः = सूचकः + सूत्र_दीर्घता(पाठः);
    प्रत्यागच्छ सूची_द्वयम्(पाठः, परिणाम_सूचकः);
}

// पदच्छेदकः (Tokenizer)
फलनम् पदच्छेदः(स्रोतः) {
    चलम् चिह्नानि = सूची_रचय();
    चलम् दीर्घता = सूत्र_दीर्घता(स्रोतः);
    चलम् सूचकः = ०;

    यावत् (सूचकः < दीर्घता) {
        चलम् वर्तमानः = वर्ण_प्राप्नु(स्रोतः, सूचकः);

        यदि (वर्तमानः == "\n") {
            चलम् सङ्ख्या = सूची_दीर्घता(चिह्नानि);
            यदि (सङ्ख्या > ०) {
                चलम् अन्तिमम् = सूची_प्राप्नु(चिह्नानि, सङ्ख्या - १);
                यदि (समाप्ति_योग्यम्(अन्तिमम्)) {
                    सूची_योजय(चिह्नानि, ";");
                }
            }
            सूचकः = सूचकः + १;
        } अन्यथा यदि (रिक्तस्थानम्_अस्ति(वर्तमानः)) {
            सूचकः = सूचकः + १;
        } अन्यथा {
            चलम् अग्रिमः = "";
            यदि (सूचकः + १ < दीर्घता) {
                अग्रिमः = वर्ण_प्राप्नु(स्रोतः, सूचकः + १);
            }

            // एकपङ्क्ति-टिप्पणी
            यदि (वर्तमानः == "/" तथा अग्रिमः == "/") {
                सूचकः = सूचकः + २;
                यावत् (सूचकः < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः) != "\n") {
                    सूचकः = सूचकः + १;
                }
            } अन्यथा यदि (वर्तमानः == "/" तथा अग्रिमः == "*") {
                // बहुपङ्क्ति-टिप्पणी
                सूचकः = सूचकः + २;
                यावत् (सूचकः + १ < दीर्घता) {
                    यदि (वर्ण_प्राप्नु(स्रोतः, सूचकः) == "*" तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "/") {
                        सूचकः = सूचकः + २;
                        सूचकः = सूचकः + दीर्घता;
                    } अन्यथा {
                        सूचकः = सूचकः + १;
                    }
                }
            } अन्यथा यदि (वर्तमानः == "\"") {
                चलम् सूत्र_परिणामः = सूत्रम्_पठ(स्रोतः, सूचकः, दीर्घता);
                सूची_योजय(चिह्नानि, सूची_प्राप्नु(सूत्र_परिणामः, ०));
                सूचकः = सूची_प्राप्नु(सूत्र_परिणामः, १);
            } अन्यथा यदि (देवनागरी_अङ्कम्(वर्तमानः) वा आङ्ग्ल_अङ्कम्(वर्तमानः)) {
                चलम् अङ्क_परिणामः = अङ्कम्_पठ(स्रोतः, सूचकः, दीर्घता);
                सूची_योजय(चिह्नानि, सूची_प्राप्नु(अङ्क_परिणामः, ०));
                सूचकः = सूची_प्राप्नु(अङ्क_परिणामः, १);
            } अन्यथा {
                चलम् द्वि_चिह्नम् = "";
                यदि (सूचकः + १ < दीर्घता) {
                    द्वि_चिह्नम् = वर्तमानः + अग्रिमः;
                }

                यदि (द्वि_चिह्नम् == "==" वा द्वि_चिह्नम् == "!=" वा द्वि_चिह्नम् == "<=" वा द्वि_चिह्नम् == ">=") {
                    सूची_योजय(चिह्नानि, द्वि_चिह्नम्);
                    सूचकः = सूचकः + २;
                } अन्यथा यदि (विरामचिह्नम्_अस्ति(वर्तमानः)) {
                    सूची_योजय(चिह्नानि, वर्तमानः);
                    सूचकः = सूचकः + १;
                } अन्यथा {
                    चलम् नाम_परिणामः = नाम_पठ(स्रोतः, सूचकः, दीर्घता);
                    सूची_योजय(चिह्नानि, सूची_प्राप्नु(नाम_परिणामः, ०));
                    सूचकः = सूची_प्राप्नु(नाम_परिणामः, १);
                }
            }
        }
    }

    चलम् अन्तिम_सङ्ख्या = सूची_दीर्घता(चिह्नानि);
    यदि (अन्तिम_सङ्ख्या > ०) {
        चलम् शेष_अन्तिमम् = सूची_प्राप्नु(चिह्नानि, अन्तिम_सङ्ख्या - १);
        यदि (समाप्ति_योग्यम्(शेष_अन्तिमम्)) {
            सूची_योजय(चिह्नानि, ";");
        }
    }

    प्रत्यागच्छ चिह्नानि;
}

