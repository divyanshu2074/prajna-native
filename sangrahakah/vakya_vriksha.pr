    कोष_स्थापय(नो, "प्रारम्भ_मूल्यम्", प्रारम्भ_मूल्य);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_स्थिरघोषणा(नामन्, प्रारम्भ_मूल्य, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("STHIRA_GHOSHANA", पं, स्त);
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "प्रारम्भ_मूल्यम्", प्रारम्भ_मूल्य);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_नियोजन(नामन्, मूल्य, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("NIYOJANA", पं, स्त);
    कोष_स्थापय(नो, "नामन्", नामन्);
    कोष_स्थापय(नो, "मूल्यम्", मूल्य);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_लिख(अभिव्यक्ति, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("LIKHA", पं, स्त);
    कोष_स्थापय(नो, "अभिव्यक्तिः", अभिव्यक्ति);
