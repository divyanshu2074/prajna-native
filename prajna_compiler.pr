// C# सम्पूर्ण-सङ्केतस्य निर्माणम्
फलनम् सज्जीकुरु_सङ्केतम्(फलनानि, मुख्य_भागः) {
    चलम् आधारः = "// प्रज्ञा (Prajna) स्वयम्भू-सङ्कलकेन निर्मितम्\n";
    आधारः = आधारः + "using System;\nusing System.IO;\nusing System.Text;\nusing System.Drawing;\nusing System.Collections;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.Windows.Forms;\n\n";

    // PrajnaRuntime
    चलम् धावकः = "public static class PrajnaRuntime {\n";
    धावकः = धावकः + "    public static bool DevanagariOutput = true;\n";
    धावकः = धावकः + "    public static string[] CommandLineArgs = new string[0];\n";
    धावकः = धावकः + "    public static string IntToDevanagari(long n) {\n";
    धावकः = धावकः + "        bool neg = n < 0; if (neg) n = -n;\n";
    धावकः = धावकः + "        string s = n.ToString(); StringBuilder sb = new StringBuilder();\n";
    धावकः = धावकः + "        if (neg) sb.Append('-');\n";
    धावकः = धावकः + "        foreach (char ch in s) { if (ch >= '0' && ch <= '9') sb.Append((char)('०' + (ch - '0'))); else sb.Append(ch); }\n";
    धावकः = धावकः + "        return sb.ToString();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static long DevanagariToInt(string s) {\n";
    धावकः = धावकः + "        if (string.IsNullOrEmpty(s)) return 0;\n";
    धावकः = धावकः + "        StringBuilder sb = new StringBuilder();\n";
    धावकः = धावकः + "        foreach (char ch in s.Trim()) {\n";
    धावकः = धावकः + "            if (ch >= '०' && ch <= '९') sb.Append((char)('0' + (ch - '०')));\n";
    धावकः = धावकः + "            else if (ch >= '0' && ch <= '9' || ch == '-' || ch == '+') sb.Append(ch);\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        long res = 0; long.TryParse(sb.ToString(), out res); return res;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string Format(object val) {\n";
    धावकः = धावकः + "        if (val == null) return \"\";\n";
    धावकः = धावकः + "        if (val is bool) return ((bool)val) ? \"सत्यम्\" : \"असत्यम्\";\n";
    धावकः = धावकः + "        if (val is long || val is int) { long v = Convert.ToInt64(val); return DevanagariOutput ? IntToDevanagari(v) : v.ToString(); }\n";
    धावकः = धावकः + "        if (val is double || val is float) return val.ToString();\n";
    धावकः = धावकः + "        if (val is IList) {\n";
    धावकः = धावकः + "            IList list = (IList)val; StringBuilder sb = new StringBuilder(); sb.Append(\"[\");\n";
    धावकः = धावकः + "            for (int i = 0; i < list.Count; i++) { sb.Append(Format(list[i])); if (i < list.Count - 1) sb.Append(\", \" ); }\n";
    धावकः = धावकः + "            sb.Append(\"]\"); return sb.ToString();\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        return val.ToString();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static void Likha(object val) { Console.WriteLine(Format(val)); }\n";
    धावकः = धावकः + "    public static bool ToBool(object a) {\n";
    धावकः = धावकः + "        if (a is bool) return (bool)a;\n";
    धावकः = धावकः + "        if (a is long) return Convert.ToInt64(a) != 0;\n";
    धावकः = धावकः + "        if (a is int) return Convert.ToInt32(a) != 0;\n";
    धावकः = धावकः + "        if (a is string) return !string.IsNullOrEmpty((string)a);\n";
    धावकः = धावकः + "        return a != null;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static List<object> MakeList(params object[] items) { return new List<object>(items); }\n";
    धावकः = धावकः + "    public static long SutraDirghata(object s) { return s == null ? 0 : s.ToString().Length; }\n";
    धावकः = धावकः + "    public static string SutraKhandam(object s, object st, object l) {\n";
