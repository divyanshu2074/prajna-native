// ============================================================================
// प्रज्ञा (Prajna) — अन्तःस्थप्रतिनिधि-निर्देशाः (Intermediate Representation)
// सञ्चिका: prajna/madhyapratinidhih/pratinidhi_nirdesha.pr
// ============================================================================

// आईआर-निर्देश-निर्माणम् (IR Instruction Builder)
फलनम् आईआर_निर्देश_रचय(प्रकार_संकेतः, तर्क१, तर्क२, पङ्क्ति_सङ्ख्या, स्तम्भ_सङ्ख्या) {
    चलम् निर्देशः = कोष_रचय();
    कोष_स्थापय(निर्देशः, "प्रकारः", प्रकार_संकेतः);
    कोष_स्थापय(निर्देशः, "तर्क१", तर्क१);
    कोष_स्थापय(निर्देशः, "तर्क२", तर्क२);
    कोष_स्थापय(निर्देशः, "पङ्क्तिः", पङ्क्ति_सङ्ख्या);
    कोष_स्थापय(निर्देशः, "स्तम्भः", स्तम्भ_सङ्ख्या);
    प्रत्यागच्छ निर्देशः;
}

// निर्देश-प्रकाराः (Opcode Helpers)
फलनम् आईआर_भारय_स्थिरम्(मूल्यम्, पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("LOAD_CONST", मूल्यम्, ०, पं, स्त);
}

फलनम् आईआर_भारय_चलम्(नामन्, पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("LOAD_VAR", नामन्, ०, पं, स्त);
}

फलनम् आईआर_रक्ष_चलम्(नामन्, पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("STORE_VAR", नामन्, ०, पं, स्त);
}

फलनम् आईआर_योग(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("ADD", ०, ०, पं, स्त);
}

फलनम् आईआर_व्यवकलन(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("SUB", ०, ०, पं, स्त);
}

फलनम् आईआर_गुणन(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("MUL", ०, ०, पं, स्त);
}

फलनम् आईआर_भाग(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("DIV", ०, ०, पं, स्त);
}

फलनम् आईआर_शेषफल(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("MOD", ०, ०, पं, स्त);
}

फलनम् आईआर_चिह्नक(नामन्) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("LABEL", नामन्, ०, ०, ०);
}

फलनम् आईआर_गच्छ(नामन्) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("JUMP", नामन्, ०, ०, ०);
}

फलनम् आईआर_यदि_असत्यम्(नामन्) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("JUMP_IF_FALSE", नामन्, ०, ०, ०);
}

फलनम् आईआर_लिख(पं, स्त) {
    प्रत्यागच्छ आईआर_निर्देश_रचय("PRINT", ०, ०, पं, स्त);
}

फलनम् आईआर_विराम() {
    प्रत्यागच्छ आईआर_निर्देश_रचय("HALT", ०, ०, ०, ०);
}

// आईआर-विवरणम् (IR string representation)
फलनम् आईआर_विवरणम्(निर्देशः) {
    चलम् प्र = सूत्र_परिवर्तय(कोष_प्राप्नु(निर्देशः, "प्रकारः"));
    चलम् त१ = सूत्र_परिवर्तय(कोष_प्राप्नु(निर्देशः, "तर्क१"));
    चलम् त२ = सूत्र_परिवर्तय(कोष_प्राप्नु(निर्देशः, "तर्क२"));

    यदि (त१ != "०" तथा त१ != "") {
        यदि (त२ != "०" तथा त२ != "") {
            प्रत्यागच्छ "आईआर(" + प्र + ", " + त१ + ", " + त२ + ")";
        }
        प्रत्यागच्छ "आईआर(" + प्र + ", " + त१ + ")";
    }
    प्रत्यागच्छ "आईआर(" + प्र + ")";
}

// आईआर-परीक्षणम् (Self-test)
फलनम् आईआर_परीक्षणम्() {
    लिख "--- [परीक्षणम्: अन्तःस्थप्रतिनिधिः (IR)] ---";
    चलम् नि१ = आईआर_भारय_स्थिरम्(१०, १, १);
    लिख आईआर_विवरणम्(नि१);
    चलम् नि२ = आईआर_रक्ष_चलम्("क", १, १);
    लिख आईआर_विवरणम्(नि२);
    चलम् नि३ = आईआर_योग(१, १);
    लिख आईआर_विवरणम्(नि३);
    लिख "अन्तःस्थप्रतिनिधि-परीक्षणं सम्पूर्णम्!\n";
}

आईआर_परीक्षणम्();
