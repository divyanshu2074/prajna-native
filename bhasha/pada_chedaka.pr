// ============================================================================
// प्रज्ञा (Prajna) — पदच्छेदकः (Lexer / Tokenizer)
// सञ्चिका: prajna/bhasha/pada_chedaka.pr
// ============================================================================

फलनम् देवनागरी_अङ्कम्(वर्णः) {
    यदि (वर्णः == "०" वा वर्णः == "१" वा वर्णः == "२" वा वर्णः == "३" वा वर्णः == "४" वा
         वर्णः == "५" वा वर्णः == "६" वा वर्णः == "७" वा वर्णः == "८" वा वर्णः == "९") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् आङ्ग्ल_अङ्कम्(वर्णः) {
    यदि (वर्णः == "0" वा वर्णः == "1" वा वर्णः == "2" वा वर्णः == "3" वा वर्णः == "4" वा
         वर्णः == "5" वा वर्णः == "6" वा वर्णः == "7" वा वर्णः == "8" वा वर्णः == "9") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् अङ्क_परिवर्तनम्(वर्णः) {
    यदि (वर्णः == "०") { प्रत्यागच्छ "0"; }
    यदि (वर्णः == "१") { प्रत्यागच्छ "1"; }
    यदि (वर्णः == "२") { प्रत्यागच्छ "2"; }
    यदि (वर्णः == "३") { प्रत्यागच्छ "3"; }
    यदि (वर्णः == "४") { प्रत्यागच्छ "4"; }
    यदि (वर्णः == "५") { प्रत्यागच्छ "5"; }
    यदि (वर्णः == "६") { प्रत्यागच्छ "6"; }
    यदि (वर्णः == "७") { प्रत्यागच्छ "7"; }
    यदि (वर्णः == "८") { प्रत्यागच्छ "8"; }
    यदि (वर्णः == "९") { प्रत्यागच्छ "9"; }
    प्रत्यागच्छ वर्णः;
}

फलनम् रिक्तस्थानम्_अस्ति(वर्णः) {
    यदि (वर्णः == " " वा वर्णः == "\t" वा वर्णः == "\r") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् विरामचिह्नम्_अस्ति(वर्णः) {
    यदि (वर्णः == "(" वा वर्णः == ")" वा वर्णः == "{" वा वर्णः == "}" वा
         वर्णः == "[" वा वर्णः == "]" वा वर्णः == ";" वा वर्णः == "," वा
         वर्णः == "+" वा वर्णः == "-" वा वर्णः == "*" वा वर्णः == "/" वा
         वर्णः == "%" वा वर्णः == "=" वा वर्णः == "<" वा वर्णः == ">" वा
         वर्णः == "!" वा वर्णः == "&" वा वर्णः == "|") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

// मुख्य पदच्छेद-फलनम्
फलनम् पदच्छेदः(स्रोतः) {
    चलम् चिह्नानि = सूची_रचय();
    चलम् दीर्घता = सूत्र_दीर्घता(स्रोतः);
    चलम् सूचकः = ०;
    चलम् पङ्क्तिः = १;
    चलम् स्तम्भः = १;

    यावत् (सूचकः < दीर्घता) {
        चलम् वर्तमानः = वर्ण_प्राप्नु(स्रोतः, सूचकः);

        // टिप्पणी: //
        यदि (वर्तमानः == "/" तथा सूचकः + १ < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "/") {
            यावत् (सूचकः < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः) != "\n") {
                सूचकः = सूचकः + १;
            }
        }
        // टिप्पणी: /* ... */
        अन्यथा यदि (वर्तमानः == "/" तथा सूचकः + १ < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "*") {
            सूचकः = सूचकः + २;
            स्तम्भः = स्तम्भः + २;
            चलम् समाप्तम् = असत्यम्;
            यावत् (सूचकः + १ < दीर्घता तथा समाप्तम् == असत्यम्) {
                यदि (वर्ण_प्राप्नु(स्रोतः, सूचकः) == "*" तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "/") {
                    सूचकः = सूचकः + २;
                    स्तम्भः = स्तम्भः + २;
                    समाप्तम् = सत्यम्;
                } अन्यथा {
                    यदि (वर्ण_प्राप्नु(स्रोतः, सूचकः) == "\n") {
                        पङ्क्तिः = पङ्क्तिः + १;
                        स्तम्भः = १;
                    } अन्यथा {
                        स्तम्भः = स्तम्भः + १;
                    }
                    सूचकः = सूचकः + १;
                }
            }
        }
        // रिक्तस्थानम्
        अन्यथा यदि (रिक्तस्थानम्_अस्ति(वर्तमानः)) {
            सूचकः = सूचकः + १;
            स्तम्भः = स्तम्भः + १;
        }
        // पङ्क्तिविरामः
        अन्यथा यदि (वर्तमानः == "\n") {
            सूचकः = सूचकः + १;
            पङ्क्तिः = पङ्क्तिः + १;
            स्तम्भः = १;
        }
        // सूत्रम्: "..."
        अन्यथा यदि (वर्तमानः == "\"") {
            चलम् पाठः = "\"";
            सूचकः = सूचकः + १;
            स्तम्भः = स्तम्भः + १;
            चलम् समाप्तम् = असत्यम्;
            यावत् (सूचकः < दीर्घता तथा समाप्तम् == असत्यम्) {
                चलम् च = वर्ण_प्राप्नु(स्रोतः, सूचकः);
                यदि (च == "\\") {
                    पाठः = पाठः + च;
                    सूचकः = सूचकः + १;
                    स्तम्भः = स्तम्भः + १;
                    यदि (सूचकः < दीर्घता) {
                        पाठः = पाठः + वर्ण_प्राप्नु(स्रोतः, सूचकः);
                        सूचकः = सूचकः + १;
                        स्तम्भः = स्तम्भः + १;
                    }
                } अन्यथा यदि (च == "\"") {
                    पाठः = पाठः + "\"";
                    सूचकः = सूचकः + १;
                    स्तम्भः = स्तम्भः + १;
                    समाप्तम् = सत्यम्;
                } अन्यथा {
                    पाठः = पाठः + च;
                    सूचकः = सूचकः + १;
                    स्तम्भः = स्तम्भः + १;
                }
            }
            चलम् टोकन = कोष_रचय();
            कोष_स्थापय(टोकन, "भेदः", "SUTRAM");
            कोष_स्थापय(टोकन, "मूल्यम्", पाठः);
            कोष_स्थापय(टोकन, "पङ्क्तिः", पङ्क्तिः);
            कोष_स्थापय(टोकन, "स्तम्भः", स्तम्भः);
            सूची_योजय(चिह्नानि, टोकन);
        }
        // संख्या (Devanagari or Arabic digits)
        अन्यथा यदि (देवनागरी_अङ्कम्(वर्तमानः) वा आङ्ग्ल_अङ्कम्(वर्तमानः)) {
            चलम् संख्या_पाठः = "";
            चलम् विरामः = असत्यम्;
            यावत् (सूचकः < दीर्घता तथा विरामः == असत्यम्) {
                चलम् च = वर्ण_प्राप्नु(स्रोतः, सूचकः);
                यदि (देवनागरी_अङ्कम्(च) वा आङ्ग्ल_अङ्कम्(च)) {
                    संख्या_पाठः = संख्या_पाठः + अङ्क_परिवर्तनम्(च);
                    सूचकः = सूचकः + १;
                    स्तम्भः = स्तम्भः + १;
                } अन्यथा {
                    विरामः = सत्यम्;
                }
            }
            चलम् टोकन = कोष_रचय();
            कोष_स्थापय(टोकन, "भेदः", "PURNANKA");
            कोष_स्थापय(टोकन, "मूल्यम्", संख्या_पाठः);
            कोष_स्थापय(टोकन, "पङ्क्तिः", पङ्क्तिः);
            कोष_स्थापय(टोकन, "स्तम्भः", स्तम्भः);
            सूची_योजय(चिह्नानि, टोकन);
        }
        // द्वि-वर्ण-क्रियाचिह्नानि: ==, !=, <=, >=
        अन्यथा यदि ((वर्तमानः == "=" वा वर्तमानः == "!" वा वर्तमानः == "<" वा वर्तमानः == ">") तथा
                    सूचकः + १ < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "=") {
            चलम् ओप् = वर्तमानः + "=";
            सूचकः = सूचकः + २;
            स्तम्भः = स्तम्भः + २;
            चलम् टोकन = कोष_रचय();
            कोष_स्थापय(टोकन, "भेदः", "OPERATOR");
            कोष_स्थापय(टोकन, "मूल्यम्", ओप्);
            कोष_स्थापय(टोकन, "पङ्क्तिः", पङ्क्तिः);
            कोष_स्थापय(टोकन, "स्तम्भः", स्तम्भः);
            सूची_योजय(चिह्नानि, टोकन);
        }
        // एक-वर्ण-विरामचिह्नानि
        अन्यथा यदि (विरामचिह्नम्_अस्ति(वर्तमानः)) {
            चलम् टोकन = कोष_रचय();
            कोष_स्थापय(टोकन, "भेदः", "PUNCTUATION");
            कोष_स्थापय(टोकन, "मूल्यम्", वर्तमानः);
            कोष_स्थापय(टोकन, "पङ्क्तिः", पङ्क्तिः);
            कोष_स्थापय(टोकन, "स्तम्भः", स्तम्भः);
            सूची_योजय(चिह्नानि, टोकन);
            सूचकः = सूचकः + १;
            स्तम्भः = स्तम्भः + १;
        }
        // नामन् / मुख्यशब्दः
        अन्यथा {
            चलम् नाम_पाठः = "";
            चलम् विरामः = असत्यम्;
            यावत् (सूचकः < दीर्घता तथा विरामः == असत्यम्) {
                चलम् च = वर्ण_प्राप्नु(स्रोतः, सूचकः);
                यदि (रिक्तस्थानम्_अस्ति(च) वा विरामचिह्नम्_अस्ति(च) वा च == "\"" वा च == "\n") {
                    विरामः = सत्यम्;
                } अन्यथा {
                    नाम_पाठः = नाम_पाठः + च;
                    सूचकः = सूचकः + १;
                    स्तम्भः = स्तम्भः + १;
                }
            }
            यदि (सूत्र_दीर्घता(नाम_पाठः) > ०) {
                चलम् टोकन = कोष_रचय();
                यदि (नाम_पाठः == "चलम्" वा नाम_पाठः == "स्थिरम्" वा नाम_पाठः == "यदि" वा नाम_पाठः == "अन्यथा" वा
                     नाम_पाठः == "यावत्" वा नाम_पाठः == "फलनम्" वा नाम_पाठः == "प्रत्यागच्छ" वा नाम_पाठः == "लिख" वा
                     नाम_पाठः == "सत्यम्" वा नाम_पाठः == "असत्यम्" वा नाम_पाठः == "तथा" वा नाम_पाठः == "वा" वा नाम_पाठः == "न") {
                    कोष_स्थापय(टोकन, "भेदः", "KEYWORD");
                } अन्यथा {
                    कोष_स्थापय(टोकन, "भेदः", "NAMAN");
                }
                कोष_स्थापय(टोकन, "मूल्यम्", नाम_पाठः);
                कोष_स्थापय(टोकन, "पङ्क्तिः", पङ्क्तिः);
                कोष_स्थापय(टोकन, "स्तम्भः", स्तम्भः);
                सूची_योजय(चिह्नानि, टोकन);
            }
        }
    }

    प्रत्यागच्छ चिह्नानि;
}

// पदच्छेदक-परीक्षणम् (Self-test)
फलनम् पदच्छेदक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: पदच्छेदकः] ---";
    चलम् स्रोतः = "चलम् क = १० + २०;\nलिख क;";
    चलम् फलम् = पदच्छेदः(स्रोतः);
    चलम् सङ्ख्या = सूची_दीर्घता(फलम्);
    लिख "चिह्नानां सङ्ख्या = " + सूत्र_परिवर्तय(सङ्ख्या);

    चलम् अनुक्रमः = ०;
    यावत् (अनुक्रमः < सङ्ख्या) {
        चलम् टो = सूची_प्राप्नु(फलम्, अनुक्रमः);
        लिख "चिह्न " + सूत्र_परिवर्तय(अनुक्रमः) + ": [" + कोष_प्राप्नु(टो, "भेदः") + "] '" + कोष_प्राप्नु(टो, "मूल्यम्") + "'";
        अनुक्रमः = अनुक्रमः + १;
    }
    लिख "पदच्छेदक-परीक्षणं सम्पूर्णम्!\n";
}

पदच्छेदक_परीक्षणम्();
