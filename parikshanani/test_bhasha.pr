// ============================================================================
// प्रज्ञा (Prajna) — भाषा-परीक्षणम् (Language & Lexer Test Suite)
// सञ्चिका: prajna/parikshanani/test_bhasha.pr
// ============================================================================

फलनम् सत्यम्_सत्यापय(प्रतिज्ञा, सन्देशः) {
    यदि (प्रतिज्ञा) {
        लिख "[सफलम्] " + सन्देशः;
        प्रत्यागच्छ सत्यम्;
    }
    लिख "[दोषः] " + सन्देशः;
    प्रत्यागच्छ असत्यम्;
}

फलनम् सङ्ख्या_सत्यापय(प्राप्तम्, अपेक्षितम्, सन्देशः) {
    यदि (प्राप्तम् == अपेक्षितम्) {
        लिख "[सफलम्] " + सन्देशः + " (" + सूत्र_परिवर्तय(प्राप्तम्) + ")";
        प्रत्यागच्छ सत्यम्;
    }
    लिख "[दोषः] " + सन्देशः + " (प्राप्तम्: " + सूत्र_परिवर्तय(प्राप्तम्) + ", अपेक्षितम्: " + सूत्र_परिवर्तय(अपेक्षितम्) + ")";
    प्रत्यागच्छ असत्यम्;
}

फलनम् भाषा_परीक्षण_सञ्चालनम्() {
    लिख "==================================================";
    लिख "प्रज्ञा भाषा-परीक्षणमाला (Prajna Language Test Suite)";
    लिख "==================================================";

    // १. देवनागरी-अङ्क-सत्यापनम्
    चलम् अङ्क_० = (वर्ण_प्राप्नु("०", ०) == "०");
    सत्यम्_सत्यापय(अङ्क_०, "देवनागरी-शून्य-सत्यापनम्");

    // २. सूत्र-दीर्घता-सत्यापनम् ("प्रज्ञा" = ७ कोड-युनिट्)
    चलम् सूत्रम् = "प्रज्ञा";
    सङ्ख्या_सत्यापय(सूत्र_दीर्घता(सूत्रम्), ७, "सूत्रदीर्घता-सत्यापनम्");

    // ३. संख्या-परिवर्तनम्
    चलम् सं = संख्या_परिवर्तय("१२३४");
    सङ्ख्या_सत्यापय(सं, १२३४, "देवनागरीतः पूर्णाङ्कपरिवर्तनम्");

    // ४. सूत्र-सम्बन्धः
    चलम् सम् = "नमस्ते " + "विश्व!";
    सत्यम्_सत्यापय(सम् == "नमस्ते विश्व!", "सूत्रसंयोजन-सत्यापनम्");

    लिख "\nसर्वे भाषा-परीक्षणाः सफलाः जाताः!\n";
}

भाषा_परीक्षण_सञ्चालनम्();
