// ============================================================================
// प्रज्ञा (Prajna) — त्रुटिनिरूपणम् तथा सन्देशाः (Error Diagnostics)
// सञ्चिका: prajna/bhasha/truti.pr
// ============================================================================

फलनम् प्रज्ञा_त्रुटि_रचय(वर्गः, सन्देशः, पङ्क्तिः, स्तम्भः) {
    चलम् त्रुटिः = कोष_रचय();
    कोष_स्थापय(त्रुटिः, "वर्गः", वर्गः);
    कोष_स्थापय(त्रुटिः, "सन्देशः", सन्देशः);
    कोष_स्थापय(त्रुटिः, "पङ्क्तिः", पङ्क्तिः);
    कोष_स्थापय(त्रुटिः, "स्तम्भः", स्तम्भः);
    प्रत्यागच्छ त्रुटिः;
}

फलनम् त्रुटि_सन्देशः_रूप(त्रुटिः) {
    चलम् वर्गः = सूत्र_परिवर्तय(कोष_प्राप्नु(त्रुटिः, "वर्गः"));
    चलम् सन्देशः = सूत्र_परिवर्तय(कोष_प्राप्नु(त्रुटिः, "सन्देशः"));
    चलम् पङ्क्तिः = सूत्र_परिवर्तय(कोष_प्राप्नु(त्रुटिः, "पङ्क्तिः"));
    चलम् स्तम्भः = सूत्र_परिवर्तय(कोष_प्राप्नु(त्रुटिः, "स्तम्भः"));

    चलम् स्थानम् = "पङ्क्तिः " + पङ्क्तिः + ", स्तम्भः " + स्तम्भः;
    प्रत्यागच्छ "[" + वर्गः + "] " + स्थानम् + ": " + सन्देशः;
}

फलनम् पदच्छेद_त्रुटि(सन्देशः, पङ्क्तिः, स्तम्भः) {
    प्रत्यागच्छ प्रज्ञा_त्रुटि_रचय("पदच्छेदत्रुटिः", सन्देशः, पङ्क्तिः, स्तम्भः);
}

फलनम् व्याकरण_त्रुटि(सन्देशः, पङ्क्तिः, स्तम्भः) {
    प्रत्यागच्छ प्रज्ञा_त्रुटि_रचय("व्याकरणत्रुटिः", सन्देशः, पङ्क्तिः, स्तम्भः);
}

फलनम् अर्थ_त्रुटि(सन्देशः, पङ्क्तिः, स्तम्भः) {
    प्रत्यागच्छ प्रज्ञा_त्रुटि_रचय("अर्थत्रुटिः", सन्देशः, पङ्क्तिः, स्तम्भः);
}

फलनम् प्रकार_त्रुटि(सन्देशः, पङ्क्तिः, स्तम्भः) {
    प्रत्यागच्छ प्रज्ञा_त्रुटि_रचय("प्रकारत्रुटिः", सन्देशः, पङ्क्तिः, स्तम्भः);
}

फलनम् निर्वाह_त्रुटि(सन्देशः, पङ्क्तिः, स्तम्भः) {
    प्रत्यागच्छ प्रज्ञा_त्रुटि_रचय("निर्वाहत्रुटिः", सन्देशः, पङ्क्तिः, स्तम्भः);
}

// त्रुटिव्यवस्था-परीक्षणम् (Self-test)
फलनम् त्रुटि_परीक्षणम्() {
    लिख "--- [परीक्षणम्: त्रुटिव्यवस्था] ---";
    चलम् त्र१ = पदच्छेद_त्रुटि("अवैधः वर्णः", १, १२);
    लिख त्रुटि_सन्देशः_रूप(त्र१);
    चलम् त्र२ = व्याकरण_त्रुटि("अर्धविरामः अपेक्षितः", ५, १०);
    लिख त्रुटि_सन्देशः_रूप(त्र२);
    लिख "त्रुटिव्यवस्था-परीक्षणं सम्पूर्णम्!\n";
}

त्रुटि_परीक्षणम्();
