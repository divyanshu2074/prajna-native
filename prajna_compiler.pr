    धावकः = धावकः + "    public static double GanitaJyaa(object x) { return Math.Sin(Convert.ToDouble(x)); }\n";
    धावकः = धावकः + "    public static double GanitaKojyaa(object x) { return Math.Cos(Convert.ToDouble(x)); }\n";
