// ============================================================================
// प्रज्ञा (Prajna) — आईआर-निर्माणकर्त्री (Intermediate Representation Builder)
// सञ्चिका: prajna/madhyapratinidhih/nirmanakartri.pr
// ============================================================================

फलनम् आईआर_सृजन_रचय() {
    चलम् सृ = कोष_रचय();
    कोष_स्थापय(सृ, "निर्देशाः", सूची_रचय());
    कोष_स्थापय(सृ, "चिह्नक_सङ्ख्या", ०);
    प्रत्यागच्छ सृ;
}

फलनम् सृजन_योजय(सृ, निर्देशः) {
    चलम् सू = कोष_प्राप्नु(सृ, "निर्देशाः");
    सूची_योजय(सू, निर्देशः);
}

फलनम् नूतन_चिह्नकम्(सृ, उपसर्गः) {
    चलम् सं = कोष_प्राप्नु(सृ, "चिह्नक_सङ्ख्या");
    कोष_स्थापय(सृ, "चिह्नक_सङ्ख्या", सं + १);
    प्रत्यागच्छ उपसर्गः + "_" + सूत्र_परिवर्तय(सं);
}

// आईआर-निर्देश-सहायकम्
फलनम् आईआर_एकम्(आईआर_प्रकार, तर्क१) {
    चलम् नि = कोष_रचय();
    कोष_स्थापय(नि, "प्रकारः", आईआर_प्रकार);
    कोष_स्थापय(नि, "तर्क१", तर्क१);
    प्रत्यागच्छ नि;
}

// अमूर्त-अभिव्यक्तेः आईआर-उत्पादनम्
फलनम् आईआर_उत्पादय_अभिव्यक्ति(सृ, नोड्) {
    चलम् प्र = कोष_प्राप्नु(नोड्, "प्रकारः");

    यदि (प्र == "PURNANKA") {
        सृजन_योजय(सृ, आईआर_एकम्("LOAD_CONST", कोष_प्राप्नु(नोड्, "मूल्यम्")));
        प्रत्यागच्छ ०;
    }
    यदि (प्र == "SUTRAM") {
        सृजन_योजय(सृ, आईआर_एकम्("LOAD_CONST", कोष_प्राप्नु(नोड्, "मूल्यम्")));
        प्रत्यागच्छ ०;
    }
    यदि (प्र == "NAMAPADA") {
        सृजन_योजय(सृ, आईआर_एकम्("LOAD_VAR", कोष_प्राप्नु(नोड्, "नामन्")));
        प्रत्यागच्छ ०;
    }
    यदि (प्र == "DVIVIDHA") {
        आईआर_उत्पादय_अभिव्यक्ति(सृ, कोष_प्राप्नु(नोड्, "वाम"));
        आईआर_उत्पादय_अभिव्यक्ति(सृ, कोष_प्राप्नु(नोड्, "दक्षिण"));
        चलम् क्रिया = कोष_प्राप्नु(नोड्, "क्रिया");
        यदि (क्रिया == "+") { सृजन_योजय(सृ, आईआर_एकम्("ADD", ०)); }
        यदि (क्रिया == "-") { सृजन_योजय(सृ, आईआर_एकम्("SUB", ०)); }
        यदि (क्रिया == "*") { सृजन_योजय(सृ, आईआर_एकम्("MUL", ०)); }
        यदि (क्रिया == "/") { सृजन_योजय(सृ, आईआर_एकम्("DIV", ०)); }
        यदि (क्रिया == "%") { सृजन_योजय(सृ, आईआर_एकम्("MOD", ०)); }
        प्रत्यागच्छ ०;
    }
    प्रत्यागच्छ ०;
}

// अमूर्त-वाक्यस्य आईआर-उत्पादनम्
फलनम् आईआर_उत्पादय_वाक्यम्(सृ, नोड्) {
    चलम् प्र = कोष_प्राप्नु(नोड्, "प्रकारः");

    यदि (प्र == "CHALA_GHOSHANA") {
        आईआर_उत्पादय_अभिव्यक्ति(सृ, कोष_प्राप्नु(नोड्, "मूल्यम्"));
        सृजन_योजय(सृ, आईआर_एकम्("STORE_VAR", कोष_प्राप्नु(नोड्, "नामन्")));
        प्रत्यागच्छ ०;
    }
    यदि (प्र == "LIKHA") {
        आईआर_उत्पादय_अभिव्यक्ति(सृ, कोष_प्राप्नु(नोड्, "अभिव्यक्तिः"));
        सृजन_योजय(सृ, आईआर_एकम्("PRINT", ०));
        प्रत्यागच्छ ०;
    }
    प्रत्यागच्छ ०;
}

// निर्माणकर्त्री-परीक्षणम् (Self-test)
फलनम् निर्माणकर्त्री_परीक्षणम्() {
    लिख "--- [परीक्षणम्: आईआर-निर्माणकर्त्री] ---";
    चलम् सृ = आईआर_सृजन_रचय();

    // चलम् क = १० + २०;
    चलम् नोड्_१० = कोष_रचय(); कोष_स्थापय(नोड्_१०, "प्रकारः", "PURNANKA"); कोष_स्थापय(नोड्_१०, "मूल्यम्", "१०");
    चलम् नोड्_२० = कोष_रचय(); कोष_स्थापय(नोड्_२०, "प्रकारः", "PURNANKA"); कोष_स्थापय(नोड्_२०, "मूल्यम्", "२०");
    चलम् नोड्_योग = कोष_रचय(); कोष_स्थापय(नोड्_योग, "प्रकारः", "DVIVIDHA"); कोष_स्थापय(नोड्_योग, "वाम", नोड्_१०); कोष_स्थापय(नोड्_योग, "क्रिया", "+"); कोष_स्थापय(नोड्_योग, "दक्षिण", नोड्_२०);
    चलम् नोड्_घोषणा = कोष_रचय(); कोष_स्थापय(नोड्_घोषणा, "प्रकारः", "CHALA_GHOSHANA"); कोष_स्थापय(नोड्_घोषणा, "नामन्", "क"); कोष_स्थापय(नोड्_घोषणा, "मूल्यम्", नोड्_योग);

    आईआर_उत्पादय_वाक्यम्(सृ, नोड्_घोषणा);

    // लिख क;
    चलम् नोड्_क = कोष_रचय(); कोष_स्थापय(नोड्_क, "प्रकारः", "NAMAPADA"); कोष_स्थापय(नोड्_क, "नामन्", "क");
    चलम् नोड्_लिख = कोष_रचय(); कोष_स्थापय(नोड्_लिख, "प्रकारः", "LIKHA"); कोष_स्थापय(नोड्_लिख, "अभिव्यक्तिः", नोड्_क);
    आईआर_उत्पादय_वाक्यम्(सृ, नोड्_लिख);

    चलम् सूची = कोष_प्राप्नु(सृ, "निर्देशाः");
    चलम् दी = सूची_दीर्घता(सूची);
    लिख "उत्पादित-आईआर-निर्देशाः = " + सूत्र_परिवर्तय(दी);

    चलम् अ = ०;
    यावत् (अ < दी) {
        चलम् नि = सूची_प्राप्नु(सूची, अ);
        लिख "निर्देश " + सूत्र_परिवर्तय(अ) + ": " + कोष_प्राप्नु(नि, "प्रकारः") + " " + सूत्र_परिवर्तय(कोष_प्राप्नु(नि, "तर्क१"));
        अ = अ + १;
    }
    लिख "आईआर-निर्माणकर्त्री-परीक्षणं सम्पूर्णम्!\n";
}

निर्माणकर्त्री_परीक्षणम्();
