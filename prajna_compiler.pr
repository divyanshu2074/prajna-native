// ============================================================================
// प्रज्ञा (Prajna) — स्वयम्भू-सङ्कलकः (Self-Hosted Prajna Compiler)
// अयम् सङ्कलकः सम्पूर्णतया प्रज्ञा-भाषायां लिखितः अस्ति।
// अनेन प्रज्ञा-सङ्गणकप्रणाली Python-तन्त्रात् सम्पूर्णा मुक्ता भूत्वा
// स्वयमेव प्रज्ञा-स्रोतःसङ्केतान् सङ्कलयति निष्पादयति च।
// ============================================================================

फलनम् देवनागरी_अङ्कम्(वर्णः) {
    यदि (वर्णः == "०" वा वर्णः == "१" वा वर्णः == "२" वा वर्णः == "३" वा वर्णः == "४" वा
         वर्णः == "५" वा वर्णः == "६" वा वर्णः == "७" वा वर्णः == "८" वा वर्णः == "९") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् आङ्ग्ल_अङ्कम्(वर्णः) {
    यदि (वर्णः == "0" वा वर्णः == "1" वा वर्णः == "2" वा वर्णः == "3" वा वर्णः == "4" वा
         वर्णः == "5" वा वर्णः == "6" वा वर्णः == "7" वा वर्णः == "8" वा वर्णः == "9") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् अङ्क_परिवर्तनम्(वर्णः) {
    यदि (वर्णः == "०") { प्रत्यागच्छ "0"; }
    यदि (वर्णः == "१") { प्रत्यागच्छ "1"; }
    यदि (वर्णः == "२") { प्रत्यागच्छ "2"; }
    यदि (वर्णः == "३") { प्रत्यागच्छ "3"; }
    यदि (वर्णः == "४") { प्रत्यागच्छ "4"; }
    यदि (वर्णः == "५") { प्रत्यागच्छ "5"; }
    यदि (वर्णः == "६") { प्रत्यागच्छ "6"; }
    यदि (वर्णः == "७") { प्रत्यागच्छ "7"; }
    यदि (वर्णः == "८") { प्रत्यागच्छ "8"; }
    यदि (वर्णः == "९") { प्रत्यागच्छ "9"; }
    प्रत्यागच्छ वर्णः;
}

फलनम् रिक्तस्थानम्_अस्ति(वर्णः) {
    यदि (वर्णः == " " वा वर्णः == "\t" वा वर्णः == "\r" वा वर्णः == "\n") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् विरामचिह्नम्_अस्ति(वर्णः) {
    यदि (वर्णः == "(" वा वर्णः == ")" वा वर्णः == "{" वा वर्णः == "}" वा
         वर्णः == "[" वा वर्णः == "]" वा वर्णः == ";" वा वर्णः == "," वा
         वर्णः == "+" वा वर्णः == "-" वा वर्णः == "*" वा वर्णः == "/" वा
         वर्णः == "%" वा वर्णः == "=" वा वर्णः == "<" वा वर्णः == ">" वा
         वर्णः == "!" वा वर्णः == "&" वा वर्णः == "|" वा
         वर्णः == "==" वा वर्णः == "!=" वा वर्णः == "<=" वा वर्णः == ">=") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् अन्तर्निर्मितम्_अस्ति(पदम्) {
    यदि (पदम् == "सूत्र_दीर्घता" वा पदम् == "सूत्र_खण्डम्" वा पदम् == "वर्ण_प्राप्नु" वा
         पदम् == "सूत्र_सम्बन्ध" वा पदम् == "संख्या_परिवर्तय" वा पदम् == "सूत्र_परिवर्तय" वा
         पदम् == "सूत्र_विभाजय" वा पदम् == "सूत्र_संयोजय" वा पदम् == "सूत्र_प्रतिस्थापनम्" वा
         पदम् == "सूत्र_अन्वेषणम्" वा पदम् == "सूत्र_छेदय" वा पदम् == "सूत्र_आरम्भः" वा
         पदम् == "सूत्र_अन्तः" वा पदम् == "लघु_वर्णमाला" वा पदम् == "गुरु_वर्णमाला" वा
         पदम् == "सूची_रचय" वा पदम् == "सूची_योजय" वा पदम् == "सूची_प्राप्नु" वा
         पदम् == "सूची_स्थापय" वा पदम् == "सूची_दीर्घता" वा पदम् == "सूची_द्वयम्" वा
         पदम् == "सूची_खण्डम्" वा पदम् == "सूची_निष्कासय" वा पदम् == "सूची_शोधय" वा
         पदम् == "सूची_विपरीत" वा पदम् == "सूची_अन्तर्भावः" वा पदम् == "सूची_संयोजय" वा
         पदम् == "सूची_अन्वेषणम्" वा पदम् == "कोष_रचय" वा पदम् == "कोष_स्थापय" वा
         पदम् == "कोष_प्राप्नु" वा पदम् == "कोष_अस्ति" वा पदम् == "कोष_निष्कासय" वा
         पदम् == "कोष_कुञ्चिकाः" वा पदम् == "कोष_मूल्यानि" वा पदम् == "कोष_दीर्घता" वा
         पदम् == "कोष_स्वच्छीकुरु" वा पदम् == "गणित_वर्गमूलम्" वा पदम् == "गणित_घातः" वा
         पदम् == "गणित_परममूल्यम्" वा पदम् == "गणित_ज्या" वा पदम् == "गणित_कोज्या" वा
         पदम् == "गणित_स्पर्शज्या" वा पदम् == "गणित_अधः" वा पदम् == "गणित_उपरि" वा
         पदम् == "गणित_समीपम्" वा पदम् == "गणित_पाई" वा पदम् == "गणित_ई" वा
         पदम् == "यादृच्छिक" वा पदम् == "यादृच्छिक_अन्तराले" वा पदम् == "काल_वर्तमान_मिली" वा
         पदम् == "काल_वर्तमान_क्षणम्" वा पदम् == "काल_विराम" वा पदम् == "सञ्चिका_पठ" वा
         पदम् == "सञ्चिका_लिख" वा पदम् == "सञ्चिका_विद्यते" वा पदम् == "सञ्चिका_लोपय" वा
         पदम् == "सञ्चिका_निर्देशिका_सूची" वा पदम् == "निर्देशिका_रचय" वा पदम् == "प्रणाली_वातावरणम्" वा
         पदम् == "प्रणाली_सञ्चालकः" वा पदम् == "जेसन_रूपान्तरम्" वा पदम् == "जेसन_पठ" वा
         पदम् == "प्रकारः" वा पदम् == "दशांश_परिवर्तय" वा पदम् == "पूर्णाङ्क_परिवर्तय" वा
         पदम् == "वातायनम्_दर्शय" वा पदम् == "पत्रलेखकम्_आरभस्व" वा पदम् == "आदेशः_निष्पादय" वा
         पदम् == "आदेशतर्काः" वा पदम् == "बहिर्गच्छ") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

// पद-रूपान्तरणम् (Expression Token to C# Code)
फलनम् पद_रूपान्तरम्(पदम्) {
    यदि (पदम् == "सत्यम्") { प्रत्यागच्छ "true"; }
    यदि (पदम् == "असत्यम्") { प्रत्यागच्छ "false"; }
    यदि (पदम् == "तथा") { प्रत्यागच्छ "&&"; }
    यदि (पदम् == "वा") { प्रत्यागच्छ "||"; }
    यदि (पदम् == "न") { प्रत्यागच्छ "!"; }
    यदि (अन्तर्निर्मितम्_अस्ति(पदम्)) { प्रत्यागच्छ पदम्; }
    यदि (सूत्र_दीर्घता(पदम्) > ० तथा वर्ण_प्राप्नु(पदम्, ०) == "\"") { प्रत्यागच्छ पदम्; }
    यदि (सूत्र_दीर्घता(पदम्) > ० तथा आङ्ग्ल_अङ्कम्(वर्ण_प्राप्नु(पदम्, ०))) { प्रत्यागच्छ पदम्; }
    यदि (विरामचिह्नम्_अस्ति(पदम्)) { प्रत्यागच्छ पदम्; }
    प्रत्यागच्छ "var_" + पदम्;
}

// किं पदम् वाक्यसमाप्तौ योग्यम्?
फलनम् समाप्ति_योग्यम्(पदम्) {
    यदि (पदम् == "" वा पदम् == ";" वा पदम् == "{" वा पदम् == "}" वा पदम् == "(" वा पदम् == "[" वा
         पदम् == "," वा पदम् == "+" वा पदम् == "-" वा पदम् == "*" वा पदम् == "/" वा पदम् == "%" वा
         पदम् == "=" वा पदम् == "==" वा पदम् == "!=" वा पदम् == "<=" वा पदम् == ">=" वा
         पदम् == "<" वा पदम् == ">" वा पदम् == "वा" वा पदम् == "तथा" वा पदम् == "यदि" वा
         पदम् == "यावत्" वा पदम् == "चलम्" वा पदम् == "स्थिरम्" वा पदम् == "फलनम्" वा
         पदम् == "अन्यथा" वा पदम् == "लिख" वा पदम् == "प्रत्यागच्छ") {
        प्रत्यागच्छ असत्यम्;
    }
    प्रत्यागच्छ सत्यम्;
}

// सहायक-पठन-फलनानि
फलनम् सूत्रम्_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "\"";
    चलम् वर्तमान_सूचकः = सूचकः + १;
    चलम् समाप्तम् = असत्यम्;

    यावत् (वर्तमान_सूचकः < दीर्घता तथा समाप्तम् == असत्यम्) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (च == "\\") {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            यदि (वर्तमान_सूचकः < दीर्घता) {
                पाठः = पाठः + वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
                वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            }
        } अन्यथा यदि (च == "\"") {
            पाठः = पाठः + "\"";
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
            समाप्तम् = सत्यम्;
        } अन्यथा {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        }
    }

    प्रत्यागच्छ सूची_द्वयम्(पाठः, वर्तमान_सूचकः);
}

फलनम् यावत्_विराम() {
    प्रत्यागच्छ ०;
}

फलनम् अङ्कम्_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "";
    चलम् वर्तमान_सूचकः = सूचकः;

    यावत् (वर्तमान_सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (देवनागरी_अङ्कम्(च) वा आङ्ग्ल_अङ्कम्(च)) {
            पाठः = पाठः + अङ्क_परिवर्तनम्(च);
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        } अन्यथा {
            यावत्_विराम();
            चलम् शेषः = दीर्घता - वर्तमान_सूचकः;
            वर्तमान_सूचकः = वर्तमान_सूचकः + शेषः;
        }
    }

    चलम् परिणाम_सूचकः = सूचकः + सूत्र_दीर्घता(पाठः);
    प्रत्यागच्छ सूची_द्वयम्(पाठः + "L", परिणाम_सूचकः);
}

फलनम् नाम_पठ(स्रोतः, सूचकः, दीर्घता) {
    चलम् पाठः = "";
    चलम् वर्तमान_सूचकः = सूचकः;

    यावत् (वर्तमान_सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(स्रोतः, वर्तमान_सूचकः);
        यदि (रिक्तस्थानम्_अस्ति(च) वा विरामचिह्नम्_अस्ति(च) वा च == "\"") {
            चलम् शेषः = दीर्घता - वर्तमान_सूचकः;
            वर्तमान_सूचकः = वर्तमान_सूचकः + शेषः;
        } अन्यथा {
            पाठः = पाठः + च;
            वर्तमान_सूचकः = वर्तमान_सूचकः + १;
        }
    }

    चलम् परिणाम_सूचकः = सूचकः + सूत्र_दीर्घता(पाठः);
    प्रत्यागच्छ सूची_द्वयम्(पाठः, परिणाम_सूचकः);
}

// पदच्छेदकः (Tokenizer)
फलनम् पदच्छेदः(स्रोतः) {
    चलम् चिह्नानि = सूची_रचय();
    चलम् दीर्घता = सूत्र_दीर्घता(स्रोतः);
    चलम् सूचकः = ०;

    यावत् (सूचकः < दीर्घता) {
        चलम् वर्तमानः = वर्ण_प्राप्नु(स्रोतः, सूचकः);

        यदि (वर्तमानः == "\n") {
            चलम् सङ्ख्या = सूची_दीर्घता(चिह्नानि);
            यदि (सङ्ख्या > ०) {
                चलम् अन्तिमम् = सूची_प्राप्नु(चिह्नानि, सङ्ख्या - १);
                यदि (समाप्ति_योग्यम्(अन्तिमम्)) {
                    सूची_योजय(चिह्नानि, ";");
                }
            }
            सूचकः = सूचकः + १;
        } अन्यथा यदि (रिक्तस्थानम्_अस्ति(वर्तमानः)) {
            सूचकः = सूचकः + १;
        } अन्यथा {
            चलम् अग्रिमः = "";
            यदि (सूचकः + १ < दीर्घता) {
                अग्रिमः = वर्ण_प्राप्नु(स्रोतः, सूचकः + १);
            }

            // एकपङ्क्ति-टिप्पणी
            यदि (वर्तमानः == "/" तथा अग्रिमः == "/") {
                सूचकः = सूचकः + २;
                यावत् (सूचकः < दीर्घता तथा वर्ण_प्राप्नु(स्रोतः, सूचकः) != "\n") {
                    सूचकः = सूचकः + १;
                }
            } अन्यथा यदि (वर्तमानः == "/" तथा अग्रिमः == "*") {
                // बहुपङ्क्ति-टिप्पणी
                सूचकः = सूचकः + २;
                यावत् (सूचकः + १ < दीर्घता) {
                    यदि (वर्ण_प्राप्नु(स्रोतः, सूचकः) == "*" तथा वर्ण_प्राप्नु(स्रोतः, सूचकः + १) == "/") {
                        सूचकः = सूचकः + २;
                        सूचकः = सूचकः + दीर्घता;
                    } अन्यथा {
                        सूचकः = सूचकः + १;
                    }
                }
            } अन्यथा यदि (वर्तमानः == "\"") {
                चलम् सूत्र_परिणामः = सूत्रम्_पठ(स्रोतः, सूचकः, दीर्घता);
                सूची_योजय(चिह्नानि, सूची_प्राप्नु(सूत्र_परिणामः, ०));
                सूचकः = सूची_प्राप्नु(सूत्र_परिणामः, १);
            } अन्यथा यदि (देवनागरी_अङ्कम्(वर्तमानः) वा आङ्ग्ल_अङ्कम्(वर्तमानः)) {
                चलम् अङ्क_परिणामः = अङ्कम्_पठ(स्रोतः, सूचकः, दीर्घता);
                सूची_योजय(चिह्नानि, सूची_प्राप्नु(अङ्क_परिणामः, ०));
                सूचकः = सूची_प्राप्नु(अङ्क_परिणामः, १);
            } अन्यथा {
                चलम् द्वि_चिह्नम् = "";
                यदि (सूचकः + १ < दीर्घता) {
                    द्वि_चिह्नम् = वर्तमानः + अग्रिमः;
                }

                यदि (द्वि_चिह्नम् == "==" वा द्वि_चिह्नम् == "!=" वा द्वि_चिह्नम् == "<=" वा द्वि_चिह्नम् == ">=") {
                    सूची_योजय(चिह्नानि, द्वि_चिह्नम्);
                    सूचकः = सूचकः + २;
                } अन्यथा यदि (विरामचिह्नम्_अस्ति(वर्तमानः)) {
                    सूची_योजय(चिह्नानि, वर्तमानः);
                    सूचकः = सूचकः + १;
                } अन्यथा {
                    चलम् नाम_परिणामः = नाम_पठ(स्रोतः, सूचकः, दीर्घता);
                    सूची_योजय(चिह्नानि, सूची_प्राप्नु(नाम_परिणामः, ०));
                    सूचकः = सूची_प्राप्नु(नाम_परिणामः, १);
                }
            }
        }
    }

    चलम् अन्तिम_सङ्ख्या = सूची_दीर्घता(चिह्नानि);
    यदि (अन्तिम_सङ्ख्या > ०) {
        चलम् शेष_अन्तिमम् = सूची_प्राप्नु(चिह्नानि, अन्तिम_सङ्ख्या - १);
        यदि (समाप्ति_योग्यम्(शेष_अन्तिमम्)) {
            सूची_योजय(चिह्नानि, ";");
        }
    }

    प्रत्यागच्छ चिह्नानि;
}

