// ============================================================================
// प्रज्ञा (Prajna) — स्वदेशी-बाइट्कोड्-सङ्कलकः (Prajna Native Bytecode Compiler)
// सञ्चिका: prajna/yantravastuvinyasah/native_compiler.pr
// ============================================================================

फलनम् सङ्कलक_रचना() {
    चलम् सङ्क = कोष_रचय();
    कोष_स्थापय(सङ्क, "उत्पादन_प्रकारः", "prc");
    कोष_स्थापय(सङ्क, "संस्करकः", "Prajna-BC-1");
    कोष_स्थापय(सङ्क, "काष्ठकम्", "NativePrajnaVM");
    प्रत्यागच्छ सङ्क;
}

// स्वदेशी-सङ्कलक-परीक्षणम् (Self-test)
फलनम् स्वदेशी_सङ्कलक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: स्वदेशी-बाइट्कोड्-सङ्कलकः] ---";
    चलम् सङ्क = सङ्कलक_रचना();
    लिख "प्रकारः: " + कोष_प्राप्नु(सङ्क, "उत्पादन_प्रकारः");
    लिख "संस्करकः: " + कोष_प्राप्नु(सङ्क, "संस्करकः");
    लिख "काष्ठकम्: " + कोष_प्राप्नु(सङ्क, "काष्ठकम्");
    लिख "स्वदेशी-बाइट्कोड्-सङ्कलक-परीक्षणं सम्पूर्णम्!\n";
}

स्वदेशी_सङ्कलक_परीक्षणम्();
