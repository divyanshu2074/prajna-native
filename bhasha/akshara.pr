// ============================================================================
// प्रज्ञा (Prajna) — अक्षरव्यवस्था तथा यूनिकोड्-संसाधनम् (Unicode & Character Utilities)
// सञ्चिका: prajna/bhasha/akshara.pr
// ============================================================================

फलनम् देवनागरी_अङ्कम्(वर्णः) {
    यदि (वर्णः == "०" वा वर्णः == "१" वा वर्णः == "२" वा वर्णः == "३" वा वर्णः == "४" वा
         वर्णः == "५" वा वर्णः == "६" वा वर्णः == "७" वा वर्णः == "८" वा वर्णः == "९") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् आङ्ग्ल_अङ्कम्(वर्णः) {
    यदि (वर्णः == "0" वा वर्णः == "1" वा वर्णः == "2" वा वर्णः == "3" वा वर्णः == "4" वा
         वर्णः == "5" वा वर्णः == "6" वा वर्णः == "7" वा वर्णः == "8" वा वर्णः == "9") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् अङ्क_परिवर्तनम्(वर्णः) {
    यदि (वर्णः == "०") { प्रत्यागच्छ "0"; }
    यदि (वर्णः == "१") { प्रत्यागच्छ "1"; }
    यदि (वर्णः == "२") { प्रत्यागच्छ "2"; }
    यदि (वर्णः == "३") { प्रत्यागच्छ "3"; }
    यदि (वर्णः == "४") { प्रत्यागच्छ "4"; }
    यदि (वर्णः == "५") { प्रत्यागच्छ "5"; }
    यदि (वर्णः == "६") { प्रत्यागच्छ "6"; }
    यदि (वर्णः == "७") { प्रत्यागच्छ "7"; }
    यदि (वर्णः == "८") { प्रत्यागच्छ "8"; }
    यदि (वर्णः == "९") { प्रत्यागच्छ "9"; }
    प्रत्यागच्छ वर्णः;
}

फलनम् आङ्ग्ल_तः_देवनागरी(वर्णः) {
    यदि (वर्णः == "0") { प्रत्यागच्छ "०"; }
    यदि (वर्णः == "1") { प्रत्यागच्छ "१"; }
    यदि (वर्णः == "2") { प्रत्यागच्छ "२"; }
    यदि (वर्णः == "3") { प्रत्यागच्छ "३"; }
    यदि (वर्णः == "4") { प्रत्यागच्छ "४"; }
    यदि (वर्णः == "5") { प्रत्यागच्छ "५"; }
    यदि (वर्णः == "6") { प्रत्यागच्छ "६"; }
    यदि (वर्णः == "7") { प्रत्यागच्छ "७"; }
    यदि (वर्णः == "8") { प्रत्यागच्छ "८"; }
    यदि (वर्णः == "9") { प्रत्यागच्छ "९"; }
    प्रत्यागच्छ वर्णः;
}

फलनम् देवनागरी_अक्षरम्_अस्ति(वर्णः) {
    यदि (देवनागरी_अङ्कम्(वर्णः)) {
        प्रत्यागच्छ सत्यम्;
    }
    // संस्कृत-स्वर-व्यञ्जनानि
    यदि (वर्णः == "अ" वा वर्णः == "आ" वा वर्णः == "इ" वा वर्णः == "ई" वा वर्णः == "उ" वा वर्णः == "ऊ" वा
         वर्णः == "ऋ" वा वर्णः == "ए" वा वर्णः == "ऐ" वा वर्णः == "ओ" वा वर्णः == "औ" वा वर्णः == "अं" वा वर्णः == "अः") {
        प्रत्यागच्छ सत्यम्;
    }
    यदि (वर्णः == "क" वा वर्णः == "ख" वा वर्णः == "ग" वा वर्णः == "घ" वा वर्णः == "ङ" वा
         वर्णः == "च" वा वर्णः == "छ" वा वर्णः == "ज" वा वर्णः == "झ" वा वर्णः == "ञ" वा
         वर्णः == "ट" वा वर्णः == "ठ" वा वर्णः == "ड" वा वर्णः == "ढ" वा वर्णः == "ण" वा
         वर्णः == "त" वा वर्णः == "थ" वा वर्णः == "द" वा वर्णः == "ध" वा वर्णः == "न" वा
         वर्णः == "प" वा वर्णः == "फ" वा वर्णः == "ब" वा वर्णः == "भ" वा वर्णः == "म" वा
         वर्णः == "य" वा वर्णः == "र" वा वर्णः == "ल" वा वर्णः == "व" वा
         वर्णः == "श" वा वर्णः == "ष" वा वर्णः == "स" वा वर्णः == "ह") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् नामन्_प्रारम्भः(वर्णः) {
    यदि (वर्णः == "_") {
        प्रत्यागच्छ सत्यम्;
    }
    यदि (वर्णः >= "a" तथा वर्णः <= "z") {
        प्रत्यागच्छ सत्यम्;
    }
    यदि (वर्णः >= "A" तथा वर्णः <= "Z") {
        प्रत्यागच्छ सत्यम्;
    }
    यदि (देवनागरी_अक्षरम्_अस्ति(वर्णः)) {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् नामन्_अनुवृत्तिः(वर्णः) {
    यदि (नामन्_प्रारम्भः(वर्णः)) {
        प्रत्यागच्छ सत्यम्;
    }
    यदि (देवनागरी_अङ्कम्(वर्णः) वा आङ्ग्ल_अङ्कम्(वर्णः)) {
        प्रत्यागच्छ सत्यम्;
    }
    // मात्राः तथा चिह्नानि
    यदि (वर्णः == "ा" वा वर्णः == "ि" वा वर्णः == "ी" वा वर्णः == "ु" वा वर्णः == "ू" वा
         वर्णः == "ृ" वा वर्णः == "े" वा वर्णः == "ै" वा वर्णः == "ो" वा वर्णः == "ौ" वा
         वर्णः == "ं" वा वर्णः == "ः" वा वर्णः == "्" वा वर्णः == "ँ") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् देवनागरी_पूर्णाङ्कः(पाठः) {
    चलम् दीर्घता = सूत्र_दीर्घता(पाठः);
    चलम् रूपान्तरितम् = "";
    चलम् सूचकः = ०;
    यावत् (सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(पाठः, सूचकः);
        रूपान्तरितम् = रूपान्तरितम् + अङ्क_परिवर्तनम्(च);
        सूचकः = सूचकः + १;
    }
    प्रत्यागच्छ पूर्णाङ्क_परिवर्तय(रूपान्तरितम्);
}

फलनम् पूर्णाङ्क_देवनागरी(संख्या) {
    चलम् मूलम् = सूत्र_परिवर्तय(संख्या);
    चलम् दीर्घता = सूत्र_दीर्घता(मूलम्);
    चलम् फलम् = "";
    चलम् सूचकः = ०;
    यावत् (सूचकः < दीर्घता) {
        चलम् च = वर्ण_प्राप्नु(मूलम्, सूचकः);
        फलम् = फलम् + आङ्ग्ल_तः_देवनागरी(च);
        सूचकः = सूचकः + १;
    }
    प्रत्यागच्छ फलम्;
}

// अक्षरव्यवस्था-परीक्षणम् (Self-test)
फलनम् अक्षर_परीक्षणम्() {
    लिख "--- [परीक्षणम्: अक्षरव्यवस्था] ---";
    चलम् स१ = देवनागरी_पूर्णाङ्कः("१२३४५");
    लिख "देवनागरी_पूर्णाङ्कः('१२३४५') = " + सूत्र_परिवर्तय(स१);
    चलम् स२ = पूर्णाङ्क_देवनागरी(९८७६);
    लिख "पूर्णाङ्क_देवनागरी(९८७६) = " + स२;
    चलम् स३ = नामन्_प्रारम्भः("प्र");
    लिख "नामन्_प्रारम्भः('प्र') = " + सूत्र_परिवर्तय(स३);
    लिख "अक्षरव्यवस्था-परीक्षणं सम्पूर्णम्!\n";
}

अक्षर_परीक्षणम्();
