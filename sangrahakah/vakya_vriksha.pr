// ============================================================================

// अमूर्त नोड्-निर्माणम् (AST Node Factory)
फलनम् अमूर्त_नोड्_रचय(प्रकार_नाम, पङ्क्ति_सङ्ख्या, स्तम्भ_सङ्ख्या) {
    चलम् नोड् = कोष_रचय();
    कोष_स्थापय(नोड्, "प्रकारः", प्रकार_नाम);
    कोष_स्थापय(नोड्, "पङ्क्तिः", पङ्क्ति_सङ्ख्या);
    कोष_स्थापय(नोड्, "स्तम्भः", स्तम्भ_सङ्ख्या);
    प्रत्यागच्छ नोड्;
}

फलनम् अमूर्त_पूर्णाङ्क(संख्या, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("PURNANKA", पं, स्त);
    कोष_स्थापय(नो, "मूल्यम्", संख्या);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_सूत्रम्(पाठः, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("SUTRAM", पं, स्त);
    कोष_स्थापय(नो, "मूल्यम्", पाठः);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_नामपदम्(नामन्, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("NAMAPADA", पं, स्त);
    कोष_स्थापय(नो, "नामन्", नामन्);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_द्विविध(वाम, क्रिया, दक्षिण, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("DVIVIDHA", पं, स्त);
    कोष_स्थापय(नो, "वाम", वाम);
    कोष_स्थापय(नो, "क्रिया", क्रिया);
    कोष_स्थापय(नो, "दक्षिण", दक्षिण);
    प्रत्यागच्छ नो;
}

फलनम् अमूर्त_चलघोषणा(नामन्, प्रारम्भ_मूल्य, पं, स्त) {
    चलम् नो = अमूर्त_नोड्_रचय("CHALA_GHOSHANA", पं, स्त);
