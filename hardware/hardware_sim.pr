// ============================================================================
// प्रज्ञा (Prajna) — यन्त्रानुकारकः (Cycle-Accurate Hardware Simulator)
// सञ्चिका: prajna/hardware/hardware_sim.pr
// ============================================================================

फलनम् यन्त्र_सिम्युलेटर_रचय(स्मृति_परिमाणम्) {
    चलम् सिम = कोष_रचय();
    चलम् पञ्जिकाः = सूची_रचय();
    चलम् सू = ०;
    यावत् (सू < १६) {
        सूची_योजय(पञ्जिकाः, ०);
        सू = सू + १;
    }
    कोष_स्थापय(सिम, "पञ्जिकाः", पञ्जिकाः);
    कोष_स्थापय(सिम, "स्मृतिः", कोष_रचय());
    कोष_स्थापय(सिम, "पीसी", ०);
    कोष_स्थापय(सिम, "चक्राणि", ०);
    कोष_स्थापय(सिम, "विरामः", असत्यम्);
    कोष_स्थापय(सिम, "निर्गमाः", सूची_रचय());
    प्रत्यागच्छ सिम;
}

// पञ्जिका-पठनम्
फलनम् पञ्जिका_पठ(सिम, अनुक्रमः) {
    यदि (अनुक्रमः == ०) {
        प्रत्यागच्छ ०; // R0 is always zero
    }
    चलम् पञ्जिकाः = कोष_प्राप्नु(सिम, "पञ्जिकाः");
    प्रत्यागच्छ सूची_प्राप्नु(पञ्जिकाः, अनुक्रमः);
}

// पञ्जिका-लेखनम्
फलनम् पञ्जिका_लिख(सिम, अनुक्रमः, मूल्यम्) {
    यदि (अनुक्रमः > ०) {
        चलम् पञ्जिकाः = कोष_प्राप्नु(सिम, "पञ्जिकाः");
        सूची_स्थापय(पञ्जिकाः, अनुक्रमः, मूल्यम्);
    }
}

// एकस्य चक्रस्य निष्पादनम् (Execute one cycle / instruction)
फलनम् सिम_एक_चक्रम्(सिम, निर्देशः) {
    चलम् आदेशः = कोष_प्राप्नु(निर्देशः, "आदेशः");
    चलम् चक्राणि = कोष_प्राप्नु(सिम, "चक्राणि");
    कोष_स्थापय(सिम, "चक्राणि", चक्राणि + १);

    यदि (आदेशः == "LI") {
        चलम् आरडी = कोष_प्राप्नु(निर्देशः, "आर_डी");
        चलम् तत् = कोष_प्राप्नु(निर्देशः, "तत्कालिकम्");
        पञ्जिका_लिख(सिम, आरडी, तत्);
    }
    अन्यथा यदि (आदेशः == "ADD") {
        चलम् आरडी = कोष_प्राप्नु(निर्देशः, "आर_डी");
        चलम् आरएस१ = कोष_प्राप्नु(निर्देशः, "आर_एस१");
        चलम् आरएस२ = कोष_प्राप्नु(निर्देशः, "आर_एस२");
        चलम् व१ = पञ्जिका_पठ(सिम, आरएस१);
        चलम् व२ = पञ्जिका_पठ(सिम, आरएस२);
        पञ्जिका_लिख(सिम, आरडी, व१ + व२);
    }
    अन्यथा यदि (आदेशः == "OUT") {
        चलम् आरएस१ = कोष_प्राप्नु(निर्देशः, "आर_एस१");
        चलम् व१ = पञ्जिका_पठ(सिम, आरएस१);
        लिख "यन्त्र-निर्गमः [R" + सूत्र_परिवर्तय(आरएस१) + "] = " + सूत्र_परिवर्तय(व१);
        चलम् निर् = कोष_प्राप्नु(सिम, "निर्गमाः");
        सूची_योजय(निर्, व१);
    }
    अन्यथा यदि (आदेशः == "HALT") {
        कोष_स्थापय(सिम, "विरामः", सत्यम्);
    }
}

// यन्त्रानुकारक-परीक्षणम् (Self-test)
फलनम् यन्त्रानुकारक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: Prajna Hardware Simulator] ---";
    चलम् सिम = यन्त्र_सिम्युलेटर_रचय(१०२४);

    // निर्देश १: LI R2, 70
    चलम् नि१ = कोष_रचय(); कोष_स्थापय(नि१, "आदेशः", "LI"); कोष_स्थापय(नि१, "आर_डी", २); कोष_स्थापय(नि१, "तत्कालिकम्", ७०);
    सिम_एक_चक्रम्(सिम, नि१);

    // निर्देश २: LI R3, 30
    चलम् नि२ = कोष_रचय(); कोष_स्थापय(नि२, "आदेशः", "LI"); कोष_स्थापय(नि२, "आर_डी", ३); कोष_स्थापय(नि२, "तत्कालिकम्", ३०);
    सिम_एक_चक्रम्(सिम, नि२);

    // निर्देश ३: ADD R4, R2, R3
    चलम् नि३ = कोष_रचय(); कोष_स्थापय(नि३, "आदेशः", "ADD"); कोष_स्थापय(नि३, "आर_डी", ४); कोष_स्थापय(नि३, "आर_एस१", २); कोष_स्थापय(नि३, "आर_एस२", ३);
    सिम_एक_चक्रम्(सिम, नि३);

    // निर्देश ४: OUT R4
    चलम् नि४ = कोष_रचय(); कोष_स्थापय(नि४, "आदेशः", "OUT"); कोष_स्थापय(नि४, "आर_एस१", ४);
    सिम_एक_चक्रम्(सिम, नि४);

    लिख "कुल-चक्राणि = " + सूत्र_परिवर्तय(कोष_प्राप्नु(सिम, "चक्राणि"));
    लिख "Prajna Hardware Simulator परीक्षणं सम्पूर्णम्!\n";
}

यन्त्रानुकारक_परीक्षणम्();
