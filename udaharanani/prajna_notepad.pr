// प्रज्ञा (Prajna) — संस्कृत-पत्रलेखकः (Prajna Notepad GUI Application)
// अयम् अनुप्रयोगः सम्पूर्णतया प्रज्ञा-स्रोतःसङ्केतेन निर्मितः विण्डोज-वातायन-अनुप्रयोगः अस्ति।

फलनम् मुख्यम्() {
    लिख "==================================================";
    लिख "प्रज्ञा-पत्रलेखक-वातायनम् (Prajna Notepad) आरभते...";
    लिख "संस्कृतभाषायाः स्वायत्त-सङ्गणकप्रणाली";
    लिख "==================================================";

    चलम् शीर्षकम् = "प्रज्ञा पत्रलेखकः (Prajna Notepad)";
    चलम् प्रारम्भिक_पाठः = "शुभं भवतु! प्रज्ञा-सङ्गणकप्रणाल्यां भवतां स्वागतम्।\n\nअयम् अनुप्रयोगः प्रज्ञा-भाषायाः स्वदेशी-सङ्कलकेन निर्मितः अस्ति।\nअत्र देवनागरीलिप्या प्रोग्राम-सङ्केतः, संस्कृतवाक्यानि, पाठ्यानि च लेखितुं शक्यन्ते।\n\nसञ्चिका-विकल्पाः:\n१. नूतनम् (Ctrl+N)\n२. उद्घाटय (Ctrl+O)\n३. रक्ष (Ctrl+S)\n४. त्यागः (Alt+F4)\n";

    // विण्डोज-वातायनस्य समारम्भः
    चलम् परिणामः = पत्रलेखकम्_आरभस्व(शीर्षकम्, प्रारम्भिक_पाठः);

    लिख "पत्रलेखक-वातायनं सफ़लतया पिहितम्।";
    प्रत्यागच्छ परिणामः;
}

मुख्यम्();
