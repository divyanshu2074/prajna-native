    धावकः = धावकः + "    public static long YaadrichhikaAntarale(object min, object max) { return _rnd.Next(Convert.ToInt32(min), Convert.ToInt32(max) + 1); }\n";
    धावकः = धावकः + "    public static long KalaVartamanaMili() { return (long)(DateTime.UtcNow.Subtract(new DateTime(1970, 1, 1))).TotalMilliseconds; }\n";
    धावकः = धावकः + "    public static string KalaVartamanaKshanam() { return DateTime.Now.ToString(\"yyyy-MM-dd HH:mm:ss\"); }\n";
    धावकः = धावकः + "    public static long KalaVirama(object ms) { System.Threading.Thread.Sleep(Convert.ToInt32(ms)); return 1; }\n";
    धावकः = धावकः + "    public static long SanchikaLopaya(object path) { string p = path == null ? \"\" : path.ToString(); if (File.Exists(p)) File.Delete(p); return 1; }\n";
    धावकः = धावकः + "    public static List<object> SanchikaNirdeshikaSuchi(object dir) { var res = new List<object>(); string d = dir == null ? \"\" : dir.ToString(); if (Directory.Exists(d)) { foreach (var f in Directory.GetFileSystemEntries(d)) res.Add(Path.GetFileName(f)); } return res; }\n";
    धावकः = धावकः + "    public static long NirdeshikaRachaya(object dir) { string d = dir == null ? \"\" : dir.ToString(); if (!Directory.Exists(d)) Directory.CreateDirectory(d); return 1; }\n";
    धावकः = धावकः + "    public static string PranaliVatavaranam(object key) { return Environment.GetEnvironmentVariable(key == null ? \"\" : key.ToString()) ?? \"\"; }\n";
    धावकः = धावकः + "    public static string JesonRupantaram(object obj) { return Format(obj); }\n";
    धावकः = धावकः + "    public static object JesonPatha(object str) { return str == null ? \"\" : str.ToString(); }\n";
    धावकः = धावकः + "    public static string Prakaarah(object v) { if (v == null) return \"शून्यम्\"; if (v is bool) return \"बूलियनम्\"; if (v is long || v is int) return \"संख्या\"; if (v is double || v is float) return \"दशांशः\"; if (v is string) return \"सूत्रम्\"; if (v is IList) return \"सूची\"; if (v is IDictionary) return \"शब्दकोषः\"; return \"अज्ञातम्\"; }\n";
    धावकः = धावकः + "    public static double DashamshaParivartaya(object v) { if (v == null) return 0.0; double d = 0.0; double.TryParse(v.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d); return d; }\n";
    धावकः = धावकः + "    public static long PurnankaParivartaya(object v) { if (v == null) return 0; double d = 0.0; if (double.TryParse(v.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d)) return (long)d; return 0; }\n";
    धावकः = धावकः + "    public static void Bahirgaccha(object code) { Environment.Exit(Convert.ToInt32(code)); }\n";
    धावकः = धावकः + "\n    // DataFrames (दत्ततालिका)\n    public static Dictionary<string, object> TalikaRachaya(object stambhah) {\n        var d = new Dictionary<string, object>();\n        var list = new List<object>();\n        var sList = stambhah as IList;\n        if (sList != null) { foreach (var item in sList) list.Add(item == null ? \"\" : item.ToString()); }\n        d[\"stambhah\"] = list;\n        d[\"panktiyah\"] = new List<object>();\n        return d;\n    }\n    public static dynamic TalikaPanktiYojaya(dynamic talika, dynamic pankti) {\n        if (talika != null && talika is IDictionary && talika.ContainsKey(\"panktiyah\")) {\n            var list = talika[\"panktiyah\"] as IList;\n            if (list != null) list.Add(pankti);\n        }\n        return talika;\n    }\n    public static List<object> TalikaStambhaPraptnu(dynamic talika, dynamic stambhaNama) {\n        var res = new List<object>();\n        if (talika != null && talika is IDictionary && talika.ContainsKey(\"stambhah\") && talika.ContainsKey(\"panktiyah\")) {\n            var stambhah = talika[\"stambhah\"] as IList;\n            var panktiyah = talika[\"panktiyah\"] as IList;\n            if (stambhah != null && panktiyah != null) {\n                int idx = -1;\n                string target = stambhaNama == null ? \"\" : stambhaNama.ToString();\n                for (int i = 0; i < stambhah.Count; i++) {\n                    if (stambhah[i] != null && stambhah[i].ToString() == target) { idx = i; break; }\n                }\n                if (idx != -1) {\n                    foreach (var row in panktiyah) {\n                        var r = row as IList;\n                        if (r != null && idx < r.Count) res.Add(r[idx]);\n                        else res.Add(null);\n                    }\n                }\n            }\n        }\n        return res;\n    }\n    public static string TalikaSankshepah(dynamic talika) {\n        if (talika == null || !(talika is IDictionary) || !talika.ContainsKey(\"stambhah\") || !talika.ContainsKey(\"panktiyah\")) return \"[तालिका-दोषः]\";\n        var stambhah = talika[\"stambhah\"] as IList;\n        var panktiyah = talika[\"panktiyah\"] as IList;\n        int cols = stambhah != null ? stambhah.Count : 0;\n        int rows = panktiyah != null ? panktiyah.Count : 0;\n        StringBuilder sb = new StringBuilder();\n        sb.AppendLine(string.Format(\"दत्ततालिका: {0} पङ्क्तयः x {1} स्तम्भाः\", IntToDevanagari(rows), IntToDevanagari(cols)));\n        if (stambhah != null) {\n            sb.Append(\"स्तम्भाः: [ \");\n            foreach (var col in stambhah) sb.Append(col + \" \");\n            sb.Append(\"]\");\n        }\n        return sb.ToString();\n    }\n    public static Dictionary<string, object> DattaPathaCsv(dynamic path) {\n        string p = path == null ? \"\" : path.ToString();\n        var dt = TalikaRachaya(new List<object>());\n        if (File.Exists(p)) {\n            var lines = File.ReadAllLines(p, Encoding.UTF8);\n            if (lines.Length > 0) {\n                var headers = lines[0].Split(',');\n                var stambhaList = new List<object>();\n                foreach (var h in headers) stambhaList.Add(h.Trim());\n                dt[\"stambhah\"] = stambhaList;\n                var rowsList = new List<object>();\n                for (int i = 1; i < lines.Length; i++) {\n                    if (string.IsNullOrWhiteSpace(lines[i])) continue;\n                    var cells = lines[i].Split(',');\n                    var row = new List<object>();\n                    foreach (var c in cells) {\n                        string trimmed = c.Trim();\n                        double num = 0.0;\n                        if (double.TryParse(trimmed, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out num))\n                            row.Add(trimmed.Contains(\".\") ? (object)num : (object)((long)num));\n                        else\n                            row.Add(trimmed);\n                    }\n                    rowsList.Add(row);\n                }\n                dt[\"panktiyah\"] = rowsList;\n            }\n        }\n        return dt;\n    }\n    public static long DattaLekhaCsv(dynamic talika, dynamic path) {\n        string p = path == null ? \"\" : path.ToString();\n        if (talika != null && talika is IDictionary && talika.ContainsKey(\"stambhah\") && talika.ContainsKey(\"panktiyah\")) {\n            var stambhah = talika[\"stambhah\"] as IList;\n            var panktiyah = talika[\"panktiyah\"] as IList;\n            StringBuilder sb = new StringBuilder();\n            if (stambhah != null) {\n                List<string> h = new List<string>();\n                foreach (var col in stambhah) h.Add(col == null ? \"\" : col.ToString());\n                sb.AppendLine(string.Join(\",\", h.ToArray()));\n            }\n            if (panktiyah != null) {\n                foreach (var row in panktiyah) {\n                    var r = row as IList;\n                    if (r != null) {\n                        List<string> cells = new List<string>();\n                        foreach (var c in r) cells.Add(c == null ? \"\" : c.ToString());\n                        sb.AppendLine(string.Join(\",\", cells.ToArray()));\n                    }\n                }\n            }\n            File.WriteAllText(p, sb.ToString(), Encoding.UTF8);\n            return 1;\n        }\n        return 0;\n    }\n\n    // Matrices (संख्याव्यूहः)\n    public static List<object> VyuhaRachaya(dynamic rows, dynamic cols, dynamic values) {\n        int r = Convert.ToInt32(rows);\n        int c = Convert.ToInt32(cols);\n        var matrix = new List<object>();\n        var vals = values as IList;\n        int idx = 0;\n        for (int i = 0; i < r; i++) {\n            var row = new List<object>();\n            for (int j = 0; j < c; j++) {\n                if (vals != null && idx < vals.Count) row.Add(vals[idx++]);\n                else row.Add(0.0);\n            }\n            matrix.Add(row);\n        }\n        return matrix;\n    }\n    public static dynamic VyuhaPraptnu(dynamic m, dynamic r, dynamic c) {\n        var mat = m as IList;\n        if (mat != null) {\n            int rowIdx = Convert.ToInt32(r);\n            int colIdx = Convert.ToInt32(c);\n            if (rowIdx >= 0 && rowIdx < mat.Count) {\n                var row = mat[rowIdx] as IList;\n                if (row != null && colIdx >= 0 && colIdx < row.Count) return row[colIdx];\n            }\n        }\n        return 0.0;\n    }\n    public static dynamic VyuhaSthapaya(dynamic m, dynamic r, dynamic c, dynamic v) {\n        var mat = m as IList;\n        if (mat != null) {\n            int rowIdx = Convert.ToInt32(r);\n            int colIdx = Convert.ToInt32(c);\n            if (rowIdx >= 0 && rowIdx < mat.Count) {\n                var row = mat[rowIdx] as IList;\n                if (row != null && colIdx >= 0 && colIdx < row.Count) row[colIdx] = v;\n            }\n        }\n        return m;\n    }\n    public static long VyuhaPanktiyah(dynamic m) { var mat = m as IList; return mat != null ? mat.Count : 0; }\n    public static long VyuhaStambhah(dynamic m) { var mat = m as IList; if (mat != null && mat.Count > 0) { var r = mat[0] as IList; return r != null ? r.Count : 0; } return 0; }\n    public static List<object> VyuhaParivartah(dynamic m) {\n        var mat = m as IList;\n        if (mat == null || mat.Count == 0) return new List<object>();\n        int r = mat.Count;\n        int c = ((IList)mat[0]).Count;\n        var res = new List<object>();\n        for (int j = 0; j < c; j++) {\n            var newRow = new List<object>();\n            for (int i = 0; i < r; i++) newRow.Add(((IList)mat[i])[j]);\n            res.Add(newRow);\n        }\n        return res;\n    }\n    public static List<object> VyuhaGunanam(dynamic a, dynamic b) {\n        var matA = a as IList;\n        var matB = b as IList;\n        if (matA == null || matB == null || matA.Count == 0 || matB.Count == 0) return new List<object>();\n        int rA = matA.Count;\n        int cA = ((IList)matA[0]).Count;\n        int rB = matB.Count;\n        int cB = ((IList)matB[0]).Count;\n        if (cA != rB) return new List<object>();\n        var res = new List<object>();\n        for (int i = 0; i < rA; i++) {\n            var row = new List<object>();\n            for (int j = 0; j < cB; j++) {\n                double sum = 0.0;\n                for (int k = 0; k < cA; k++) {\n                    double vA = Convert.ToDouble(((IList)matA[i])[k]);\n                    double vB = Convert.ToDouble(((IList)matB[k])[j]);\n                    sum += vA * vB;\n                }\n                row.Add(sum);\n            }\n            res.Add(row);\n        }\n        return res;\n    }\n    public static double SadishaAdishagunanam(dynamic a, dynamic b) {\n        var listA = a as IList;\n        var listB = b as IList;\n        if (listA == null || listB == null) return 0.0;\n        int len = Math.Min(listA.Count, listB.Count);\n        double sum = 0.0;\n        for (int i = 0; i < len; i++) sum += Convert.ToDouble(listA[i]) * Convert.ToDouble(listB[i]);\n        return sum;\n    }\n\n    // Statistics (सांख्यिकी)\n    public static double SankhyikiMadhyamam(dynamic a) {\n        var l = a as IList;\n        if (l == null || l.Count == 0) return 0.0;\n        double sum = 0.0;\n        foreach (var v in l) sum += Convert.ToDouble(v);\n        return sum / l.Count;\n    }\n    public static double SankhyikiMadhyika(dynamic a) {\n        var l = a as IList;\n        if (l == null || l.Count == 0) return 0.0;\n        var nums = new List<double>();\n        foreach (var v in l) nums.Add(Convert.ToDouble(v));\n        nums.Sort();\n        int mid = nums.Count / 2;\n        return (nums.Count % 2 != 0) ? nums[mid] : (nums[mid - 1] + nums[mid]) / 2.0;\n    }\n    public static double SankhyikiVicharanam(dynamic a) {\n        var l = a as IList;\n        if (l == null || l.Count < 2) return 0.0;\n        double mean = SankhyikiMadhyamam(a);\n        double sumSq = 0.0;\n        foreach (var v in l) {\n            double diff = Convert.ToDouble(v) - mean;\n            sumSq += diff * diff;\n        }\n        return sumSq / (l.Count - 1);\n    }\n    public static double SankhyikiPramanavichalanam(dynamic a) {\n        return Math.Sqrt(SankhyikiVicharanam(a));\n    }\n    public static double SankhyikiSahasambandhah(dynamic x, dynamic y) {\n        var lx = x as IList;\n        var ly = y as IList;\n        if (lx == null || ly == null || lx.Count < 2 || lx.Count != ly.Count) return 0.0;\n        double meanX = SankhyikiMadhyamam(x);\n        double meanY = SankhyikiMadhyamam(y);\n        double num = 0.0, denomX = 0.0, denomY = 0.0;\n        for (int i = 0; i < lx.Count; i++) {\n            double dx = Convert.ToDouble(lx[i]) - meanX;\n            double dy = Convert.ToDouble(ly[i]) - meanY;\n            num += dx * dy;\n            denomX += dx * dx;\n            denomY += dy * dy;\n        }\n        double denom = Math.Sqrt(denomX * denomY);\n        return denom == 0.0 ? 0.0 : num / denom;\n    }\n    public static List<object> SankhyikiSamashrayanam(dynamic x, dynamic y) {\n        var lx = x as IList;\n        var ly = y as IList;\n        if (lx == null || ly == null || lx.Count < 2 || lx.Count != ly.Count) return new List<object> { 0.0, 0.0 };\n        double meanX = SankhyikiMadhyamam(x);\n        double meanY = SankhyikiMadhyamam(y);\n        double num = 0.0, denom = 0.0;\n        for (int i = 0; i < lx.Count; i++) {\n            double dx = Convert.ToDouble(lx[i]) - meanX;\n            num += dx * (Convert.ToDouble(ly[i]) - meanY);\n            denom += dx * dx;\n        }\n        double slope = denom == 0.0 ? 0.0 : num / denom;\n        double intercept = meanY - slope * meanX;\n        return new List<object> { slope, intercept };\n";
    धावकः = धावकः + "    // Console Input & Interactive REPL\n";
    धावकः = धावकः + "    public static string PathaPankti() { return Console.ReadLine() ?? \"\"; }\n";
    धावकः = धावकः + "    public static void StartRepl() {\n";
    धावकः = धावकः + "        try { Console.OutputEncoding = Encoding.UTF8; Console.InputEncoding = Encoding.UTF8; } catch { }\n";
    धावकः = धावकः + "        Console.WriteLine(\"==================================================\");\n";
    धावकः = धावकः + "        Console.WriteLine(\"प्रज्ञा (Prajna) v1.0.0 — संवादात्मक-आदेशफलकम् (Interactive REPL)\");\n";
    धावकः = धावकः + "        Console.WriteLine(\"संस्कृतभाषाधारिता स्वायत्ता सङ्गणकप्रणाली\");\n";
    धावकः = धावकः + "        Console.WriteLine(\"बहिर्गमनाय 'विराम;' / 'exit', साहाय्याय 'साहाय्यम्' लिखन्तु।\");\n";
    धावकः = धावकः + "        Console.WriteLine(\"==================================================\");\n";
    धावकः = धावकः + "        var sessionHistory = new List<string>();\n";
    धावकः = धावकः + "        string buffer = \"\";\n";
    धावकः = धावकः + "        int openBraces = 0;\n";
    धावकः = धावकः + "        while (true) {\n";
    धावकः = धावकः + "            if (openBraces > 0) Console.Write(\"प्रज्ञा ... \");\n";
    धावकः = धावकः + "            else Console.Write(\"प्रज्ञा >>> \");\n";
    धावकः = धावकः + "            string line = Console.ReadLine();\n";
    धावकः = धावकः + "            if (line == null) break;\n";
    धावकः = धावकः + "            string trimmed = line.Trim();\n";
    धावकः = धावकः + "            if (openBraces == 0 && (trimmed == \"विराम;\" || trimmed == \"विराम\" || trimmed == \"exit\" || trimmed == \"quit\")) {\n";
    धावकः = धावकः + "                Console.WriteLine(\"प्रज्ञा-आदेशफलकं समापितम्। शुभं भवतु!\");\n";
    धावकः = धावकः + "                break;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (openBraces == 0 && (trimmed == \"साहाय्यम्\" || trimmed == \"help\")) {\n";
    धावकः = धावकः + "                Console.WriteLine(\"क्रीडाङ्गणवत् प्रज्ञा-सङ्केतं लिखतु, उदा: चलम् x = २५; लिख x * २;\");\n";
    धावकः = धावकः + "                Console.WriteLine(\"बहिर्गमनाय 'विराम;' अथवा 'exit' इति लिखतु।\");\n";
    धावकः = धावकः + "                continue;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (openBraces == 0 && (trimmed == \"स्वच्छम्\" || trimmed == \"clear\")) {\n";
    धावकः = धावकः + "                Console.Clear();\n";
    धावकः = धावकः + "                continue;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            foreach (char ch in trimmed) {\n";
    धावकः = धावकः + "                if (ch == '{') openBraces++;\n";
    धावकः = धावकः + "                else if (ch == '}') openBraces = Math.Max(0, openBraces - 1);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            buffer += (buffer.Length > 0 ? \"\\n\" : \"\") + line;\n";
    धावकः = धावकः + "            if (openBraces > 0) continue;\n";
    धावकः = धावकः + "            string toExecute = buffer.Trim();\n";
    धावकः = धावकः + "            buffer = \"\";\n";
    धावकः = धावकः + "            if (string.IsNullOrWhiteSpace(toExecute)) continue;\n";
    धावकः = धावकः + "            try {\n";
    धावकः = धावकः + "                bool isDef = toExecute.StartsWith(\"चलम्\") || toExecute.StartsWith(\"स्थिरम्\") || toExecute.StartsWith(\"फलनम्\") || toExecute.Contains(\"=\");\n";
    धावकः = धावकः + "                string codeToRun = \"\";\n";
    धावकः = धावकः + "                if (sessionHistory.Count > 0) codeToRun = string.Join(\"\\n\", sessionHistory.ToArray()) + \"\\n\";\n";
    धावकः = धावकः + "                string exprRun = toExecute;\n";
    धावकः = धावकः + "                if (!exprRun.Contains(\";\") && !exprRun.Contains(\"{\") && !isDef && !exprRun.StartsWith(\"लिख\")) exprRun = \"लिख \" + exprRun + \";\";\n";
    धावकः = धावकः + "                codeToRun += exprRun;\n";
    धावकः = धावकः + "                NativeRunSource(codeToRun);\n";
    धावकः = धावकः + "                if (isDef) sessionHistory.Add(toExecute);\n";
    धावकः = धावकः + "            } catch (Exception ex) {\n";
    धावकः = धावकः + "                Console.WriteLine(\"[सञ्चालन-दोषः]: \" + ex.Message);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "    }\n";
धावकः = धावकः + "    public static long PatralekhakamArabhasva(object t, object init) {\n";
    धावकः = धावकः + "        Form f = new Form() { Text = t == null ? \"प्रज्ञा पत्रलेखकः\" : t.ToString(), Size = new Size(900, 650), StartPosition = FormStartPosition.CenterScreen };\n";
    धावकः = धावकः + "        TextBox tb = new TextBox() { Multiline = true, Dock = DockStyle.Fill, ScrollBars = ScrollBars.Both, Font = new Font(\"Nirmala UI\", 12F), Text = init == null ? \"\" : init.ToString() };\n";
    धावकः = धावकः + "        f.Controls.Add(tb);\n";
    धावकः = धावकः + "        Application.Run(f); return 1;\n";
    धावकः = धावकः + "    }\n";
    
    धावकः = धावकः + "    // ========================================================================\n";
    धावकः = धावकः + "    // Prajna Native Bytecode Engine & Stack Virtual Machine (Pure Native)\n";
    धावकः = धावकः + "    // Zero external dependencies. Zero external compiler or third-party runtime calls.\n";
    धावकः = धावकः + "    // ========================================================================\n";
    धावकः = धावकः + "    public enum ByteOp {\n";
    धावकः = धावकः + "        HALT = 0, LOAD_CONST = 1, LOAD_VAR = 2, STORE_VAR = 3,\n";
    धावकः = धावकः + "        ADD = 4, SUB = 5, MUL = 6, DIV = 7, MOD = 8,\n";
    धावकः = धावकः + "        CMP_EQ = 9, CMP_NE = 10, CMP_LT = 11, CMP_GT = 12, CMP_LE = 13, CMP_GE = 14,\n";
    धावकः = धावकः + "        LOGIC_AND = 15, LOGIC_OR = 16, LOGIC_NOT = 17,\n";
    धावकः = धावकः + "        JUMP = 18, JUMP_IF_FALSE = 19, PRINT = 20,\n";
    धावकः = धावकः + "        CALL = 21, DEF_FUNC = 22, RETURN = 23, POP = 24, BUILD_LIST = 25\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteInst {\n";
    धावकः = धावकः + "        public ByteOp Op; public object Arg;\n";
    धावकः = धावकः + "        public ByteInst(ByteOp op, object arg = null) { Op = op; Arg = arg; }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteProg {\n";
    धावकः = धावकः + "        public List<object> Constants = new List<object>();\n";
    धावकः = धावकः + "        public List<ByteInst> Instructions = new List<ByteInst>();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteToken {\n";
    धावकः = धावकः + "        public string Type; public string Value;\n";
    धावकः = धावकः + "        public ByteToken(string type, string val) { Type = type; Value = val; }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteLexer {\n";
    धावकः = धावकः + "        public static List<ByteToken> Tokenize(string source) {\n";
    धावकः = धावकः + "            var tokens = new List<ByteToken>();\n";
    धावकः = धावकः + "            int i = 0, len = source.Length;\n";
    धावकः = धावकः + "            while (i < len) {\n";
    धावकः = धावकः + "                char ch = source[i];\n";
    धावकः = धावकः + "                if (char.IsWhiteSpace(ch) || ch == '\\r' || ch == '\\n' || ch == '\\t') { i++; continue; }\n";
    धावकः = धावकः + "                if (ch == '/' && i + 1 < len && source[i + 1] == '/') {\n";
    धावकः = धावकः + "                    while (i < len && source[i] != '\\n') i++; continue;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                if (ch == '\"') {\n";
    धावकः = धावकः + "                    var sb = new StringBuilder(); i++;\n";
    धावकः = धावकः + "                    while (i < len && source[i] != '\"') {\n";
    धावकः = धावकः + "                        if (source[i] == '\\\\' && i + 1 < len) {\n";
    धावकः = धावकः + "                            i++;\n";
    धावकः = धावकः + "                            if (source[i] == 'n') sb.Append('\\n');\n";
    धावकः = धावकः + "                            else if (source[i] == 't') sb.Append('\\t');\n";
    धावकः = धावकः + "                            else sb.Append(source[i]);\n";
    धावकः = धावकः + "                        } else sb.Append(source[i]);\n";
    धावकः = धावकः + "                        i++;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    i++; tokens.Add(new ByteToken(\"STRING\", sb.ToString())); continue;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                if ((ch >= '०' && ch <= '९') || (ch >= '0' && ch <= '9')) {\n";
    धावकः = धावकः + "                    var sb = new StringBuilder(); bool isFloat = false;\n";
    धावकः = धावकः + "                    while (i < len && ((source[i] >= '०' && source[i] <= '९') || (source[i] >= '0' && source[i] <= '9') || source[i] == '.')) {\n";
    धावकः = धावकः + "                        if (source[i] == '.') { if (isFloat) break; isFloat = true; }\n";
    धावकः = धावकः + "                        sb.Append(source[i]); i++;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    tokens.Add(new ByteToken(\"NUMBER\", sb.ToString())); continue;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                if (i + 1 < len) {\n";
    धावकः = धावकः + "                    string two = source.Substring(i, 2);\n";
    धावकः = धावकः + "                    if (two == \">=\" || two == \"<=\" || two == \"==\" || two == \"!=\" || two == \"&&\" || two == \"||\") {\n";
    धावकः = धावकः + "                        tokens.Add(new ByteToken(\"PUNCT\", two)); i += 2; continue;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                if (\"(){}[];,+-*/%><=!&|\".IndexOf(ch) != -1) {\n";
    धावकः = धावकः + "                    tokens.Add(new ByteToken(\"PUNCT\", ch.ToString())); i++; continue;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                var ident = new StringBuilder();\n";
    धावकः = धावकः + "                while (i < len && !char.IsWhiteSpace(source[i]) && \"(){}[];,+-*/%><=!&|\\\"\\r\\n\\t\".IndexOf(source[i]) == -1) {\n";
    धावकः = धावकः + "                    ident.Append(source[i]); i++;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                if (ident.Length > 0) tokens.Add(new ByteToken(\"IDENT\", ident.ToString()));\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            return tokens;\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        public static double DevanagariToDouble(string s) {\n";
    धावकः = धावकः + "            var sb = new StringBuilder();\n";
    धावकः = धावकः + "            foreach (char ch in s) {\n";
    धावकः = धावकः + "                if (ch >= '०' && ch <= '९') sb.Append((char)('0' + (ch - '०')));\n";
    धावकः = धावकः + "                else sb.Append(ch);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            double v; double.TryParse(sb.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out v);\n";
    धावकः = धावकः + "            return v;\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteCompiler {\n";
    धावकः = धावकः + "        private List<ByteToken> tokens; private int pos = 0;\n";
    धावकः = धावकः + "        public ByteProg Prog = new ByteProg();\n";
    धावकः = धावकः + "        private Dictionary<string, int> constMap = new Dictionary<string, int>();\n";
    धावकः = धावकः + "        public ByteCompiler(List<ByteToken> tokList) { tokens = tokList; }\n";
    धावकः = धावकः + "        private ByteToken Peek() { return pos < tokens.Count ? tokens[pos] : null; }\n";
    धावकः = धावकः + "        private ByteToken Next() { return pos < tokens.Count ? tokens[pos++] : null; }\n";
    धावकः = धावकः + "        private bool Match(string val) { var tok = Peek(); if (tok != null && tok.Value == val) { pos++; return true; } return false; }\n";
    धावकः = धावकः + "        private ByteToken Expect(string val) { var tok = Peek(); if (tok != null && tok.Value == val) return Next(); throw new Exception(\"Expected '\" + val + \"' but got '\" + (tok != null ? tok.Value : \"EOF\") + \"'\"); }\n";
    धावकः = धावकः + "        private int AddConst(object val) { string key = val.GetType().Name + \":\" + val.ToString(); if (constMap.ContainsKey(key)) return constMap[key]; int idx = Prog.Constants.Count; Prog.Constants.Add(val); constMap[key] = idx; return idx; }\n";
    धावकः = धावकः + "        private int Emit(ByteOp op, object arg = null) { int addr = Prog.Instructions.Count; Prog.Instructions.Add(new ByteInst(op, arg)); return addr; }\n";
    धावकः = धावकः + "        public ByteProg Compile() { while (pos < tokens.Count) { CompileStatement(); } Emit(ByteOp.HALT); return Prog; }\n";
    धावकः = धावकः + "        private void CompileStatement() {\n";
    धावकः = धावकः + "            var tok = Peek(); if (tok == null) return;\n";
    धावकः = धावकः + "            if (tok.Value == \"चलम्\" || tok.Value == \"स्थिरम्\") {\n";
    धावकः = धावकः + "                Next(); string name = Next().Value;\n";
    धावकः = धावकः + "                if (Match(\"=\")) { CompileExpression(); Emit(ByteOp.STORE_VAR, name); }\n";
    धावकः = धावकः + "                else { int cIdx = AddConst(0L); Emit(ByteOp.LOAD_CONST, cIdx); Emit(ByteOp.STORE_VAR, name); }\n";
    धावकः = धावकः + "                Match(\";\"); return;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (tok.Value == \"लिख\") { Next(); CompileExpression(); Emit(ByteOp.PRINT); Match(\";\"); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"यदि\") { CompileIf(); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"यावत्\") { CompileWhile(); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"फलनम्\") { CompileFunction(); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"प्रत्यागच्छ\") {\n";
    धावकः = धावकः + "                Next(); if (Peek() != null && Peek().Value != \";\") CompileExpression();\n";
    धावकः = धावकः + "                else { int cIdx = AddConst(0L); Emit(ByteOp.LOAD_CONST, cIdx); }\n";
    धावकः = धावकः + "                Emit(ByteOp.RETURN); Match(\";\"); return;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (tok.Value == \"विराम\") { Next(); Emit(ByteOp.HALT); Match(\";\"); return; }\n";
    धावकः = धावकः + "            if (tok.Type == \"IDENT\" && pos + 1 < tokens.Count && tokens[pos + 1].Value == \"=\") {\n";
    धावकः = धावकः + "                string varName = Next().Value; Expect(\"=\"); CompileExpression(); Emit(ByteOp.STORE_VAR, varName); Match(\";\"); return;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            CompileExpression(); Emit(ByteOp.POP); Match(\";\");\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileIf() {\n";
    धावकः = धावकः + "            Expect(\"यदि\"); Expect(\"(\"); CompileExpression(); Expect(\")\");\n";
    धावकः = धावकः + "            int jumpFalseAddr = Emit(ByteOp.JUMP_IF_FALSE, 0); Expect(\"{\");\n";
    धावकः = धावकः + "            while (Peek() != null && Peek().Value != \"}\") { CompileStatement(); } Expect(\"}\");\n";
    धावकः = धावकः + "            var exitJumps = new List<int>(); exitJumps.Add(Emit(ByteOp.JUMP, 0));\n";
    धावकः = धावकः + "            Prog.Instructions[jumpFalseAddr].Arg = Prog.Instructions.Count;\n";
    धावकः = धावकः + "            while (Peek() != null && Peek().Value == \"अन्यथा\") {\n";
    धावकः = धावकः + "                Next();\n";
    धावकः = धावकः + "                if (Peek() != null && Peek().Value == \"यदि\") {\n";
    धावकः = धावकः + "                    Next(); Expect(\"(\"); CompileExpression(); Expect(\")\");\n";
    धावकः = धावकः + "                    int nextFalse = Emit(ByteOp.JUMP_IF_FALSE, 0); Expect(\"{\");\n";
    धावकः = धावकः + "                    while (Peek() != null && Peek().Value != \"}\") { CompileStatement(); } Expect(\"}\");\n";
    धावकः = धावकः + "                    exitJumps.Add(Emit(ByteOp.JUMP, 0)); Prog.Instructions[nextFalse].Arg = Prog.Instructions.Count;\n";
    धावकः = धावकः + "                } else {\n";
    धावकः = धावकः + "                    Expect(\"{\"); while (Peek() != null && Peek().Value != \"}\") { CompileStatement(); } Expect(\"}\"); break;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            foreach (var jmp in exitJumps) Prog.Instructions[jmp].Arg = Prog.Instructions.Count;\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileWhile() {\n";
    धावकः = धावकः + "            Expect(\"यावत्\"); int loopStart = Prog.Instructions.Count; Expect(\"(\"); CompileExpression(); Expect(\")\");\n";
    धावकः = धावकः + "            int exitJump = Emit(ByteOp.JUMP_IF_FALSE, 0); Expect(\"{\");\n";
    धावकः = धावकः + "            while (Peek() != null && Peek().Value != \"}\") { CompileStatement(); } Expect(\"}\");\n";
    धावकः = धावकः + "            Emit(ByteOp.JUMP, loopStart); Prog.Instructions[exitJump].Arg = Prog.Instructions.Count;\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileFunction() {\n";
    धावकः = धावकः + "            Expect(\"फलनम्\"); string fnName = Next().Value; Expect(\"(\");\n";
    धावकः = धावकः + "            var pList = new List<string>();\n";
    धावकः = धावकः + "            while (Peek() != null && Peek().Value != \")\") { pList.Add(Next().Value); Match(\",\"); }\n";
    धावकः = धावकः + "            Expect(\")\"); int jumpOver = Emit(ByteOp.JUMP, 0); int fnStart = Prog.Instructions.Count;\n";
    धावकः = धावकः + "            Expect(\"{\"); while (Peek() != null && Peek().Value != \"}\") { CompileStatement(); } Expect(\"}\");\n";
    धावकः = धावकः + "            int defConst = AddConst(0L); Emit(ByteOp.LOAD_CONST, defConst); Emit(ByteOp.RETURN);\n";
    धावकः = धावकः + "            Prog.Instructions[jumpOver].Arg = Prog.Instructions.Count;\n";
    धावकः = धावकः + "            Emit(ByteOp.DEF_FUNC, new object[] { fnName, pList, fnStart });\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileExpression() { CompileLogicalOr(); }\n";
    धावकः = धावकः + "        private void CompileLogicalOr() {\n";
    धावकः = धावकः + "            CompileLogicalAnd();\n";
    धावकः = धावकः + "            while (Peek() != null && (Peek().Value == \"वा\" || Peek().Value == \"||\")) { Next(); CompileLogicalAnd(); Emit(ByteOp.LOGIC_OR); }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileLogicalAnd() {\n";
    धावकः = धावकः + "            CompileComparison();\n";
    धावकः = धावकः + "            while (Peek() != null && (Peek().Value == \"तथा\" || Peek().Value == \"&&\")) { Next(); CompileComparison(); Emit(ByteOp.LOGIC_AND); }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileComparison() {\n";
    धावकः = धावकः + "            CompileAddition();\n";
    धावकः = धावकः + "            while (Peek() != null && (Peek().Value == \"==\" || Peek().Value == \"!=\" || Peek().Value == \"<\" || Peek().Value == \">\" || Peek().Value == \"<=\" || Peek().Value == \'>=\')) {\n";
    धावकः = धावकः + "                string op = Next().Value; CompileAddition();\n";
    धावकः = धावकः + "                if (op == \"==\") Emit(ByteOp.CMP_EQ); else if (op == \"!=\") Emit(ByteOp.CMP_NE);\n";
    धावकः = धावकः + "                else if (op == \"<\") Emit(ByteOp.CMP_LT); else if (op == \">\") Emit(ByteOp.CMP_GT);\n";
    धावकः = धावकः + "                else if (op == \"<=\") Emit(ByteOp.CMP_LE); else if (op == \'>=\') Emit(ByteOp.CMP_GE);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileAddition() {\n";
    धावकः = धावकः + "            CompileMultiplication();\n";
    धावकः = धावकः + "            while (Peek() != null && (Peek().Value == \"+\" || Peek().Value == \"-\")) {\n";
    धावकः = धावकः + "                string op = Next().Value; CompileMultiplication();\n";
    धावकः = धावकः + "                if (op == \"+\") Emit(ByteOp.ADD); else if (op == \"-\") Emit(ByteOp.SUB);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompileMultiplication() {\n";
    धावकः = धावकः + "            CompilePrimary();\n";
    धावकः = धावकः + "            while (Peek() != null && (Peek().Value == \"*\" || Peek().Value == \"/\" || Peek().Value == \"%\")) {\n";
    धावकः = धावकः + "                string op = Next().Value; CompilePrimary();\n";
    धावकः = धावकः + "                if (op == \"*\") Emit(ByteOp.MUL); else if (op == \"/\") Emit(ByteOp.DIV); else if (op == \"%\") Emit(ByteOp.MOD);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private void CompilePrimary() {\n";
    धावकः = धावकः + "            var tok = Next(); if (tok == null) throw new Exception(\"Unexpected EOF in expression\");\n";
    धावकः = धावकः + "            if (tok.Type == \"NUMBER\") { double val = ByteLexer.DevanagariToDouble(tok.Value); int idx = AddConst(val); Emit(ByteOp.LOAD_CONST, idx); return; }\n";
    धावकः = धावकः + "            if (tok.Type == \"STRING\") { int idx = AddConst(tok.Value); Emit(ByteOp.LOAD_CONST, idx); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"सत्यम्\") { int idx = AddConst(1L); Emit(ByteOp.LOAD_CONST, idx); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"असत्यम्\") { int idx = AddConst(0L); Emit(ByteOp.LOAD_CONST, idx); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"(\") { CompileExpression(); Expect(\")\"); return; }\n";
    धावकः = धावकः + "            if (tok.Value == \"[\") {\n";
    धावकः = धावकः + "                int count = 0; while (Peek() != null && Peek().Value != \"]\") { CompileExpression(); count++; Match(\",\"); }\n";
    धावकः = धावकः + "                Expect(\"]\"); Emit(ByteOp.BUILD_LIST, count); return;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (tok.Type == \"IDENT\") {\n";
    धावकः = धावकः + "                string name = tok.Value;\n";
    धावकः = धावकः + "                if (Match(\"(\")) {\n";
    धावकः = धावकः + "                    int argc = 0; while (Peek() != null && Peek().Value != \")\") { CompileExpression(); argc++; Match(\",\"); }\n";
    धावकः = धावकः + "                    Expect(\")\"); Emit(ByteOp.CALL, new object[] { name, argc }); return;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                Emit(ByteOp.LOAD_VAR, name); return;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            throw new Exception(\"Unexpected token: \" + tok.Value);\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public class ByteFunc { public string Name; public List<string> Params; public int StartAddr; }\n";
    धावकः = धावकः + "    public class ByteFrame { public int ReturnAddr; public Dictionary<string, object> Locals = new Dictionary<string, object>(); }\n";
    धावकः = धावकः + "    public class NativePrajnaVM {\n";
    धावकः = धावकः + "        public Stack<object> Stack = new Stack<object>();\n";
    धावकः = धावकः + "        public Dictionary<string, object> Globals = new Dictionary<string, object>();\n";
    धावकः = धावकः + "        public Dictionary<string, ByteFunc> Functions = new Dictionary<string, ByteFunc>();\n";
    धावकः = धावकः + "        public Stack<ByteFrame> CallStack = new Stack<ByteFrame>();\n";
    धावकः = धावकः + "        public int PC = 0;\n";
    धावकः = धावकः + "        public void Execute(ByteProg prog) {\n";
    धावकः = धावकः + "            PC = 0;\n";
    धावकः = धावकः + "            while (PC < prog.Instructions.Count) {\n";
    धावकः = धावकः + "                var inst = prog.Instructions[PC];\n";
    धावकः = धावकः + "                switch (inst.Op) {\n";
    धावकः = धावकः + "                    case ByteOp.LOAD_CONST: Stack.Push(prog.Constants[Convert.ToInt32(inst.Arg)]); break;\n";
    धावकः = धावकः + "                    case ByteOp.LOAD_VAR: {\n";
    धावकः = धावकः + "                        string name = (string)inst.Arg;\n";
    धावकः = धावकः + "                        if (CallStack.Count > 0 && CallStack.Peek().Locals.ContainsKey(name)) Stack.Push(CallStack.Peek().Locals[name]);\n";
    धावकः = धावकः + "                        else if (Globals.ContainsKey(name)) Stack.Push(Globals[name]);\n";
    धावकः = धावकः + "                        else Stack.Push(0L); break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.STORE_VAR: {\n";
    धावकः = धावकः + "                        string name = (string)inst.Arg;\n";
    धावकः = धावकः + "                        object val = Stack.Count > 0 ? Stack.Pop() : null;\n";
    धावकः = धावकः + "                        if (CallStack.Count > 0) CallStack.Peek().Locals[name] = val;\n";
    धावकः = धावकः + "                        else Globals[name] = val; break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.ADD: {\n";
    धावकः = धावकः + "                        var b = Stack.Pop(); var a = Stack.Pop();\n";
    धावकः = धावकः + "                        if (a is string || b is string) Stack.Push(PrajnaRuntime.Format(a) + PrajnaRuntime.Format(b));\n";
    धावकः = धावकः + "                        else Stack.Push(Convert.ToDouble(a) + Convert.ToDouble(b)); break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.SUB: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a - b); break; }\n";
    धावकः = धावकः + "                    case ByteOp.MUL: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a * b); break; }\n";
    धावकः = धावकः + "                    case ByteOp.DIV: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(b != 0 ? a / b : 0); break; }\n";
    धावकः = धावकः + "                    case ByteOp.MOD: { var b = Convert.ToInt64(Stack.Pop()); var a = Convert.ToInt64(Stack.Pop()); Stack.Push(b != 0 ? a % b : 0); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_EQ: { var b = Stack.Pop(); var a = Stack.Pop(); bool eq = a == null ? b == null : a.Equals(b); Stack.Push(eq ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_NE: { var b = Stack.Pop(); var a = Stack.Pop(); bool eq = a == null ? b == null : a.Equals(b); Stack.Push(!eq ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_LT: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a < b ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_GT: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a > b ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_LE: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a <= b ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.CMP_GE: { var b = Convert.ToDouble(Stack.Pop()); var a = Convert.ToDouble(Stack.Pop()); Stack.Push(a >= b ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.LOGIC_AND: { var b = Convert.ToInt64(Stack.Pop()); var a = Convert.ToInt64(Stack.Pop()); Stack.Push((a != 0 && b != 0) ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.LOGIC_OR: { var b = Convert.ToInt64(Stack.Pop()); var a = Convert.ToInt64(Stack.Pop()); Stack.Push((a != 0 || b != 0) ? 1L : 0L); break; }\n";
    धावकः = धावकः + "                    case ByteOp.JUMP: PC = Convert.ToInt32(inst.Arg) - 1; break;\n";
    धावकः = धावकः + "                    case ByteOp.JUMP_IF_FALSE: { var cond = Convert.ToInt64(Stack.Pop()); if (cond == 0) PC = Convert.ToInt32(inst.Arg) - 1; break; }\n";
    धावकः = धावकः + "                    case ByteOp.PRINT: { var val = Stack.Count > 0 ? Stack.Pop() : \"\"; Likha(val); break; }\n";
    धावकः = धावकः + "                    case ByteOp.POP: if (Stack.Count > 0) Stack.Pop(); break;\n";
    धावकः = धावकः + "                    case ByteOp.BUILD_LIST: { int count = Convert.ToInt32(inst.Arg); var list = new List<object>(); for (int j = 0; j < count; j++) list.Insert(0, Stack.Pop()); Stack.Push(list); break; }\n";
    धावकः = धावकः + "                    case ByteOp.DEF_FUNC: {\n";
    धावकः = धावकः + "                        var tuple = (object[])inst.Arg; string fnName = (string)tuple[0]; var pList = (List<string>)tuple[1]; int sAddr = Convert.ToInt32(tuple[2]);\n";
    धावकः = धावकः + "                        Functions[fnName] = new ByteFunc { Name = fnName, Params = pList, StartAddr = sAddr }; break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.CALL: {\n";
    धावकः = धावकः + "                        var tuple = (object[])inst.Arg; string fnName = (string)tuple[0]; int argc = Convert.ToInt32(tuple[1]);\n";
    धावकः = धावकः + "                        var args = new List<object>(); for (int j = 0; j < argc; j++) args.Insert(0, Stack.Pop());\n";
    धावकः = धावकः + "                        if (Functions.ContainsKey(fnName)) {\n";
    धावकः = धावकः + "                            var uf = Functions[fnName]; var frame = new ByteFrame { ReturnAddr = PC };\n";
    धावकः = धावकः + "                            for (int j = 0; j < uf.Params.Count; j++) frame.Locals[uf.Params[j]] = j < args.Count ? args[j] : null;\n";
    धावकः = धावकः + "                            CallStack.Push(frame); PC = uf.StartAddr - 1;\n";
    धावकः = धावकः + "                        } else { object res = DispatchNative(fnName, args); Stack.Push(res); }\n";
    धावकः = धावकः + "                        break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.RETURN: {\n";
    धावकः = धावकः + "                        object retVal = Stack.Count > 0 ? Stack.Pop() : 0L;\n";
    धावकः = धावकः + "                        if (CallStack.Count > 0) { var frame = CallStack.Pop(); PC = frame.ReturnAddr; }\n";
    धावकः = धावकः + "                        Stack.Push(retVal); break;\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    case ByteOp.HALT: return;\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "                PC++;\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        private object DispatchNative(string name, List<object> args) {\n";
    धावकः = धावकः + "            switch (name) {\n";
    धावकः = धावकः + "                case \"सूची_रचय\": return new List<object>();\n";
    धावकः = धावकः + "                case \"सूची_योजय\": ((List<object>)args[0]).Add(args[1]); return null;\n";
    धावकः = धावकः + "                case \"सूची_प्राप्नु\": return ((List<object>)args[0])[Convert.ToInt32(args[1])];\n";
    धावकः = धावकः + "                case \"सूची_स्थापय\": ((List<object>)args[0])[Convert.ToInt32(args[1])] = args[2]; return null;\n";
    धावकः = धावकः + "                case \"सूची_दीर्घता\": return (long)((List<object>)args[0]).Count;\n";
    धावकः = धावकः + "                case \"सूची_निष्कासय\": ((List<object>)args[0]).RemoveAt(Convert.ToInt32(args[1])); return null;\n";
    धावकः = धावकः + "                case \"कोष_रचय\": return new Dictionary<string, object>();\n";
    धावकः = धावकः + "                case \"कोष_स्थापय\": ((Dictionary<string, object>)args[0])[args[1].ToString()] = args[2]; return null;\n";
    धावकः = धावकः + "                case \"कोष_प्राप्नु\": { var d = (Dictionary<string, object>)args[0]; string k = args[1].ToString(); return d.ContainsKey(k) ? d[k] : 0L; }\n";
    धावकः = धावकः + "                case \"कोष_कुञ्चिका_विद्यते\": return ((Dictionary<string, object>)args[0]).ContainsKey(args[1].ToString());\n";
    धावकः = धावकः + "                case \"समुच्चय_रचय\": return new HashSet<object>();\n";
    धावकः = धावकः + "                case \"समुच्चय_योजय\": ((HashSet<object>)args[0]).Add(args[1]); return null;\n";
    धावकः = धावकः + "                case \"समुच्चय_विद्यते\": return ((HashSet<object>)args[0]).Contains(args[1]);\n";
    धावकः = धावकः + "                case \"समुच्चय_दीर्घता\": return (long)((HashSet<object>)args[0]).Count;\n";
    धावकः = धावकः + "                case \"सूत्र_दीर्घता\": return (long)(args[0] != null ? args[0].ToString().Length : 0);\n";
    धावकः = धावकः + "                case \"सूत्र_परिवर्तय\": return PrajnaRuntime.Format(args[0]);\n";
    धावकः = धावकः + "                case \"संख्या_परिवर्तय\": return DevanagariToInt(args[0] != null ? args[0].ToString() : \"\");\n";
    धावकः = धावकः + "                case \"वर्ण_प्राप्नु\": { string s = args[0] != null ? args[0].ToString() : \"\"; int idx = Convert.ToInt32(args[1]); return (idx >= 0 && idx < s.Length) ? s[idx].ToString() : \"\"; }\n";
    धावकः = धावकः + "                case \"गणित_वर्गमूलम्\": return Math.Sqrt(Convert.ToDouble(args[0]));\n";
    धावकः = धावकः + "                case \"गणित_घातः\": return Math.Pow(Convert.ToDouble(args[0]), Convert.ToDouble(args[1]));\n";
    धावकः = धावकः + "                case \"गणित_निरपेक्षम्\": return Math.Abs(Convert.ToDouble(args[0]));\n";
    धावकः = धावकः + "                case \"गणित_न्यूनतमम्\": return Math.Min(Convert.ToDouble(args[0]), Convert.ToDouble(args[1]));\n";
    धावकः = धावकः + "                case \"गणित_अधिकतमम्\": return Math.Max(Convert.ToDouble(args[0]), Convert.ToDouble(args[1]));\n";
    धावकः = धावकः + "                case \"व्यूह_रचय\": return PrajnaMatrix.Rachaya(Convert.ToInt32(args[0]), Convert.ToInt32(args[1]), (List<object>)args[2]);\n";
    धावकः = धावकः + "                case \"व्यूह_प्राप्नु\": return PrajnaMatrix.Praptnu(args[0], Convert.ToInt32(args[1]), Convert.ToInt32(args[2]));\n";
    धावकः = धावकः + "                case \"व्यूह_स्थापय\": PrajnaMatrix.Sthapaya(args[0], Convert.ToInt32(args[1]), Convert.ToInt32(args[2]), args[3]); return null;\n";
    धावकः = धावकः + "                case \"व्यूह_पङ्क्तयः\": return (long)PrajnaMatrix.Panktayah(args[0]);\n";
    धावकः = धावकः + "                case \"व्यूह_स्तम्भाः\": return (long)PrajnaMatrix.Stambhah(args[0]);\n";
    धावकः = धावकः + "                case \"व्यूह_गुणनम्\": return PrajnaMatrix.Gunanam(args[0], args[1]);\n";
    धावकः = धावकः + "                case \"व्यूह_परिवर्तः\": return PrajnaMatrix.Parivartah(args[0]);\n";
    धावकः = धावकः + "                case \"सदिश_अदिशगुणनम्\": return PrajnaMatrix.SadishaAdishagunanam(args[0], args[1]);\n";
    धावकः = धावकः + "                case \"तालिका_रचय\": return PrajnaDataFrame.Rachaya((List<object>)args[0]);\n";
    धावकः = धावकः + "                case \"तालिका_पङ्क्ति_योजय\": PrajnaDataFrame.PanktiYojaya(args[0], (List<object>)args[1]); return null;\n";
    धावकः = धावकः + "                case \"तालिका_स्तम्भ_प्राप्नु\": return PrajnaDataFrame.StambhaPraptnu(args[0], args[1].ToString());\n";
    धावकः = धावकः + "                case \"तालिका_संक्षेपः\": return PrajnaDataFrame.Samkshepah(args[0]);\n";
    धावकः = धावकः + "                case \"दत्त_पठ_csv\": return PrajnaDataFrame.PathaCsv(args[0].ToString());\n";
    धावकः = धावकः + "                case \"दत्त_लिख_csv\": PrajnaDataFrame.LikhaCsv(args[0].ToString(), args[1]); return null;\n";
    धावकः = धावकः + "                case \"सांख्यिकी_माध्यम्\": return SankhyikiMadhyamam(args[0]);\n";
    धावकः = धावकः + "                case \"सांख्यिकी_मध्यिका\": return SankhyikiMadhyika(args[0]);\n";
    धावकः = धावकः + "                case \"सांख्यिकी_विचरणम्\": return SankhyikiVicharanam(args[0]);\n";
    धावकः = धावकः + "                case \"सांख्यिकी_प्रमाणविचलनम्\": return SankhyikiPramanavichalanam(args[0]);\n";
    धावकः = धावकः + "                case \"सांख्यिकी_सहसम्बन्धः\": return SankhyikiSahasambandhah(args[0], args[1]);\n";
    धावकः = धावकः + "                case \"सांख्यिकी_समाश्रयणम्\": return SankhyikiSamashrayanam(args[0], args[1]);\n";
    धावकः = धावकः + "                case \"आदेशतर्काः\": return new List<object>(CommandLineArgs);\n";
    धावकः = धावकः + "                case \"प्रणाली_सञ्चालकः\": return Environment.OSVersion.Platform == PlatformID.Win32NT ? \"windows\" : \"unix\";\n";
    धावकः = धावकः + "                case \"सञ्चिका_पठ\": return File.ReadAllText(args[0].ToString(), Encoding.UTF8);\n";
    धावकः = धावकः + "                case \"सञ्चिका_लिख\": File.WriteAllText(args[0].ToString(), args[1].ToString(), Encoding.UTF8); return null;\n";
    धावकः = धावकः + "                case \"सञ्चिका_विद्यते\": return File.Exists(args[0].ToString());\n";
    धावकः = धावकः + "                case \"समयः_प्राप्नु\": return (double)DateTime.UtcNow.Ticks / TimeSpan.TicksPerMillisecond;\n";
    धावकः = धावकः + "                default: throw new Exception(\"अज्ञातम् अन्तर्निर्मित-फलनम्: \" + name);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string NativeCompileToBytecode(string source) {\n";
    धावकः = धावकः + "        var toks = ByteLexer.Tokenize(source); var comp = new ByteCompiler(toks); var prog = comp.Compile(); return SerializeProg(prog);\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static void NativeRunBytecode(string serialized) {\n";
    धावकः = धावकः + "        var prog = DeserializeProg(serialized); var vm = new NativePrajnaVM(); vm.Execute(prog);\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static void NativeRunSource(string source) {\n";
    धावकः = धावकः + "        var toks = ByteLexer.Tokenize(source); var comp = new ByteCompiler(toks); var prog = comp.Compile(); var vm = new NativePrajnaVM(); vm.Execute(prog);\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static bool NativeBuildStandalone(string source, string targetExe) {\n";
    धावकः = धावकः + "        try {\n";
    धावकः = धावकः + "            string currentExe = System.Diagnostics.Process.GetCurrentProcess().MainModule.FileName;\n";
    धावकः = धावकः + "            byte[] exeBytes = File.ReadAllBytes(currentExe);\n";
    धावकः = धावकः + "            string bytecode = NativeCompileToBytecode(source);\n";
    धावकः = धावकः + "            byte[] marker = Encoding.UTF8.GetBytes(\"\\n===PRAJNA_BYTECODE_PAYLOAD===\\n\");\n";
    धावकः = धावकः + "            byte[] payload = Encoding.UTF8.GetBytes(bytecode);\n";
    धावकः = धावकः + "            using (var fs = new FileStream(targetExe, FileMode.Create, FileAccess.Write)) {\n";
    धावकः = धावकः + "                fs.Write(exeBytes, 0, exeBytes.Length);\n";
    धावकः = धावकः + "                fs.Write(marker, 0, marker.Length);\n";
    धावकः = धावकः + "                fs.Write(payload, 0, payload.Length);\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            return true;\n";
    धावकः = धावकः + "        } catch { return false; }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static bool HasEmbeddedPayload(string exePath) {\n";
    धावकः = धावकः + "        try {\n";
    धावकः = धावकः + "            byte[] bytes = File.ReadAllBytes(exePath);\n";
    धावकः = धावकः + "            byte[] marker = Encoding.UTF8.GetBytes(\"\\n===PRAJNA_BYTECODE_PAYLOAD===\\n\");\n";
    धावकः = धावकः + "            return IndexOfBytes(bytes, marker) != -1;\n";
    धावकः = धावकः + "        } catch { return false; }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static void RunEmbeddedPayload(string exePath) {\n";
    धावकः = धावकः + "        byte[] bytes = File.ReadAllBytes(exePath);\n";
    धावकः = धावकः + "        byte[] marker = Encoding.UTF8.GetBytes(\"\\n===PRAJNA_BYTECODE_PAYLOAD===\\n\");\n";
    धावकः = धावकः + "        int idx = IndexOfBytes(bytes, marker);\n";
    धावकः = धावकः + "        if (idx != -1) {\n";
    धावकः = धावकः + "            int start = idx + marker.Length;\n";
    धावकः = धावकः + "            string bytecode = Encoding.UTF8.GetString(bytes, start, bytes.Length - start);\n";
    धावकः = धावकः + "            NativeRunBytecode(bytecode);\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    private static int IndexOfBytes(byte[] source, byte[] pattern) {\n";
    धावकः = धावकः + "        for (int i = 0; i <= source.Length - pattern.Length; i++) {\n";
    धावकः = धावकः + "            bool match = true;\n";
    धावकः = धावकः + "            for (int j = 0; j < pattern.Length; j++) {\n";
    धावकः = धावकः + "                if (source[i + j] != pattern[j]) { match = false; break; }\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            if (match) return i;\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        return -1;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string SerializeProg(ByteProg prog) {\n";
    धावकः = धावकः + "        var sb = new StringBuilder();\n";
    धावकः = धावकः + "        sb.Append(\"PRJN_BYTECODE_V1\\nCONSTANTS\\n\");\n";
    धावकः = धावकः + "        sb.Append(prog.Constants.Count).Append(\"\\n\");\n";
    धावकः = धावकः + "        foreach (var c in prog.Constants) {\n";
    धावकः = धावकः + "            if (c is string) sb.Append(\"S:\").Append(Convert.ToBase64String(Encoding.UTF8.GetBytes((string)c))).Append(\"\\n\");\n";
    धावकः = धावकः + "            else if (c is double || c is float) sb.Append(\"F:\").Append(((double)c).ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(\"\\n\");\n";
    धावकः = धावकः + "            else sb.Append(\"I:\").Append(Convert.ToInt64(c)).Append(\"\\n\");\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        sb.Append(\"INSTRUCTIONS\\n\");\n";
    धावकः = धावकः + "        sb.Append(prog.Instructions.Count).Append(\"\\n\");\n";
    धावकः = धावकः + "        foreach (var inst in prog.Instructions) {\n";
    धावकः = धावकः + "            sb.Append((int)inst.Op).Append(\":\");\n";
    धावकः = धावकः + "            if (inst.Arg == null) sb.Append(\"null\");\n";
    धावकः = धावकः + "            else if (inst.Arg is object[]) {\n";
    धावकः = धावकः + "                var arr = (object[])inst.Arg; sb.Append(\"ARR:\");\n";
    धावकः = धावकः + "                for (int j = 0; j < arr.Length; j++) {\n";
    धावकः = धावकः + "                    if (arr[j] is List<string>) {\n";
    धावकः = धावकः + "                        var sl = (List<string>)arr[j]; sb.Append(\"LIST(\").Append(string.Join(\",\", sl.ToArray())).Append(\")\");\n";
    धावकः = धावकः + "                    } else sb.Append(arr[j].ToString());\n";
    धावकः = धावकः + "                    if (j < arr.Length - 1) sb.Append(\"|\");\n";
    धावकः = धावकः + "                }\n";
    धावकः = धावकः + "            } else sb.Append(inst.Arg.ToString());\n";
    धावकः = धावकः + "            sb.Append(\"\\n\");\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        return sb.ToString();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static ByteProg DeserializeProg(string text) {\n";
    धावकः = धावकः + "        var prog = new ByteProg();\n";
    धावकः = धावकः + "        var lines = text.Split(new[] { '\\r', '\\n' }, StringSplitOptions.RemoveEmptyEntries);\n";
    धावकः = धावकः + "        int i = 0;\n";
    धावकः = धावकः + "        if (i < lines.Length && lines[i].StartsWith(\"PRJN_BYTECODE\")) i++;\n";
    धावकः = धावकः + "        if (i < lines.Length && lines[i] == \"CONSTANTS\") i++;\n";
    धावकः = धावकः + "        int constCount = Convert.ToInt32(lines[i++]);\n";
    धावकः = धावकः + "        for (int c = 0; c < constCount; c++) {\n";
    धावकः = धावकः + "            string line = lines[i++];\n";
    धावकः = धावकः + "            if (line.StartsWith(\"S:\")) { byte[] b = Convert.FromBase64String(line.Substring(2)); prog.Constants.Add(Encoding.UTF8.GetString(b)); }\n";
    धावकः = धावकः + "            else if (line.StartsWith(\"F:\")) prog.Constants.Add(double.Parse(line.Substring(2), System.Globalization.CultureInfo.InvariantCulture));\n";
    धावकः = धावकः + "            else if (line.StartsWith(\"I:\")) prog.Constants.Add(long.Parse(line.Substring(2)));\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        if (i < lines.Length && lines[i] == \"INSTRUCTIONS\") i++;\n";
    धावकः = धावकः + "        int instCount = Convert.ToInt32(lines[i++]);\n";
    धावकः = धावकः + "        for (int c = 0; c < instCount; c++) {\n";
    धावकः = धावकः + "            string line = lines[i++];\n";
    धावकः = धावकः + "            int colon = line.IndexOf(':');\n";
    धावकः = धावकः + "            ByteOp op = (ByteOp)int.Parse(line.Substring(0, colon));\n";
    धावकः = धावकः + "            string argStr = line.Substring(colon + 1);\n";
    धावकः = धावकः + "            object arg = null;\n";
    धावकः = धावकः + "            if (argStr != \"null\") {\n";
    धावकः = धावकः + "                if (argStr.StartsWith(\"ARR:\")) {\n";
    धावकः = धावकः + "                    var parts = argStr.Substring(4).Split('|'); var list = new List<object>();\n";
    धावकः = धावकः + "                    foreach (var p in parts) {\n";
    धावकः = धावकः + "                        if (p.StartsWith(\"LIST(\")) {\n";
    धावकः = धावकः + "                            var inner = p.Substring(5, p.Length - 6); var sl = new List<string>(inner.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)); list.Add(sl);\n";
    धावकः = धावकः + "                        } else { int v; if (int.TryParse(p, out v)) list.Add(v); else list.Add(p); }\n";
    धावकः = धावकः + "                    }\n";
    धावकः = धावकः + "                    arg = list.ToArray();\n";
    धावकः = धावकः + "                } else { int v; if (int.TryParse(argStr, out v)) arg = v; else arg = argStr; }\n";
    धावकः = धावकः + "            }\n";
    धावकः = धावकः + "            prog.Instructions.Add(new ByteInst(op, arg));\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        return prog;\n";
    धावकः = धावकः + "    }\n";
