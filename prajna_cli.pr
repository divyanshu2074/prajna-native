// ============================================================================
// प्रज्ञा (Prajna) — नियन्त्रण-साधनम् (CLI Tool in Pure Prajna)
// सञ्चिका: prajna/prajna_cli.pr
// ============================================================================

फलनम् साहाय्यम्_दर्शय() {
    लिख "==================================================";
    लिख "प्रज्ञा (Prajna) — संस्कृतभाषाधारिता स्वायत्ता सङ्गणकप्रणाली";
    लिख "नियन्त्रण-साधनम् (Prajna Native CLI)";
    लिख "==================================================";
    लिख "उपयोगः:";
    लिख "  prajna run <सञ्चिका.pr>                    (प्रोग्रामस्य सञ्चालनम्)";
    लिख "  prajna compile <सञ्चिका.pr> [-o <नाम.exe>] (बाइनरी-सङ्कलनम्)";
    लिख "  prajna version                            (संस्करण-प्रदर्शनम्)";
    लिख "  prajna help                               (साहाय्य-प्रदर्शनम्)";
}

फलनम् संस्करणम्_दर्शय() {
    लिख "प्रज्ञा (Prajna) v1.0.0 — संस्कृतभाषाधारिता स्वायत्तसङ्गणकप्रणाली";
    लिख "Python-निरपेक्षम् स्वयम्भू-निष्पादनतन्त्रम्";
    लिख "सर्वाधिकारः सुरक्षिताः © २०२६";
}

फलनम् मुख्य_नियन्त्रणम्() {
    चलम् तर्काः = आदेशतर्काः();
    चलम् दी = सूची_दीर्घता(तर्काः);

    यदि (दी == ० वा सूची_प्राप्नु(तर्काः, ०) == "help" वा सूची_प्राप्नु(तर्काः, ०) == "--help" वा सूची_प्राप्नु(तर्काः, ०) == "-h") {
        साहाय्यम्_दर्शय();
        प्रत्यागच्छ ०;
    }

    चलम् आदेशः = सूची_प्राप्नु(तर्काः, ०);

    यदि (आदेशः == "version" वा आदेशः == "--version" वा आदेशः == "-v") {
        संस्करणम्_दर्शय();
        प्रत्यागच्छ ०;
    }

    यदि (आदेशः == "run") {
        यदि (दी < २) {
            लिख "[दोषः] स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् सञ्चिका = सूची_प्राप्नु(तर्काः, १);
        लिख "प्रज्ञा-प्रोग्रामः सञ्चाल्यते: " + सञ्चिका;
        प्रत्यागच्छ ०;
    }

    यदि (आदेशः == "compile") {
        यदि (दी < २) {
            लिख "[दोषः] स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् सञ्चिका = सूची_प्राप्नु(तर्काः, १);
        लिख "प्रज्ञा-प्रोग्रामः सङ्कल्यते: " + सञ्चिका;
        प्रत्यागच्छ ०;
    }

    लिख "[अज्ञातः आदेशः] " + आदेशः;
    साहाय्यम्_दर्शय();
    प्रत्यागच्छ १;
}

मुख्य_नियन्त्रणम्();
