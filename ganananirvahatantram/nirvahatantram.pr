// ============================================================================
// प्रज्ञा (Prajna) — गणनानिर्वाहकाष्ठकम् (IR Virtual Machine Runtime)
// सञ्चिका: prajna/ganananirvahatantram/nirvahatantram.pr
// ============================================================================

फलनम् निर्वाहक_रचय() {
    चलम् तन्त्रम् = कोष_रचय();
    कोष_स्थापय(तन्त्रम्, "स्मृतिः", कोष_रचय());
    कोष_स्थापय(तन्त्रम्, "चितिः", सूची_रचय()); // Evaluation stack
    प्रत्यागच्छ तन्त्रम्;
}

फलनम् चिति_क्षिपु(तन्त्रम्, मूल्यम्) {
    चलम् चिति = कोष_प्राप्नु(तन्त्रम्, "चितिः");
    सूची_योजय(चिति, मूल्यम्);
}

फलनम् चिति_निर्गच्छ(तन्त्रम्) {
    चलम् चिति = कोष_प्राप्नु(तन्त्रम्, "चितिः");
    चलम् दी = सूची_दीर्घता(चिति);
    यदि (दी == ०) {
        प्रत्यागच्छ ०;
    }
    चलम् मूल्यम् = सूची_प्राप्नु(चिति, दी - १);
    सूची_निष्कासय(चिति, दी - १);
    प्रत्यागच्छ मूल्यम्;
}

// आईआर-निर्देश-निष्पादनम्
फलनम् आईआर_निष्पादय_सूची(तन्त्रम्, निर्देश_सूची) {
    चलम् दी = सूची_दीर्घता(निर्देश_सूची);
    चलम् सूचकः = ०;
    चलम् स्मृतिः = कोष_प्राप्नु(तन्त्रम्, "स्मृतिः");

    यावत् (सूचकः < दी) {
        चलम् नि = सूची_प्राप्नु(निर्देश_सूची, सूचकः);
        चलम् प्र = कोष_प्राप्नु(नि, "प्रकारः");
        चलम् त१ = कोष_प्राप्नु(नि, "तर्क१");

        यदि (प्र == "LOAD_CONST") {
            चिति_क्षिपु(तन्त्रम्, त१);
        }
        अन्यथा यदि (प्र == "LOAD_VAR") {
            चलम् मू = ०;
            यदि (कोष_अस्ति(स्मृतिः, त१)) {
                मू = कोष_प्राप्नु(स्मृतिः, त१);
            }
            चिति_क्षिपु(तन्त्रम्, मू);
        }
        अन्यथा यदि (प्र == "STORE_VAR") {
            चलम् मू = चिति_निर्गच्छ(तन्त्रम्);
            कोष_स्थापय(स्मृतिः, त१, मू);
        }
        अन्यथा यदि (प्र == "ADD") {
            चलम् ख = चिति_निर्गच्छ(तन्त्रम्);
            चलम् क = चिति_निर्गच्छ(तन्त्रम्);
            चिति_क्षिपु(तन्त्रम्, क + ख);
        }
        अन्यथा यदि (प्र == "SUB") {
            चलम् ख = चिति_निर्गच्छ(तन्त्रम्);
            चलम् क = चिति_निर्गच्छ(तन्त्रम्);
            चिति_क्षिपु(तन्त्रम्, क - ख);
        }
        अन्यथा यदि (प्र == "MUL") {
            चलम् ख = चिति_निर्गच्छ(तन्त्रम्);
            चलम् क = चिति_निर्गच्छ(तन्त्रम्);
            चिति_क्षिपु(तन्त्रम्, क * ख);
        }
        अन्यथा यदि (प्र == "DIV") {
            चलम् ख = चिति_निर्गच्छ(तन्त्रम्);
            चलम् क = चिति_निर्गच्छ(तन्त्रम्);
            चिति_क्षिपु(तन्त्रम्, क / ख);
        }
        अन्यथा यदि (प्र == "PRINT") {
            चलम् मू = चिति_निर्गच्छ(तन्त्रम्);
            लिख मू;
        }

        सूचकः = सूचकः + १;
    }
}

// गणनानिर्वाहक-परीक्षणम् (Self-test)
फलनम् गणनानिर्वाहक_परीक्षणम्() {
    लिख "--- [परीक्षणम्: गणनानिर्वाहक-तन्त्रम्] ---";
    चलम् तन्त्रम् = निर्वाहक_रचय();

    // निर्देशाः: LOAD_CONST 10, LOAD_CONST 20, ADD, STORE_VAR 'क', LOAD_VAR 'क', PRINT
    चलम् निर्देशाः = सूची_रचय();

    चलम् नि१ = कोष_रचय(); कोष_स्थापय(नि१, "प्रकारः", "LOAD_CONST"); कोष_स्थापय(नि१, "तर्क१", १०); सूची_योजय(निर्देशाः, नि१);
    चलम् नि२ = कोष_रचय(); कोष_स्थापय(नि२, "प्रकारः", "LOAD_CONST"); कोष_स्थापय(नि२, "तर्क१", २०); सूची_योजय(निर्देशाः, नि२);
    चलम् नि३ = कोष_रचय(); कोष_स्थापय(नि३, "प्रकारः", "ADD"); कोष_स्थापय(नि३, "तर्क१", ०); सूची_योजय(निर्देशाः, नि३);
    चलम् नि४ = कोष_रचय(); कोष_स्थापय(नि४, "प्रकारः", "STORE_VAR"); कोष_स्थापय(नि४, "तर्क१", "क"); सूची_योजय(निर्देशाः, नि४);
    चलम् नि५ = कोष_रचय(); कोष_स्थापय(नि५, "प्रकारः", "LOAD_VAR"); कोष_स्थापय(नि५, "तर्क१", "क"); सूची_योजय(निर्देशाः, नि५);
    चलम् नि६ = कोष_रचय(); कोष_स्थापय(नि६, "प्रकारः", "PRINT"); कोष_स्थापय(नि६, "तर्क१", ०); सूची_योजय(निर्देशाः, नि६);

    लिख "निष्पादन-परिणामः:";
    आईआर_निष्पादय_सूची(तन्त्रम्, निर्देशाः);
    लिख "गणनानिर्वाहक-परीक्षणं सम्पूर्णम्!\n";
}

गणनानिर्वाहक_परीक्षणम्();
