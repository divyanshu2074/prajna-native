// प्रज्ञा (Prajna) — स्वयम्भू-सङ्कलकः (Self-Hosted Prajna Compiler)
// अयम् सङ्कलकः सम्पूर्णतया प्रज्ञा-भाषायां लिखितः अस्ति।
// अनेन प्रज्ञा-सङ्गणकप्रणाली सर्वात्मना स्वायत्ता स्वयम्भू-प्रणाली भूत्वा
// स्वयमेव प्रज्ञा-स्रोतःसङ्केतान् सङ्कलयति निष्पादयति च।
// ============================================================================

फलनम् देवनागरी_अङ्कम्(वर्णः) {
    यदि (वर्णः == "०" वा वर्णः == "१" वा वर्णः == "२" वा वर्णः == "३" वा वर्णः == "४" वा
         वर्णः == "५" वा वर्णः == "६" वा वर्णः == "७" वा वर्णः == "८" वा वर्णः == "९") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् आङ्ग्ल_अङ्कम्(वर्णः) {
    यदि (वर्णः == "0" वा वर्णः == "1" वा वर्णः == "2" वा वर्णः == "3" वा वर्णः == "4" वा
         वर्णः == "5" वा वर्णः == "6" वा वर्णः == "7" वा वर्णः == "8" वा वर्णः == "9") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् अङ्क_परिवर्तनम्(वर्णः) {
    यदि (वर्णः == "०") { प्रत्यागच्छ "0"; }
    यदि (वर्णः == "१") { प्रत्यागच्छ "1"; }
    यदि (वर्णः == "२") { प्रत्यागच्छ "2"; }
    यदि (वर्णः == "३") { प्रत्यागच्छ "3"; }
    यदि (वर्णः == "४") { प्रत्यागच्छ "4"; }
    यदि (वर्णः == "५") { प्रत्यागच्छ "5"; }
    यदि (वर्णः == "६") { प्रत्यागच्छ "6"; }
    यदि (वर्णः == "७") { प्रत्यागच्छ "7"; }
    यदि (वर्णः == "८") { प्रत्यागच्छ "8"; }
    यदि (वर्णः == "९") { प्रत्यागच्छ "9"; }
    प्रत्यागच्छ वर्णः;
}

फलनम् रिक्तस्थानम्_अस्ति(वर्णः) {
    यदि (वर्णः == " " वा वर्णः == "\t" वा वर्णः == "\r" वा वर्णः == "\n") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

फलनम् विरामचिह्नम्_अस्ति(वर्णः) {
    यदि (वर्णः == "(" वा वर्णः == ")" वा वर्णः == "{" वा वर्णः == "}" वा
         वर्णः == "[" वा वर्णः == "]" वा वर्णः == ";" वा वर्णः == "," वा
         वर्णः == "+" वा वर्णः == "-" वा वर्णः == "*" वा वर्णः == "/" वा
         वर्णः == "%" वा वर्णः == "=" वा वर्णः == "<" वा वर्णः == ">" वा
         वर्णः == "!" वा वर्णः == "&" वा वर्णः == "|" वा
         वर्णः == "==" वा वर्णः == "!=" वा वर्णः == "<=" वा वर्णः == ">=") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

