    कक्षा = कक्षा + "    public static dynamic var_बाइट्कोड्_सङ्कलय(dynamic s) { return PrajnaRuntime.NativeCompileToBytecode(s != null ? s.ToString() : \"\"); }\n";
    कक्षा = कक्षा + "    public static dynamic बाइट्कोड्_निष्पादय(dynamic b) { PrajnaRuntime.NativeRunBytecode(b != null ? b.ToString() : \"\"); return 0; }\n";
    कक्षा = कक्षा + "    public static dynamic var_बाइट्कोड्_निष्पादय(dynamic b) { PrajnaRuntime.NativeRunBytecode(b != null ? b.ToString() : \"\"); return 0; }\n";
    कक्षा = कक्षा + "    public static dynamic स्वदेशी_निर्वाहक_चालय(dynamic s) { PrajnaRuntime.NativeRunSource(s != null ? s.ToString() : \"\"); return 0; }\n";
    कक्षा = कक्षा + "    public static dynamic var_स्वदेशी_निर्वाहक_चालय(dynamic s) { PrajnaRuntime.NativeRunSource(s != null ? s.ToString() : \"\"); return 0; }\n";
    कक्षा = कक्षा + "    public static dynamic स्वायत्त_बिल्डर_रचय(dynamic t, dynamic s) { return PrajnaRuntime.NativeBuildStandalone(s != null ? s.ToString() : \"\", t != null ? t.ToString() : \"\"); }\n";
    कक्षा = कक्षा + "    public static dynamic var_स्वायत्त_बिल्डर_रचय(dynamic t, dynamic s) { return PrajnaRuntime.NativeBuildStandalone(s != null ? s.ToString() : \"\", t != null ? t.ToString() : \"\"); }\n";
    कक्षा = कक्षा + "    public static dynamic स्रोतः_मार्गः_अन्तर्भवति(dynamic s, dynamic sub) { return s != null && s.ToString().EndsWith(sub != null ? sub.ToString() : \"\"); }\n";
    कक्षा = कक्षा + "    public static dynamic var_स्रोतः_मार्गः_अन्तर्भवति(dynamic s, dynamic sub) { return s != null && s.ToString().EndsWith(sub != null ? sub.ToString() : \"\"); }\n";


    कक्षा = कक्षा + फलनानि + "\n";
    कक्षा = कक्षा + "    [STAThread]\n    public static void Main(string[] args) {\n";
    कक्षा = कक्षा + "        string selfExe = System.Diagnostics.Process.GetCurrentProcess().MainModule.FileName;\n";
    कक्षा = कक्षा + "        if (PrajnaRuntime.HasEmbeddedPayload(selfExe)) { PrajnaRuntime.RunEmbeddedPayload(selfExe); return; }\n";
    कक्षा = कक्षा + "        try { Console.OutputEncoding = Encoding.UTF8; Console.InputEncoding = Encoding.UTF8; } catch { }\n";
    कक्षा = कक्षा + "        PrajnaRuntime.CommandLineArgs = args;\n";
    कक्षा = कक्षा + मुख्य_भागः + "\n";
    कक्षा = कक्षा + "    }\n}\n";

    प्रत्यागच्छ आधारः + धावकः + कक्षा;
}

// मुख्य-सङ्कलन-फलनम्
फलनम् सङ्कलय_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः) {
    लिख "प्रज्ञा-स्वदेशी-बाइट्कोड्-सङ्कलनं प्रारभते: " + स्रोतः_मार्गः + " -> " + निर्गम_मार्गः;

    यदि (सञ्चिका_विद्यते(स्रोतः_मार्गः) == असत्यम्) {
        लिख "दोषः: स्रोतःसञ्चिका न लब्धा: " + स्रोतः_मार्गः;
        प्रत्यागच्छ ०;
    }

    चलम् स्रोतः = सञ्चिका_पठ(स्रोतः_मार्गः);
    चलम् बाइट्कोड् = बाइट्कोड्_सङ्कलय(स्रोतः);
    सञ्चिका_लिख(निर्गम_मार्गः, बाइट्कोड्);

    लिख "सङ्कलनं सफलं जातम्! बाइट्कोड्-सञ्चिका: " + निर्गम_मार्गः;
    प्रत्यागच्छ १;
}

// मुख्य-निष्पादन-फलनम् (Pure Native Prajna Stack VM Runner)
फलनम् धावय_सञ्चिकाम्(स्रोतः_मार्गः) {
    यदि (सञ्चिका_विद्यते(स्रोतः_मार्गः) == असत्यम्) {
        लिख "दोषः: सञ्चिका न लब्धा: " + स्रोतः_मार्गः;
        प्रत्यागच्छ ०;
    }

    चलम् सामग्री = सञ्चिका_पठ(स्रोतः_मार्गः);
    यदि (स्रोतः_मार्गः_अन्तर्भवति(स्रोतः_मार्गः, ".prc")) {
        बाइट्कोड्_निष्पादय(सामग्री);
    } अन्यथा {
        स्वदेशी_निर्वाहक_चालय(सामग्री);
    }
    प्रत्यागच्छ १;
}

// स्वयम्भू-निष्पाद्य-निर्माणम् (Standalone Executable Builder without any external compiler)
फलनम् बिल्ड्_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः) {
    लिख "प्रज्ञा-स्वायत्त-बिल्ड् प्रारभते: " + स्रोतः_मार्गः + " -> " + निर्गम_मार्गः;
    यदि (सञ्चिका_विद्यते(स्रोतः_मार्गः) == असत्यम्) {
        लिख "दोषः: स्रोतःसञ्चिका न लब्धा: " + स्रोतः_मार्गः;
        प्रत्यागच्छ ०;
    }
    चलम् स्रोतः = सञ्चिका_पठ(स्रोतः_मार्गः);
    चलम् यशः = स्वायत्त_बिल्डर_रचय(निर्गम_मार्गः, स्रोतः);
    यदि (यशः) {
        लिख "स्वायत्त-निष्पाद्य-सञ्चिका सफला: " + निर्गम_मार्गः;
        प्रत्यागच्छ १;
    } अन्यथा {
        लिख "स्वायत्त-निष्पाद्य-सञ्चिका-निर्माणे दोषः सञ्जातः।";
        प्रत्यागच्छ ०;
    }
}

// मुख्य-कार्यम् (Main CLI Entrypoint)
फलनम् मुख्यम्() {
    चलम् तर्काः = आदेशतर्काः();
    चलम् तर्क_सङ्ख्या = सूची_दीर्घता(तर्काः);

    यदि (तर्क_सङ्ख्या == ० वा सूची_प्राप्नु(तर्काः, ०) == "repl") {
        संवादात्मक_आदेशफलकम्();
        प्रत्यागच्छ ०;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "help" वा सूची_प्राप्नु(तर्काः, ०) == "--help" वा सूची_प्राप्नु(तर्काः, ०) == "-h") {
        लिख "==================================================";
        लिख "प्रज्ञा (Prajna) v1.0.0 — स्वदेशी-बाइट्कोड् तथा निष्पादनतन्त्रम्";
        लिख "==================================================";
        लिख "उपयोगः:";
        लिख "  prajna run <सञ्चिका.pr>          (स्वदेशी-यन्त्रे साक्षात् निष्पादनम्)";
        लिख "  prajna run <सञ्चिका.prc>         (बाइट्कोड्-सञ्चिकायाः निष्पादनम्)";
        लिख "  prajna compile <सञ्चिका.pr> [-o <निर्गम.prc>] (बाइट्कोड्-सङ्कलनम्)";
        लिख "  prajna build <सञ्चिका.pr> [-o <निर्गम.exe>]   (स्वायत्त-निष्पाद्य-निर्माणम्)";
        लिख "  prajna repl                     (संवादात्मक-आदेशफलकम्)";
        लिख "  prajna version                  (संस्करण-प्रदर्शनम्)";
        लिख "  prajna help                     (साहाय्य-प्रदर्शनम्)";
        प्रत्यागच्छ ०;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "version" वा सूची_प्राप्नु(तर्काः, ०) == "-v" वा सूची_प्राप्नु(तर्काः, ०) == "--version") {
        लिख "प्रज्ञा (Prajna) v1.0.0 — संस्कृतभाषाधारिता स्वायत्तसङ्गणकप्रणाली";
        लिख "स्वायत्तम् स्वदेशी-बाइट्कोड्-सङ्कलकः तथा काष्ठकम् (Prajna-BC-1 Native Engine)";
        लिख "सर्वाधिकारः सुरक्षिताः © २०२६";
        प्रत्यागच्छ ०;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "compile") {
        यदि (तर्क_सङ्ख्या < २) {
            लिख "दोषः: स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् स्रोतः_मार्गः = सूची_प्राप्नु(तर्काः, १);
        चलम् निर्गम_मार्गः = "prajna_output.prc";

        चलम् अनुक्रमः = २;
        यावत् (अनुक्रमः < तर्क_सङ्ख्या) {
            यदि (सूची_प्राप्नु(तर्काः, अनुक्रमः) == "-o" तथा अनुक्रमः + १ < तर्क_सङ्ख्या) {
                निर्गम_मार्गः = सूची_प्राप्नु(तर्काः, अनुक्रमः + १);
                अनुक्रमः = अनुक्रमः + २;
            } अन्यथा {
                अनुक्रमः = अनुक्रमः + १;
            }
        }

        चलम् यशः = सङ्कलय_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः);
        प्रत्यागच्छ यशः;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "run") {
        यदि (तर्क_सङ्ख्या < २) {
            लिख "दोषः: स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् स्रोतः_मार्गः = सूची_प्राप्नु(तर्काः, १);
        चलम् यशः = धावय_सञ्चिकाम्(स्रोतः_मार्गः);
        प्रत्यागच्छ यशः;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "build") {
        यदि (तर्क_सङ्ख्या < २) {
            लिख "दोषः: स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् स्रोतः_मार्गः = सूची_प्राप्नु(तर्काः, १);
        चलम् निर्गम_मार्गः = "prajna_app.exe";

        चलम् अनुक्रमः = २;
        यावत् (अनुक्रमः < तर्क_सङ्ख्या) {
            यदि (सूची_प्राप्नु(तर्काः, अनुक्रमः) == "-o" तथा अनुक्रमः + १ < तर्क_सङ्ख्या) {
                निर्गम_मार्गः = सूची_प्राप्नु(तर्काः, अनुक्रमः + १);
                अनुक्रमः = अनुक्रमः + २;
            } अन्यथा {
                अनुक्रमः = अनुक्रमः + १;
            }
        }

        चलम् यशः = बिल्ड्_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः);
        प्रत्यागच्छ यशः;
    }

    लिख "अज्ञातः आदेशः: " + सूची_प्राप्नु(तर्काः, ०);
    प्रत्यागच्छ १;
}

मुख्यम्();
