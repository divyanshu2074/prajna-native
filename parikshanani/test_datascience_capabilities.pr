// ============================================================================
// प्रज्ञा (Prajna) — सांख्यिकी तथा दत्ततालिका-परीक्षणम् (Data Science & Stats Test)
// सञ्चिका: parikshanani/test_datascience_capabilities.pr
// ============================================================================

लिख "=== प्रज्ञा सांख्यिकी तथा दत्ततालिका-परीक्षणं प्रारभते ===";

// १. दत्ततालिका (DataFrames) परीक्षणम्
लिख "\n[१] दत्ततालिका (DataFrame) परीक्षणम्:";
चलम् स्तम्भाः = सूची_रचय();
सूची_योजय(स्तम्भाः, "नाम");
सूची_योजय(स्तम्भाः, "वयः");
सूची_योजय(स्तम्भाः, "अङ्काः");

चलम् तालिका = तालिका_रचय(स्तम्भाः);

चलम् पङ्क्ति१ = सूची_रचय();
सूची_योजय(पङ्क्ति१, "आर्यभटः");
सूची_योजय(पङ्क्ति१, २३);
सूची_योजय(पङ्क्ति१, ९८.५);
तालिका_पङ्क्ति_योजय(तालिका, पङ्क्ति१);

चलम् पङ्क्ति२ = सूची_रचय();
सूची_योजय(पङ्क्ति२, "वराहमिहिरः");
सूची_योजय(पङ्क्ति२, ३५);
सूची_योजय(पङ्क्ति२, ९२.०);
तालिका_पङ्क्ति_योजय(तालिका, पङ्क्ति२);

चलम् पङ्क्ति३ = सूची_रचय();
सूची_योजय(पङ्क्ति३, "भास्कराचार्यः");
सूची_योजय(पङ्क्ति३, ३०);
सूची_योजय(पङ्क्ति३, ९६.०);
तालिका_पङ्क्ति_योजय(तालिका, पङ्क्ति३);

लिख तालिका_संक्षेपः(तालिका);

चलम् नाम_स्तम्भः = तालिका_स्तम्भ_प्राप्नु(तालिका, "नाम");
लिख "विद्वन्नामानि: " + सूत्र_परिवर्तय(नाम_स्तम्भः);

चलम् अङ्क_स्तम्भः = तालिका_स्तम्भ_प्राप्नु(तालिका, "अङ्काः");
लिख "अङ्क-स्तम्भः: " + सूत्र_परिवर्तय(अङ्क_स्तम्भः);

// २. CSV सञ्चिका-पठनं लेखनं च (CSV I/O)
लिख "\n[२] CSV सञ्चिका-परीक्षणम्:";
चलम् csv_मार्गः = "_test_data.csv";
दत्त_लिख_csv(तालिका, csv_मार्गः);

चलम् आगता_तालिका = दत्त_पठ_csv(csv_मार्गः);
लिख "आगतायाः तालिकायाः संक्षेपः:";
लिख तालिका_संक्षेपः(आगता_तालिका);
सञ्चिका_लोपय(csv_मार्गः);

// ३. संख्याव्यूहः (Matrix Algebra)
लिख "\n[३] संख्याव्यूहः (Matrix Operations) परीक्षणम्:";
चलम् मू१ = सूची_रचय();
सूची_योजय(मू१, १.०); सूची_योजय(मू१, २.०);
सूची_योजय(मू१, ३.०); सूची_योजय(मू१, ४.०);
चलम् व्यूह_क = व्यूह_रचय(२, २, मू१);

चलम् मू२ = सूची_रचय();
सूची_योजय(मू२, २.०); सूची_योजय(मू२, ०.०);
सूची_योजय(मू२, १.०); सूची_योजय(मू२, २.०);
चलम् व्यूह_ख = व्यूह_रचय(२, २, मू२);

चलम् व्यूह_गुणितम् = व्यूह_गुणनम्(व्यूह_क, व्यूह_ख);
लिख "व्यूह-गुणनफलम् [०, ०] = " + सूत्र_परिवर्तय(व्यूह_प्राप्नु(व्यूह_गुणितम्, ०, ०)); // 1*2 + 2*1 = 4
लिख "व्यूह-गुणनफलम् [०, १] = " + सूत्र_परिवर्तय(व्यूह_प्राप्नु(व्यूह_गुणितम्, ०, १)); // 1*0 + 2*2 = 4
लिख "व्यूह-गुणनफलम् [१, ०] = " + सूत्र_परिवर्तय(व्यूह_प्राप्नु(व्यूह_गुणितम्, १, ०)); // 3*2 + 4*1 = 10
लिख "व्यूह-गुणनफलम् [१, १] = " + सूत्र_परिवर्तय(व्यूह_प्राप्नु(व्यूह_गुणितम्, १, १)); // 3*0 + 4*2 = 8

चलम् व्यूह_परिवर्तितम् = व्यूह_परिवर्तः(व्यूह_क);
लिख "परिवर्तित-व्यूहः [०, १] = " + सूत्र_परिवर्तय(व्यूह_प्राप्नु(व्यूह_परिवर्तितम्, ०, १)); // was [1, 0] = 3

चलम् सदिश१ = सूची_रचय();
सूची_योजय(सदिश१, १.०); सूची_योजय(सदिश१, ३.०); सूची_योजय(सदिश१, -५.०);
चलम् सदिश२ = सूची_रचय();
सूची_योजय(सदिश२, ४.०); सूची_योजय(सदिश२, -२.०); सूची_योजय(सदिश२, -१.०);
चलम् अदिशफलम् = सदिश_अदिशगुणनम्(सदिश१, सदिश२); // 4 - 6 + 5 = 3
लिख "सदिश-अदिशगुणनम् (Dot Product) = " + सूत्र_परिवर्तय(अदिशफलम्);

// ४. सांख्यिकी (Statistical Computing & Regression)
लिख "\n[४] सांख्यिकी (Statistics) परीक्षणम्:";
चलम् आंकडा = सूची_रचय();
सूची_योजय(आंकडा, १०.०);
सूची_योजय(आंकडा, १२.०);
सूची_योजय(आंकडा, २३.०);
सूची_योजय(आंकडा, २३.०);
सूची_योजय(आंकडा, १६.०);
सूची_योजय(आंकडा, २३.०);
सूची_योजय(आंकडा, २१.०);
सूची_योजय(आंकडा, १६.०);

चलम् माध्यम् = सांख्यिकी_माध्यम्(आंकडा);
चलम् मध्यिका = सांख्यिकी_मध्यिका(आंकडा);
चलम् विचरणम् = सांख्यिकी_विचरणम्(आंकडा);
चलम् प्रमा_वि = सांख्यिकी_प्रमाणविचलनम्(आंकडा);

लिख "माध्यम् (Mean) = " + सूत्र_परिवर्तय(माध्यम्);
लिख "मध्यिका (Median) = " + सूत्र_परिवर्तय(मध्यिका);
लिख "विचरणम् (Variance) = " + सूत्र_परिवर्तय(विचरणम्);
लिख "प्रमाणविचलनम् (StdDev) = " + सूत्र_परिवर्तय(प्रमा_वि);

// सहसम्बन्धः तथा समाश्रयणम् (Correlation & Linear Regression)
चलम् x_सूची = सूची_रचय();
सूची_योजय(x_सूची, १.०); सूची_योजय(x_सूची, २.०); सूची_योजय(x_सूची, ३.०); सूची_योजय(x_सूची, ४.०); सूची_योजय(x_सूची, ५.०);

चलम् y_सूची = सूची_रचय();
सूची_योजय(y_सूची, २.०); सूची_योजय(y_सूची, ४.०); सूची_योजय(y_सूची, ५.०); सूची_योजय(y_सूची, ४.०); सूची_योजय(y_सूची, ५.०);

चलम् सम्बन्धः = सांख्यिकी_सहसम्बन्धः(x_सूची, y_सूची);
लिख "सहसम्बन्धः (Correlation) = " + सूत्र_परिवर्तय(सम्बन्धः);

चलम् समाश्रय = सांख्यिकी_समाश्रयणम्(x_सूची, y_सूची);
चलम् प्रवणता = सूची_प्राप्नु(समाश्रय, ०);
चलम् अन्तःखण्डः = सूची_प्राप्नु(समाश्रय, १);
लिख "समाश्रयण-प्रवणता (Slope m) = " + सूत्र_परिवर्तय(प्रवणता);
लिख "समाश्रयण-अन्तःखण्डः (Intercept c) = " + सूत्र_परिवर्तय(अन्तःखण्डः);

लिख "\n=== सर्वं सांख्यिकी तथा दत्ततालिका-परीक्षणं १००% सफलम् जातम्! ===";
