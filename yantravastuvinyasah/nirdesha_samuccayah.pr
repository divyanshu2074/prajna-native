// ============================================================================
// प्रज्ञा (Prajna) — स्वकीयः सङ्गणकनिर्देशसमुच्चयः (Prajna-ISA-1 Specification)
// सञ्चिका: prajna/yantravastuvinyasah/nirdesha_samuccayah.pr
// ============================================================================

// ओपकोड्-स्थिराणि (Opcodes)
फलनम् ओप_विराम() { प्रत्यागच्छ ०; }         // HALT (0x00)
फलनम् ओप_स्थापय() { प्रत्यागच्छ १; }        // LI Rd, imm (0x01)
फलनम् ओप_स्मृति_पठ() { प्रत्यागच्छ २; }     // LOAD Rd, [Rs1 + imm] (0x02)
फलनम् ओप_स्मृति_लेख() { प्रत्यागच्छ ३; }    // STORE Rs2, [Rs1 + imm] (0x03)

फलनम् ओप_योग() { प्रत्यागच्छ १६; }          // ADD Rd, Rs1, Rs2 (0x10)
फलनम् ओप_योग_इ() { प्रत्यागच्छ १७; }        // ADDI Rd, Rs1, imm (0x11)
फलनम् ओप_व्यवकलन() { प्रत्यागच्छ १८; }     // SUB Rd, Rs1, Rs2 (0x12)
फलनम् ओप_गुणन() { प्रत्यागच्छ १९; }         // MUL Rd, Rs1, Rs2 (0x13)
फलनम् ओप_भाग() { प्रत्यागच्छ २०; }          // DIV Rd, Rs1, Rs2 (0x14)
फलनम् ओप_शेषफल() { प्रत्यागच्छ २१; }        // MOD Rd, Rs1, Rs2 (0x15)

फलनम् ओप_समान() { प्रत्यागच्छ ३२; }         // CMP_EQ Rd, Rs1, Rs2 (0x20)
फलनम् ओप_असमान() { प्रत्यागच्छ ३३; }       // CMP_NE Rd, Rs1, Rs2 (0x21)
फलनम् ओप_न्यून() { प्रत्यागच्छ ३४; }         // CMP_LT Rd, Rs1, Rs2 (0x22)
फलनम् ओप_अधिक() { प्रत्यागच्छ ३५; }         // CMP_GT Rd, Rs1, Rs2 (0x23)

फलनम् ओप_तथा() { प्रत्यागच्छ ४८; }          // AND Rd, Rs1, Rs2 (0x30)
फलनम् ओप_वा() { प्रत्यागच्छ ४९; }           // OR Rd, Rs1, Rs2 (0x31)
फलनम् ओप_न() { प्रत्यागच्छ ५०; }            // NOT Rd, Rs1 (0x32)

फलनम् ओप_गच्छ() { प्रत्यागच्छ ६४; }         // JUMP offset (0x40)
फलनम् ओप_यदि_शून्यम्() { प्रत्यागच्छ ६५; }  // BR_ZERO Rs1, offset (0x41)
फलनम् ओप_लिख() { प्रत्यागच्छ ८०; }          // OUT Rs1 (0x50)

// निर्देश-संरचना (Instruction Dictionary)
फलनम् निर्देश३२_रचय(ओपकोड्, आर_डी, आर_एस१, आर_एस२, तत्कालिकम्) {
    चलम् नि = कोष_रचय();
    कोष_स्थापय(नि, "ओपकोड्", ओपकोड्);
    कोष_स्थापय(नि, "आर_डी", आर_डी);
    कोष_स्थापय(नि, "आर_एस१", आर_एस१);
    कोष_स्थापय(नि, "आर_एस२", आर_एस२);
    कोष_स्थापय(नि, "तत्कालिकम्", तत्कालिकम्);
    प्रत्यागच्छ नि;
}

// निर्देशस्य असेंबली-विवरणम्
फलनम् निर्देश३२_विवरणम्(नि) {
    चलम् ओप = कोष_प्राप्नु(नि, "ओपकोड्");
    चलम् आरडी = सूत्र_परिवर्तय(कोष_प्राप्नु(नि, "आर_डी"));
    चलम् आरएस१ = सूत्र_परिवर्तय(कोष_प्राप्नु(नि, "आर_एस१"));
    चलम् आरएस२ = सूत्र_परिवर्तय(कोष_प्राप्नु(नि, "आर_एस२"));
    चलम् तत् = सूत्र_परिवर्तय(कोष_प्राप्नु(नि, "तत्कालिकम्"));

    यदि (ओप == ओप_स्थापय()) {
        प्रत्यागच्छ "LI R" + आरडी + ", " + तत्;
    }
    यदि (ओप == ओप_योग()) {
        प्रत्यागच्छ "ADD R" + आरडी + ", R" + आरएस१ + ", R" + आरएस२;
    }
    यदि (ओप == ओप_योग_इ()) {
        प्रत्यागच्छ "ADDI R" + आरडी + ", R" + आरएस१ + ", " + तत्;
    }
    यदि (ओप == ओप_व्यवकलन()) {
        प्रत्यागच्छ "SUB R" + आरडी + ", R" + आरएस१ + ", R" + आरएस२;
    }
    यदि (ओप == ओप_गुणन()) {
        प्रत्यागच्छ "MUL R" + आरडी + ", R" + आरएस१ + ", R" + आरएस२;
    }
    यदि (ओप == ओप_लिख()) {
        प्रत्यागच्छ "OUT R" + आरएस१;
    }
    यदि (ओप == ओप_विराम()) {
        प्रत्यागच्छ "HALT";
    }
    प्रत्यागच्छ "INST(" + सूत्र_परिवर्तय(ओप) + ")";
}

// निर्देशसमुच्चय-परीक्षणम् (Self-test)
फलनम् निर्देशसमुच्चय_परीक्षणम्() {
    लिख "--- [परीक्षणम्: Prajna-ISA-1 निर्देशसमुच्चयः] ---";
    चलम् नि१ = निर्देश३२_रचय(ओप_स्थापय(), २, ०, ०, १००);
    लिख निर्देश३२_विवरणम्(नि१);

    चलम् नि२ = निर्देश३२_रचय(ओप_स्थापय(), ३, ०, ०, ५०);
    लिख निर्देश३२_विवरणम्(नि२);

    चलम् नि३ = निर्देश३२_रचय(ओप_योग(), ४, २, ३, ०);
    लिख निर्देश३२_विवरणम्(नि३);

    चलम् नि४ = निर्देश३२_रचय(ओप_लिख(), ०, ४, ०, ०);
    लिख निर्देश३२_विवरणम्(नि४);

    चलम् नि५ = निर्देश३२_रचय(ओप_विराम(), ०, ०, ०, ०);
    लिख निर्देश३२_विवरणम्(नि५);

    लिख "Prajna-ISA-1 निर्देशसमुच्चय-परीक्षणं सम्पूर्णम्!\n";
}

निर्देशसमुच्चय_परीक्षणम्();
