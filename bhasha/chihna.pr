// ============================================================================
// प्रज्ञा (Prajna) — चिह्नानि (Tokens and Token Types)
// सञ्चिका: prajna/bhasha/chihna.pr
// ============================================================================

// चिह्नप्रकाराः (Token Type Functions)
फलनम् चिह्न_चलम्() { प्रत्यागच्छ "CHALAM"; }
फलनम् चिह्न_स्थिरम्() { प्रत्यागच्छ "STHIRAM"; }
फलनम् चिह्न_यदि() { प्रत्यागच्छ "YADI"; }
फलनम् चिह्न_अन्यथा() { प्रत्यागच्छ "ANYATHA"; }
फलनम् चिह्न_यावत्() { प्रत्यागच्छ "YAVAT"; }
फलनम् चिह्न_फलनम्() { प्रत्यागच्छ "PHALANAM"; }
फलनम् चिह्न_प्रत्यागच्छ() { प्रत्यागच्छ "PRATYAGACCHA"; }
फलनम् चिह्न_लिख() { प्रत्यागच्छ "LIKHA"; }
फलनम् चिह्न_सत्यम्() { प्रत्यागच्छ "SATYAM"; }
फलनम् चिह्न_असत्यम्() { प्रत्यागच्छ "ASATYAM"; }
फलनम् चिह्न_तथा() { प्रत्यागच्छ "TATHA"; }
फलनम् चिह्न_वा() { प्रत्यागच्छ "VA"; }
फलनम् चिह्न_न() { प्रत्यागच्छ "NA"; }

फलनम् चिह्न_पूर्णाङ्क() { प्रत्यागच्छ "PURNANKA"; }
फलनम् चिह्न_दशमलव() { प्रत्यागच्छ "DASHAMALAVA"; }
फलनम् चिह्न_सूत्रम्() { प्रत्यागच्छ "SUTRAM"; }
फलनम् चिह्न_नामन्() { प्रत्यागच्छ "NAMAN"; }

फलनम् चिह्न_योग() { प्रत्यागच्छ "YOGA"; }               // +
फलनम् चिह्न_व्यवकलन() { प्रत्यागच्छ "VYAVAKALANA"; }     // -
फलनम् चिह्न_गुणन() { प्रत्यागच्छ "GUNANA"; }             // *
फलनम् चिह्न_भाग() { प्रत्यागच्छ "BHAGA"; }               // /
फलनम् चिह्न_शेषफल() { प्रत्यागच्छ "SHESHAPHALA"; }       // %

फलनम् चिह्न_नियोजन() { प्रत्यागच्छ "NIYOJANA"; }         // =
फलनम् चिह्न_समान() { प्रत्यागच्छ "SAMANA"; }             // ==
फलनम् चिह्न_असमान() { प्रत्यागच्छ "ASAMANA"; }           // !=
फलनम् चिह्न_न्यून() { प्रत्यागच्छ "NYUNA"; }             // <
फलनम् चिह्न_अधिक() { प्रत्यागच्छ "ADHIKA"; }             // >
फलनम् चिह्न_न्यून_समान() { प्रत्यागच्छ "NYUNA_SAMANA"; }   // <=
फलनम् चिह्न_अधिक_समान() { प्रत्यागच्छ "ADHIKA_SAMANA"; }  // >=

फलनम् चिह्न_वाम_कोष्ठक() { प्रत्यागच्छ "VAMA_KOSHTHAKA"; }        // (
फलनम् चिह्न_दक्षिण_कोष्ठक() { प्रत्यागच्छ "DAKSHINA_KOSHTHAKA"; }  // )
फलनम् चिह्न_वाम_धनुष() { प्रत्यागच्छ "VAMA_DHANUSH"; }            // {
फलनम् चिह्न_दक्षिण_धनुष() { प्रत्यागच्छ "DAKSHINA_DHANUSH"; }      // }
फलनम् चिह्न_वाम_चतुरश्र() { प्रत्यागच्छ "VAMA_CHATURASHRA"; }      // [
फलनम् चिह्न_दक्षिण_चतुरश्र() { प्रत्यागच्छ "DAKSHINA_CHATURASHRA"; }  // ]
फलनम् चिह्न_अल्पविराम() { प्रत्यागच्छ "ALPABHIRAMA"; }            // ,
फलनम् चिह्न_अर्धविराम() { प्रत्यागच्छ "ARDHAVIRAAMA"; }            // ;
फलनम् चिह्न_पङ्क्तिविराम() { प्रत्यागच्छ "PANKTI_VIRAAMA"; }       // \n
फलनम् चिह्न_समाप्ति() { प्रत्यागच्छ "SAMAPTIH"; }                 // EOF

// चिह्न-निर्माणम् (Token Construction as a Dictionary)
फलनम् चिह्न_रचय(चिह्न_भेदः, चिह्न_मूल्यम्, पङ्क्ति_सङ्ख्या, स्तम्भ_सङ्ख्या) {
    चलम् च = कोष_रचय();
    कोष_स्थापय(च, "भेदः", चिह्न_भेदः);
    कोष_स्थापय(च, "मूल्यम्", चिह्न_मूल्यम्);
    कोष_स्थापय(च, "पङ्क्तिः", पङ्क्ति_सङ्ख्या);
    कोष_स्थापय(च, "स्तम्भः", स्तम्भ_सङ्ख्या);
    प्रत्यागच्छ च;
}

// मुख्यशब्द-परीक्षणम्
फलनम् मुख्यशब्दः_अस्ति(शब्दः) {
    यदि (शब्दः == "चलम्" वा शब्दः == "स्थिरम्" वा शब्दः == "यदि" वा शब्दः == "अन्यथा" वा
         शब्दः == "यावत्" वा शब्दः == "फलनम्" वा शब्दः == "प्रत्यागच्छ" वा शब्दः == "लिख" वा
         शब्दः == "सत्यम्" वा शब्दः == "असत्यम्" वा शब्दः == "तथा" वा शब्दः == "वा" वा शब्दः == "न") {
        प्रत्यागच्छ सत्यम्;
    }
    प्रत्यागच्छ असत्यम्;
}

// मुख्यशब्दस्य चिह्नप्रकारः
फलनम् मुख्यशब्द_चिह्नम्(शब्दः) {
    यदि (शब्दः == "चलम्") { प्रत्यागच्छ चिह्न_चलम्(); }
    यदि (शब्दः == "स्थिरम्") { प्रत्यागच्छ चिह्न_स्थिरम्(); }
    यदि (शब्दः == "यदि") { प्रत्यागच्छ चिह्न_यदि(); }
    यदि (शब्दः == "अन्यथा") { प्रत्यागच्छ चिह्न_अन्यथा(); }
    यदि (शब्दः == "यावत्") { प्रत्यागच्छ चिह्न_यावत्(); }
    यदि (शब्दः == "फलनम्") { प्रत्यागच्छ चिह्न_फलनम्(); }
    यदि (शब्दः == "प्रत्यागच्छ") { प्रत्यागच्छ चिह्न_प्रत्यागच्छ(); }
    यदि (शब्दः == "लिख") { प्रत्यागच्छ चिह्न_लिख(); }
    यदि (शब्दः == "सत्यम्") { प्रत्यागच्छ चिह्न_सत्यम्(); }
    यदि (शब्दः == "असत्यम्") { प्रत्यागच्छ चिह्न_असत्यम्(); }
    यदि (शब्दः == "तथा") { प्रत्यागच्छ चिह्न_तथा(); }
    यदि (शब्दः == "वा") { प्रत्यागच्छ चिह्न_वा(); }
    यदि (शब्दः == "न") { प्रत्यागच्छ चिह्न_न(); }
    प्रत्यागच्छ चिह्न_नामन्();
}

// चिह्नस्य मुद्रणविवरणम्
फलनम् चिह्न_विवरणम्(चिह्नम्) {
    चलम् प्र = कोष_प्राप्नु(चिह्नम्, "भेदः");
    चलम् मू = सूत्र_परिवर्तय(कोष_प्राप्नु(चिह्नम्, "मूल्यम्"));
    चलम् पं = सूत्र_परिवर्तय(कोष_प्राप्नु(चिह्नम्, "पङ्क्तिः"));
    चलम् स्त = सूत्र_परिवर्तय(कोष_प्राप्नु(चिह्नम्, "स्तम्भः"));
    प्रत्यागच्छ "चिह्नम्(" + प्र + ", '" + मू + "', " + पं + ":" + स्त + ")";
}

// चिह्नव्यवस्था-परीक्षणम् (Self-test)
फलनम् चिह्न_परीक्षणम्() {
    लिख "--- [परीक्षणम्: चिह्नव्यवस्था] ---";
    चलम् च१ = चिह्न_रचय(चिह्न_चलम्(), "चलम्", १, १);
    लिख चिह्न_विवरणम्(च१);
    चलम् च२ = चिह्न_रचय(चिह्न_पूर्णाङ्क(), १००, १, ६);
    लिख चिह्न_विवरणम्(च२);
    लिख "मुख्यशब्दः_अस्ति('यावत्') = " + सूत्र_परिवर्तय(मुख्यशब्दः_अस्ति("यावत्"));
    लिख "चिह्नव्यवस्था-परीक्षणं सम्पूर्णम्!\n";
}

चिह्न_परीक्षणम्();
