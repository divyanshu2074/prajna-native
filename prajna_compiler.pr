            }
            चलम् पङ्क्तिः = "catch (Exception var_" + दोष_नाम + ") {\n";
            यदि (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) == "{") {
                सूचकः = सूचकः + १;
            }
            खण्ड_स्तरः = खण्ड_स्तरः + १;
            यदि (फलन_अन्तर्गतम्) {
                फलनानि = फलनानि + "        " + पङ्क्तिः;
            } अन्यथा {
                मुख्य_भागः = मुख्य_भागः + "        " + पङ्क्तिः;
            }
        } अन्यथा यदि (चिह्नम् == "अन्ते") {
            चलम् पङ्क्तिः = "finally {\n";
            सूचकः = सूचकः + १;
            यदि (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) == "{") {
                सूचकः = सूचकः + १;
            }
            खण्ड_स्तरः = खण्ड_स्तरः + १;
            यदि (फलन_अन्तर्गतम्) {
                फलनानि = फलनानि + "        " + पङ्क्तिः;
            } अन्यथा {
                मुख्य_भागः = मुख्य_भागः + "        " + पङ्क्तिः;
            }
        } अन्यथा यदि (चिह्नम् == "उत्थापय") {
            चलम् पङ्क्तिः = "throw new Exception(PrajnaRuntime.Format(";
            सूचकः = सूचकः + १;
            यावत् (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) != ";") {
                पङ्क्तिः = पङ्क्तिः + पद_रूपान्तरम्(सूची_प्राप्नु(चिह्नानि, सूचकः));
                सूचकः = सूचकः + १;
            }
            पङ्क्तिः = पङ्क्तिः + "));\n";
            यदि (फलन_अन्तर्गतम्) {
                फलनानि = फलनानि + "        " + पङ्क्तिः;
            } अन्यथा {
                मुख्य_भागः = मुख्य_भागः + "        " + पङ्क्तिः;
            }
            यदि (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) == ";") {
                सूचकः = सूचकः + १;
            }
        } अन्यथा यदि (चिह्नम् == "}") {
            // ७. खण्डसमाप्तिः
            खण्ड_स्तरः = खण्ड_स्तरः - १;
            यदि (फलन_अन्तर्गतम् तथा खण्ड_स्तरः <= ०) {
                फलनानि = फलनानि + "        return null;\n    }\n\n";
                फलन_अन्तर्गतम् = असत्यम्;
                खण्ड_स्तरः = ०;
            } अन्यथा यदि (फलन_अन्तर्गतम्) {
                फलनानि = फलनानि + "        }\n";
            } अन्यथा {
                मुख्य_भागः = मुख्य_भागः + "        }\n";
            }
            सूचकः = सूचकः + १;
        } अन्यथा {
            // ८. अन्यानि वाक्यानि (Assignments, method calls)
            चलम् पङ्क्तिः = "";
            यावत् (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) != ";") {
                पङ्क्तिः = पङ्क्तिः + पद_रूपान्तरम्(सूची_प्राप्नु(चिह्नानि, सूचकः));
                सूचकः = सूचकः + १;
            }
            पङ्क्तिः = पङ्क्तिः + ";\n";
            यदि (फलन_अन्तर्गतम्) {
                फलनानि = फलनानि + "        " + पङ्क्तिः;
            } अन्यथा {
                मुख्य_भागः = मुख्य_भागः + "        " + पङ्क्तिः;
            }
            यदि (सूचकः < दीर्घता तथा सूची_प्राप्नु(चिह्नानि, सूचकः) == ";") {
                सूचकः = सूचकः + १;
            }
        }
    }

    प्रत्यागच्छ सूची_द्वयम्(फलनानि, मुख्य_भागः);
}

// C# सम्पूर्ण-सङ्केतस्य निर्माणम्
फलनम् सज्जीकुरु_सङ्केतम्(फलनानि, मुख्य_भागः) {
    चलम् आधारः = "// प्रज्ञा (Prajna) स्वयम्भू-सङ्कलकेन निर्मितम्\n";
    आधारः = आधारः + "using System;\nusing System.IO;\nusing System.Text;\nusing System.Net;\nusing System.Drawing;\nusing System.Collections;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.Windows.Forms;\n\n";

    // PrajnaRuntime
    चलम् धावकः = "public static class PrajnaRuntime {\n";
    धावकः = धावकः + "    public static bool DevanagariOutput = true;\n";
    धावकः = धावकः + "    public static string[] CommandLineArgs = new string[0];\n";
    धावकः = धावकः + "    public static string IntToDevanagari(long n) {\n";
    धावकः = धावकः + "        bool neg = n < 0; if (neg) n = -n;\n";
    धावकः = धावकः + "        string s = n.ToString(); StringBuilder sb = new StringBuilder();\n";
    धावकः = धावकः + "        if (neg) sb.Append('-');\n";
    धावकः = धावकः + "        foreach (char ch in s) { if (ch >= '0' && ch <= '9') sb.Append((char)('०' + (ch - '0'))); else sb.Append(ch); }\n";
    धावकः = धावकः + "        return sb.ToString();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static long DevanagariToInt(string s) {\n";
    धावकः = धावकः + "        if (string.IsNullOrEmpty(s)) return 0;\n";
    धावकः = धावकः + "        StringBuilder sb = new StringBuilder();\n";
    धावकः = धावकः + "        foreach (char ch in s.Trim()) {\n";
    धावकः = धावकः + "            if (ch >= '०' && ch <= '९') sb.Append((char)('0' + (ch - '०')));\n";
    धावकः = धावकः + "            else if (ch >= '0' && ch <= '9' || ch == '-' || ch == '+') sb.Append(ch);\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        long res = 0; long.TryParse(sb.ToString(), out res); return res;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string Format(object val) {\n";
    धावकः = धावकः + "        if (val == null) return \"\";\n";
    धावकः = धावकः + "        if (val is bool) return ((bool)val) ? \"सत्यम्\" : \"असत्यम्\";\n";
    धावकः = धावकः + "        if (val is long || val is int) { long v = Convert.ToInt64(val); return DevanagariOutput ? IntToDevanagari(v) : v.ToString(); }\n";
    धावकः = धावकः + "        if (val is double || val is float) return val.ToString();\n";
    धावकः = धावकः + "        if (val is HashSet<object>) {\n";
    धावकः = धावकः + "            var set = (HashSet<object>)val; StringBuilder sb = new StringBuilder(); sb.Append(\"समुच्चयः{\");\n";
    धावकः = धावकः + "            int i = 0; foreach (var x in set) { sb.Append(Format(x)); if (i < set.Count - 1) sb.Append(\", \"); i++; }\n";
    धावकः = धावकः + "            sb.Append(\"}\"); return sb.ToString();\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        if (val is Dictionary<string, object>) {\n";
    धावकः = धावकः + "            var dict = (Dictionary<string, object>)val; StringBuilder sb = new StringBuilder(); sb.Append(\"कोषः{\");\n";
    धावकः = धावकः + "            int i = 0; foreach (var kv in dict) { sb.Append(kv.Key).Append(\": \").Append(Format(kv.Value)); if (i < dict.Count - 1) sb.Append(\", \"); i++; }\n";
    धावकः = धावकः + "            sb.Append(\"}\"); return sb.ToString();\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        if (val is IList) {\n";
    धावकः = धावकः + "            IList list = (IList)val; StringBuilder sb = new StringBuilder(); sb.Append(\"[\");\n";
    धावकः = धावकः + "            for (int i = 0; i < list.Count; i++) { sb.Append(Format(list[i])); if (i < list.Count - 1) sb.Append(\", \" ); }\n";
    धावकः = धावकः + "            sb.Append(\"]\"); return sb.ToString();\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        return val.ToString();\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static void Likha(object val) { Console.WriteLine(Format(val)); }\n";
    धावकः = धावकः + "    public static bool ToBool(object a) {\n";
    धावकः = धावकः + "        if (a is bool) return (bool)a;\n";
    धावकः = धावकः + "        if (a is long) return Convert.ToInt64(a) != 0;\n";
    धावकः = धावकः + "        if (a is int) return Convert.ToInt32(a) != 0;\n";
    धावकः = धावकः + "        if (a is string) return !string.IsNullOrEmpty((string)a);\n";
    धावकः = धावकः + "        return a != null;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static List<object> MakeList(params object[] items) { return new List<object>(items); }\n";
    धावकः = धावकः + "    public static long SutraDirghata(object s) { return s == null ? 0 : s.ToString().Length; }\n";
    धावकः = धावकः + "    public static string SutraKhandam(object s, object st, object l) {\n";
    धावकः = धावकः + "        string str = s == null ? \"\" : s.ToString(); int start = Convert.ToInt32(st); int len = Convert.ToInt32(l);\n";
    धावकः = धावकः + "        if (start < 0) start = 0; if (start >= str.Length) return \"\";\n";
    धावकः = धावकः + "        if (start + len > str.Length) len = str.Length - start; return str.Substring(start, len);\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string VarnaPraptnu(object s, object idx) {\n";
    धावकः = धावकः + "        string str = s == null ? \"\" : s.ToString(); int i = Convert.ToInt32(idx);\n";
    धावकः = धावकः + "        if (i >= 0 && i < str.Length) return str[i].ToString(); return \"\";\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string SutraSambandha(object a, object b) { return (a == null ? \"\" : a.ToString()) + (b == null ? \"\" : b.ToString()); }\n";
    धावकः = धावकः + "    public static long SankhyaParivartaya(object v) { return v == null ? 0 : DevanagariToInt(v.ToString()); }\n";
    धावकः = धावकः + "    public static string SutraParivartaya(object v) { return Format(v); }\n";
    धावकः = धावकः + "    public static List<object> SuchiRachaya() { return new List<object>(); }\n";
    धावकः = धावकः + "    public static List<object> SuchiYojaya(object l, object item) {\n";
    धावकः = धावकः + "        if (l is List<object>) { ((List<object>)l).Add(item); return (List<object>)l; }\n";
    धावकः = धावकः + "        var nl = new List<object>(); nl.Add(item); return nl;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static object SuchiPraptnu(object l, object idx) {\n";
    धावकः = धावकः + "        int i = Convert.ToInt32(idx); if (l is IList) { var list = (IList)l; if (i >= 0 && i < list.Count) return list[i]; } return \"\";\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static object SuchiSthapaya(object l, object idx, object val) {\n";
    धावकः = धावकः + "        int i = Convert.ToInt32(idx); if (l is IList) { ((IList)l)[i] = val; return val; } return null;\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static long SuchiDirghata(object l) { return (l is ICollection) ? ((ICollection)l).Count : 0; }\n";
    धावकः = धावकः + "    public static List<object> SuchiDvayam(object a, object b) { var nl = new List<object>(); nl.Add(a); nl.Add(b); return nl; }\n";
    धावकः = धावकः + "    public static string SanchikaPatha(object p) { return File.ReadAllText(p.ToString(), Encoding.UTF8); }\n";
    धावकः = धावकः + "    public static long SanchikaLekha(object p, object c) { File.WriteAllText(p.ToString(), c == null ? \"\" : c.ToString(), Encoding.UTF8); return 1; }\n";
    धावकः = धावकः + "    public static bool SanchikaVidyate(object p) { return File.Exists(p.ToString()); }\n";
    धावकः = धावकः + "    public static long VatayanamaDarshaya(object t, object m) { MessageBox.Show(m == null ? \"\" : m.ToString(), t == null ? \"प्रज्ञा\" : t.ToString()); return 1; }\n";
    धावकः = धावकः + "    public static string PranaliSanchalakah() {\n";
    धावकः = धावकः + "        int p = (int)Environment.OSVersion.Platform;\n";
    धावकः = धावकः + "        if (p == 4 || p == 128) {\n";
    धावकः = धावकः + "            try { if (File.Exists(\"/etc/os-release\")) { string osRel = File.ReadAllText(\"/etc/os-release\").ToLower(); if (osRel.Contains(\"chromeos\") || osRel.Contains(\"cros\") || Directory.Exists(\"/usr/share/cros\")) return \"chromeos\"; } } catch { }\n";
    धावकः = धावकः + "            return \"linux\";\n";
    धावकः = धावकः + "        }\n";
    धावकः = धावकः + "        if (p == 6 || Directory.Exists(\"/System/Library/CoreServices\")) return \"macos\";\n";
    धावकः = धावकः + "        return \"windows\";\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static string AdeshahNishpadaya(object cmd) {\n";
    धावकः = धावकः + "        try {\n";
    धावकः = धावकः + "            bool isWin = PranaliSanchalakah() == \"windows\";\n";
    धावकः = धावकः + "            string sh = isWin ? \"cmd.exe\" : \"/bin/sh\";\n";
    धावकः = धावकः + "            string arg = isWin ? \"/c \" + cmd.ToString() : \"-c \\\"\" + cmd.ToString().Replace(\"\\\"\", \"\\\\\\\"\") + \"\\\"\";\n";
    धावकः = धावकः + "            ProcessStartInfo psi = new ProcessStartInfo(sh, arg) {\n";
    धावकः = धावकः + "                RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false, CreateNoWindow = true,\n";
    धावकः = धावकः + "                StandardOutputEncoding = Encoding.UTF8, StandardErrorEncoding = Encoding.UTF8\n";
    धावकः = धावकः + "            };\n";
    धावकः = धावकः + "            using (Process p = Process.Start(psi)) { string outStr = p.StandardOutput.ReadToEnd(); p.WaitForExit(); return outStr; }\n";
    धावकः = धावकः + "        } catch (Exception ex) { return \"दोषः: \" + ex.Message; }\n";
    धावकः = धावकः + "    }\n";
    धावकः = धावकः + "    public static List<object> AdeshaTarkah() { var l = new List<object>(); foreach (var a in CommandLineArgs) l.Add(a); return l; }\n";
    धावकः = धावकः + "    public static string SutraVibhajaya(object s, object delim) { string str = s == null ? \"\" : s.ToString(); string d = delim == null ? \" \" : delim.ToString(); return string.Join(\",\", str.Split(new string[] { d }, StringSplitOptions.None)); }\n";
    धावकः = धावकः + "    public static string SutraSamyojaya(object delim, object list) { string d = delim == null ? \"\" : delim.ToString(); if (list is IList) { var parts = new List<string>(); foreach (var item in (IList)list) parts.Add(Format(item)); return string.Join(d, parts.ToArray()); } return \"\"; }\n";
    धावकः = धावकः + "    public static string SutraPratisthapanam(object orig, object o, object n) { string s = orig == null ? \"\" : orig.ToString(); string ov = o == null ? \"\" : o.ToString(); string nv = n == null ? \"\" : n.ToString(); return s.Replace(ov, nv); }\n";
    धावकः = धावकः + "    public static long SutraAnveshanam(object s, object sub) { string str = s == null ? \"\" : s.ToString(); string sb = sub == null ? \"\" : sub.ToString(); return str.IndexOf(sb); }\n";
    धावकः = धावकः + "    public static string SutraChedaya(object s) { return s == null ? \"\" : s.ToString().Trim(); }\n";
    धावकः = धावकः + "    public static bool SutraAarambhah(object s, object pref) { string str = s == null ? \"\" : s.ToString(); string p = pref == null ? \"\" : pref.ToString(); return str.StartsWith(p); }\n";
    धावकः = धावकः + "    public static bool SutraAntah(object s, object suff) { string str = s == null ? \"\" : s.ToString(); string sf = suff == null ? \"\" : suff.ToString(); return str.EndsWith(sf); }\n";
    धावकः = धावकः + "    public static string LaghuVarnamala(object s) { return s == null ? \"\" : s.ToString().ToLower(); }\n";
    धावकः = धावकः + "    public static string GuruVarnamala(object s) { return s == null ? \"\" : s.ToString().ToUpper(); }\n";
    धावकः = धावकः + "    public static List<object> SuchiKhandam(object list, object st, object l) { var res = new List<object>(); if (list is IList) { IList il = (IList)list; int s = Convert.ToInt32(st); int len = Convert.ToInt32(l); for (int i = s; i < s + len && i < il.Count; i++) if (i >= 0) res.Add(il[i]); } return res; }\n";
    धावकः = धावकः + "    public static object SuchiNishkasaya(object list, object idx) { if (list is IList) { IList il = (IList)list; int i = Convert.ToInt32(idx); if (i >= 0 && i < il.Count) { object v = il[i]; il.RemoveAt(i); return v; } } return null; }\n";
    धावकः = धावकः + "    public static object SuchiShodhaya(object list) { if (list is List<object>) { var l = (List<object>)list; l.Sort((a,b) => string.Compare(Format(a), Format(b), StringComparison.Ordinal)); return l; } return list; }\n";
    धावकः = धावकः + "    public static object SuchiViparita(object list) { if (list is List<object>) { var l = (List<object>)list; l.Reverse(); return l; } return list; }\n";
    धावकः = धावकः + "    public static bool SuchiAntarbhavah(object list, object item) { if (list is IList) { foreach (var x in (IList)list) if (Format(x) == Format(item)) return true; } return false; }\n";
    धावकः = धावकः + "    public static List<object> SuchiSamyojaya(object l1, object l2) { var res = new List<object>(); if (l1 is IList) foreach (var x in (IList)l1) res.Add(x); if (l2 is IList) foreach (var x in (IList)l2) res.Add(x); return res; }\n";
    धावकः = धावकः + "    public static long SuchiAnveshanam(object list, object item) { if (list is IList) { IList il = (IList)list; for (int i = 0; i < il.Count; i++) if (Format(il[i]) == Format(item)) return i; } return -1; }\n";
    धावकः = धावकः + "    public static Dictionary<string, object> KoshaRachaya() { return new Dictionary<string, object>(); }\n";
    धावकः = धावकः + "    public static object KoshaSthapaya(object dict, object k, object v) { if (dict is Dictionary<string, object>) { ((Dictionary<string, object>)dict)[k == null ? \"\" : k.ToString()] = v; return dict; } return dict; }\n";
    धावकः = धावकः + "    public static object KoshaPraptnu(object dict, object k) { if (dict is Dictionary<string, object>) { var d = (Dictionary<string, object>)dict; string key = k == null ? \"\" : k.ToString(); if (d.ContainsKey(key)) return d[key]; } return \"\"; }\n";
    धावकः = धावकः + "    public static bool KoshaAsti(object dict, object k) { if (dict is Dictionary<string, object>) { return ((Dictionary<string, object>)dict).ContainsKey(k == null ? \"\" : k.ToString()); } return false; }\n";
    धावकः = धावकः + "    public static object KoshaNishkasaya(object dict, object k) { if (dict is Dictionary<string, object>) { var d = (Dictionary<string, object>)dict; string key = k == null ? \"\" : k.ToString(); if (d.ContainsKey(key)) { object v = d[key]; d.Remove(key); return v; } } return null; }\n";
    धावकः = धावकः + "    public static List<object> KoshaKunchikah(object dict) { var res = new List<object>(); if (dict is Dictionary<string, object>) { foreach (var k in ((Dictionary<string, object>)dict).Keys) res.Add(k); } return res; }\n";
    धावकः = धावकः + "    public static List<object> KoshaMulyani(object dict) { var res = new List<object>(); if (dict is Dictionary<string, object>) { foreach (var v in ((Dictionary<string, object>)dict).Values) res.Add(v); } return res; }\n";
    धावकः = धावकः + "    public static long KoshaDirghata(object dict) { if (dict is Dictionary<string, object>) return ((Dictionary<string, object>)dict).Count; return 0; }\n";
    धावकः = धावकः + "    public static object KoshaSwacchikuru(object dict) { if (dict is Dictionary<string, object>) ((Dictionary<string, object>)dict).Clear(); return dict; }\n";

    // Sets (समुच्चयः)
    धावकः = धावकः + "    public static HashSet<object> SamucchayaRachaya() { return new HashSet<object>(); }\n";
    धावकः = धावकः + "    public static HashSet<object> SamucchayaYojaya(object s, object v) { if (s is HashSet<object>) { ((HashSet<object>)s).Add(Format(v)); } return (HashSet<object>)s; }\n";
    धावकः = धावकः + "    public static bool SamucchayaAsti(object s, object v) { if (s is HashSet<object>) { return ((HashSet<object>)s).Contains(Format(v)); } return false; }\n";
    धावकः = धावकः + "    public static bool SamucchayaNishkasaya(object s, object v) { if (s is HashSet<object>) { return ((HashSet<object>)s).Remove(Format(v)); } return false; }\n";
    धावकः = धावकः + "    public static long SamucchayaDirghata(object s) { if (s is HashSet<object>) return ((HashSet<object>)s).Count; return 0; }\n";
    धावकः = धावकः + "    public static HashSet<object> SamucchayaMelanam(object s1, object s2) { var res = new HashSet<object>(); if (s1 is HashSet<object>) foreach (var x in (HashSet<object>)s1) res.Add(x); if (s2 is HashSet<object>) foreach (var x in (HashSet<object>)s2) res.Add(x); return res; }\n";
    धावकः = धावकः + "    public static HashSet<object> SamucchayaChedah(object s1, object s2) { var res = new HashSet<object>(); if (s1 is HashSet<object> && s2 is HashSet<object>) { var set2 = (HashSet<object>)s2; foreach (var x in (HashSet<object>)s1) if (set2.Contains(x)) res.Add(x); } return res; }\n";
    धावकः = धावकः + "    public static HashSet<object> SamucchayaAntaram(object s1, object s2) { var res = new HashSet<object>(); if (s1 is HashSet<object> && s2 is HashSet<object>) { var set2 = (HashSet<object>)s2; foreach (var x in (HashSet<object>)s1) if (!set2.Contains(x)) res.Add(x); } return res; }\n";
    धावकः = धावकः + "    public static List<object> SamucchayaSuchi(object s) { var res = new List<object>(); if (s is HashSet<object>) foreach (var x in (HashSet<object>)s) res.Add(x); return res; }\n";

