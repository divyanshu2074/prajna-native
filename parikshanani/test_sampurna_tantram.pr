// ============================================================================
// प्रज्ञा (Prajna) — सम्पूर्ण-तन्त्र-परीक्षणमाला (Full System End-to-End Test Suite)
// सञ्चिका: prajna/parikshanani/test_sampurna_tantram.pr
// ============================================================================

फलनम् फिबोनाची(संख्या) {
    यदि (संख्या <= ०) { प्रत्यागच्छ ०; }
    यदि (संख्या == १) { प्रत्यागच्छ १; }
    प्रत्यागच्छ फिबोनाची(संख्या - १) + फिबोनाची(संख्या - २);
}

फलनम् सम्पूर्ण_परीक्षणम्() {
    लिख "==================================================";
    लिख "प्रज्ञा सम्पूर्ण-तन्त्र-परीक्षणम् (End-to-End System Test)";
    लिख "==================================================";

    // १. अङ्कगणितम्
    चलम् योगफलम् = १० + २० * ३ - १५ / ५;
    लिख "१. अङ्कगणित-परीक्षणम्: १० + २० * ३ - १५ / ५ = " + सूत्र_परिवर्तय(योगफलम्);

    // २. यदि-अन्यथा निर्णयः
    चलम् वयः = १८;
    चलम् निर्णयः = "अयोग्यः";
    यदि (वयः >= १८) {
        निर्णयः = "योग्यः";
    } अन्यथा {
        निर्णयः = "अयोग्यः";
    }
    लिख "२. निर्णय-परीक्षणम्: " + निर्णयः;

    // ३. यावत्-चक्रम्
    चलम् गुणनफलम् = १;
    चलम् गणकः = १;
    यावत् (गणकः <= ५) {
        गुणनफलम् = गुणनफलम् * गणकः;
        गणकः = गणकः + १;
    }
    लिख "३. चक्र-परीक्षणम् (५!): " + सूत्र_परिवर्तय(गुणनफलम्);

    // ४. फलन-पुनरावृत्तिः (Fibonacci)
    चलम् फिब_७ = फिबोनाची(७);
    लिख "४. फिबोनाची(७): " + सूत्र_परिवर्तय(फिब_७);

    // ५. गतिशील-सूची (Dynamic Lists)
    चलम् सूची = सूची_रचय();
    सूची_योजय(सूची, "ऋग्वेदः");
    सूची_योजय(सूची, "यजुर्वेदः");
    सूची_योजय(सूची, "सामवेदः");
    सूची_योजय(सूची, "अथर्ववेदः");
    लिख "५. सूची-दीर्घता: " + सूत्र_परिवर्तय(सूची_दीर्घता(सूची));
    लिख "   प्रथम-वेदः: " + सूत्र_परिवर्तय(सूची_प्राप्नु(सूची, ०));

    // ६. शब्दकोषः (Hash Maps / Dictionaries)
    चलम् कोषः = कोष_रचय();
    कोष_स्थापय(कोषः, "सूर्यः", "रविः");
    कोष_स्थापय(कोषः, "चन्द्रः", "शशी");
    कोष_स्थापय(कोषः, "भूमिः", "पृथ्वी");
    लिख "६. कोष-दीर्घता: " + सूत्र_परिवर्तय(कोष_दीर्घता(कोषः));
    लिख "   सूर्यस्य पर्यायः: " + सूत्र_परिवर्तय(कोष_प्राप्नु(कोषः, "सूर्यः"));

    // ७. गणित-पुस्तकालयः (Math Library)
    चलम् वर्गमूलम् = गणित_वर्गमूलम्(१४४);
    चलम् घातः = गणित_घातः(२, १०);
    लिख "७. गणित_वर्गमूलम्(१४४) = " + सूत्र_परिवर्तय(वर्गमूलम्);
    लिख "   गणित_घातः(२, १०) = " + सूत्र_परिवर्तय(घातः);

    लिख "\n==================================================";
    लिख "सर्वे सम्पूर्ण-तन्त्र-परीक्षणाः सफलाः जाताः!";
    लिख "==================================================";
}

सम्पूर्ण_परीक्षणम्();
