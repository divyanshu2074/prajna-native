    कक्षा = कक्षा + "    public static dynamic कोष_प्राप्नु(dynamic a, dynamic b) { return PrajnaRuntime.KoshaPraptnu(a, b); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_अस्ति(dynamic a, dynamic b) { return PrajnaRuntime.KoshaAsti(a, b); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_निष्कासय(dynamic a, dynamic b) { return PrajnaRuntime.KoshaNishkasaya(a, b); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_कुञ्चिकाः(dynamic a) { return PrajnaRuntime.KoshaKunchikah(a); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_मूल्यानि(dynamic a) { return PrajnaRuntime.KoshaMulyani(a); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_दीर्घता(dynamic a) { return PrajnaRuntime.KoshaDirghata(a); }\n";
    कक्षा = कक्षा + "    public static dynamic कोष_स्वच्छीकुरु(dynamic a) { return PrajnaRuntime.KoshaSwacchikuru(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_वर्गमूलम्(dynamic a) { return PrajnaRuntime.GanitaVargamulam(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_घातः(dynamic a, dynamic b) { return PrajnaRuntime.GanitaGhaatah(a, b); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_परममूल्यम्(dynamic a) { return PrajnaRuntime.GanitaParamamulyam(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_ज्या(dynamic a) { return PrajnaRuntime.GanitaJyaa(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_कोज्या(dynamic a) { return PrajnaRuntime.GanitaKojyaa(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_स्पर्शज्या(dynamic a) { return PrajnaRuntime.GanitaSparshajyaa(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_अधः(dynamic a) { return PrajnaRuntime.GanitaAdhah(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_उपरि(dynamic a) { return PrajnaRuntime.GanitaUpari(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_समीपम्(dynamic a) { return PrajnaRuntime.GanitaSamipam(a); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_पाई() { return PrajnaRuntime.GanitaPi(); }\n";
    कक्षा = कक्षा + "    public static dynamic गणित_ई() { return PrajnaRuntime.GanitaE(); }\n";
    कक्षा = कक्षा + "    public static dynamic यादृच्छिक() { return PrajnaRuntime.Yaadrichhika(); }\n";
    कक्षा = कक्षा + "    public static dynamic यादृच्छिक_अन्तराले(dynamic a, dynamic b) { return PrajnaRuntime.YaadrichhikaAntarale(a, b); }\n";
    कक्षा = कक्षा + "    public static dynamic काल_वर्तमान_मिली() { return PrajnaRuntime.KalaVartamanaMili(); }\n";
    कक्षा = कक्षा + "    public static dynamic काल_वर्तमान_क्षणम्() { return PrajnaRuntime.KalaVartamanaKshanam(); }\n";
    कक्षा = कक्षा + "    public static dynamic काल_विराम(dynamic a) { return PrajnaRuntime.KalaVirama(a); }\n";
    कक्षा = कक्षा + "    public static dynamic सञ्चिका_पठ(dynamic p) { return PrajnaRuntime.SanchikaPatha(p); }\n";
    कक्षा = कक्षा + "    public static dynamic सञ्चिका_लिख(dynamic p, dynamic c) { return PrajnaRuntime.SanchikaLekha(p, c); }\n";
    कक्षा = कक्षा + "    public static dynamic सञ्चिका_विद्यते(dynamic p) { return PrajnaRuntime.SanchikaVidyate(p); }\n";
    कक्षा = कक्षा + "    public static dynamic सञ्चिका_लोपय(dynamic a) { return PrajnaRuntime.SanchikaLopaya(a); }\n";
    कक्षा = कक्षा + "    public static dynamic सञ्चिका_निर्देशिका_सूची(dynamic a) { return PrajnaRuntime.SanchikaNirdeshikaSuchi(a); }\n";
    कक्षा = कक्षा + "    public static dynamic निर्देशिका_रचय(dynamic a) { return PrajnaRuntime.NirdeshikaRachaya(a); }\n";
    कक्षा = कक्षा + "    public static dynamic प्रणाली_वातावरणम्(dynamic a) { return PrajnaRuntime.PranaliVatavaranam(a); }\n";
    कक्षा = कक्षा + "    public static dynamic प्रणाली_सञ्चालकः() { return PrajnaRuntime.PranaliSanchalakah(); }\n";
    कक्षा = कक्षा + "    public static dynamic जेसन_रूपान्तरम्(dynamic a) { return PrajnaRuntime.JesonRupantaram(a); }\n";
    कक्षा = कक्षा + "    public static dynamic जेसन_पठ(dynamic a) { return PrajnaRuntime.JesonPatha(a); }\n";
    कक्षा = कक्षा + "    public static dynamic प्रकारः(dynamic a) { return PrajnaRuntime.Prakaarah(a); }\n";
    कक्षा = कक्षा + "    public static dynamic दशांश_परिवर्तय(dynamic a) { return PrajnaRuntime.DashamshaParivartaya(a); }\n";
    कक्षा = कक्षा + "    public static dynamic पूर्णाङ्क_परिवर्तय(dynamic a) { return PrajnaRuntime.PurnankaParivartaya(a); }\n";
    कक्षा = कक्षा + "    public static dynamic वातायनम्_दर्शय(dynamic t, dynamic m) { return PrajnaRuntime.VatayanamaDarshaya(t, m); }\n";
    कक्षा = कक्षा + "    public static dynamic पत्रलेखकम्_आरभस्व(dynamic t, dynamic init) { return PrajnaRuntime.PatralekhakamArabhasva(t, init); }\n";
    कक्षा = कक्षा + "    public static dynamic आदेशः_निष्पादय(dynamic c) { return PrajnaRuntime.AdeshahNishpadaya(c); }\n";
    कक्षा = कक्षा + "    public static dynamic आदेशतर्काः() { return PrajnaRuntime.AdeshaTarkah(); }\n";
    कक्षा = कक्षा + "    public static dynamic बहिर्गच्छ(dynamic c) { PrajnaRuntime.Bahirgaccha(c); return 0; }\n\n";

    कक्षा = कक्षा + फलनानि + "\n";
    कक्षा = कक्षा + "    [STAThread]\n    public static void Main(string[] args) {\n";
    कक्षा = कक्षा + "        try { Console.OutputEncoding = Encoding.UTF8; Console.InputEncoding = Encoding.UTF8; } catch { }\n";
    कक्षा = कक्षा + "        PrajnaRuntime.CommandLineArgs = args;\n";
    कक्षा = कक्षा + मुख्य_भागः + "\n";
    कक्षा = कक्षा + "    }\n}\n";

    प्रत्यागच्छ आधारः + धावकः + कक्षा;
}

// मुख्य-सङ्कलन-फलनम्
फलनम् सङ्कलय_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः, चित्रमयम्) {
    लिख "प्रज्ञा-स्वयम्भू-सङ्कलनं प्रारभते: " + स्रोतः_मार्गः + " -> " + निर्गम_मार्गः;

    यदि (सञ्चिका_विद्यते(स्रोतः_मार्गः) == असत्यम्) {
        लिख "दोषः: स्रोतःसञ्चिका न लब्धा: " + स्रोतः_मार्गः;
        प्रत्यागच्छ ०;
    }

    चलम् स्रोतः = सञ्चिका_पठ(स्रोतः_मार्गः);
    चलम् चिह्नानि = पदच्छेदः(स्रोतः);
    चलम् अनुवाद_भागौ = अनुवादय(चिह्नानि);
    चलम् फलनानि = सूची_प्राप्नु(अनुवाद_भागौ, ०);
    चलम् मुख्य_भागः = सूची_प्राप्नु(अनुवाद_भागौ, १);

    चलम् सम्पूर्ण_सङ्केतः = सज्जीकुरु_सङ्केतम्(फलनानि, मुख्य_भागः);
    चलम् cs_मार्गः = निर्गम_मार्गः + ".cs";

    सञ्चिका_लिख(cs_मार्गः, सम्पूर्ण_सङ्केतः);

    चलम् लक्ष्यम् = "/target:exe";
    यदि (चित्रमयम्) {
        लक्ष्यम् = "/target:winexe";
    }

    चलम् csc = "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe";
    चलम् आदेशः = csc + " /nologo /codepage:65001 /optimize+ " + लक्ष्यम् + " /r:System.dll /r:System.Core.dll /r:Microsoft.CSharp.dll /r:System.Windows.Forms.dll /r:System.Drawing.dll /out:" + निर्गम_मार्गः + " " + cs_मार्गः;

    चलम् परिणामः = आदेशः_निष्पादय(आदेशः);

    यदि (सञ्चिका_विद्यते(निर्गम_मार्गः)) {
        आदेशः_निष्पादय("cmd /c del " + cs_मार्गः);
        लिख "सङ्कलनं सफलं जातम्! निष्पाद्य-सञ्चिका: " + निर्गम_मार्गः;
        प्रत्यागच्छ १;
    } अन्यथा {
        लिख "सङ्कलने दोषः सञ्जातः:\n" + परिणामः;
        प्रत्यागच्छ ०;
    }
}

// मुख्य-कार्यम् (Main CLI Entrypoint)
फलनम् मुख्यम्() {
    चलम् तर्काः = आदेशतर्काः();
    चलम् तर्क_सङ्ख्या = सूची_दीर्घता(तर्काः);

    यदि (तर्क_सङ्ख्या == ० वा सूची_प्राप्नु(तर्काः, ०) == "--help" वा सूची_प्राप्नु(तर्काः, ०) == "-h") {
        लिख "==================================================";
        लिख "प्रज्ञा (Prajna) — स्वयम्भू-सङ्कलकः (Self-Hosted Compiler)";
        लिख "संस्कृतभाषायाः स्वायत्तसङ्गणकप्रणाली";
        लिख "==================================================";
        लिख "उपयोगः:";
        लिख "  prajna compile <सञ्चिका.pr> [-o <निर्गम.exe>] [--gui]";
        लिख "  prajna run <सञ्चिका.pr>";
        लिख "  prajna version";
        प्रत्यागच्छ ०;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "version" वा सूची_प्राप्नु(तर्काः, ०) == "-v" वा सूची_प्राप्नु(तर्काः, ०) == "--version") {
        लिख "प्रज्ञा (Prajna) v1.0.0 — संस्कृतभाषाधारिता स्वायत्तसङ्गणकप्रणाली";
        लिख "Python-निरपेक्षम् स्वयम्भू-निष्पादनतन्त्रम्";
        लिख "सर्वाधिकारः सुरक्षिताः © २०२६";
        प्रत्यागच्छ ०;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "compile") {
        यदि (तर्क_सङ्ख्या < २) {
            लिख "दोषः: स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् स्रोतः_मार्गः = सूची_प्राप्नु(तर्काः, १);
        चलम् निर्गम_मार्गः = "prajna_output.exe";
        चलम् चित्रमयम् = असत्यम्;

        चलम् अनुक्रमः = २;
        यावत् (अनुक्रमः < तर्क_सङ्ख्या) {
            यदि (सूची_प्राप्नु(तर्काः, अनुक्रमः) == "-o" तथा अनुक्रमः + १ < तर्क_सङ्ख्या) {
                निर्गम_मार्गः = सूची_प्राप्नु(तर्काः, अनुक्रमः + १);
                अनुक्रमः = अनुक्रमः + २;
            } अन्यथा यदि (सूची_प्राप्नु(तर्काः, अनुक्रमः) == "--gui") {
                चित्रमयम् = सत्यम्;
                अनुक्रमः = अनुक्रमः + १;
            } अन्यथा {
                अनुक्रमः = अनुक्रमः + १;
            }
        }

        चलम् यशः = सङ्कलय_सञ्चिकाम्(स्रोतः_मार्गः, निर्गम_मार्गः, चित्रमयम्);
        प्रत्यागच्छ यशः;
    }

    यदि (सूची_प्राप्नु(तर्काः, ०) == "run") {
        यदि (तर्क_सङ्ख्या < २) {
            लिख "दोषः: स्रोतःसञ्चिकायाः मार्गः अपेक्षितः।";
            प्रत्यागच्छ १;
        }
        चलम् स्रोतः_मार्गः = सूची_प्राप्नु(तर्काः, १);
        चलम् तात्कालिक_exe = "_prajna_temp.exe";
        चलम् यशः = सङ्कलय_सञ्चिकाम्(स्रोतः_मार्गः, तात्कालिक_exe, असत्यम्);
        यदि (यशः == १) {
            चलम् निर्गमः = आदेशः_निष्पादय(तात्कालिक_exe);
            लिख निर्गमः;
            आदेशः_निष्पादय("cmd /c del " + तात्कालिक_exe);
        }
        प्रत्यागच्छ यशः;
    }

    लिख "अज्ञातः आदेशः: " + सूची_प्राप्नु(तर्काः, ०);
    प्रत्यागच्छ १;
}

मुख्यम्();
