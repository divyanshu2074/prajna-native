    // Networking (जाल-तन्त्रम्)
    धावकः = धावकः + "    public static string JalaPraptnu(object url) { try { using (WebClient wc = new WebClient()) { wc.Encoding = Encoding.UTF8; return wc.DownloadString(url.ToString()); } } catch (Exception ex) { return \"दोषः: \" + ex.Message; } }\n";
    धावकः = धावकः + "    public static string JalaPreshaya(object url, object body) { try { using (WebClient wc = new WebClient()) { wc.Encoding = Encoding.UTF8; wc.Headers[HttpRequestHeader.ContentType] = \"application/json\"; return wc.UploadString(url.ToString(), body == null ? \"\" : body.ToString()); } } catch (Exception ex) { return \"दोषः: \" + ex.Message; } }\n";
    धावकः = धावकः + "    public static long JalaAvataranam(object url, object path) { try { using (WebClient wc = new WebClient()) { wc.DownloadFile(url.ToString(), path.ToString()); return 1; } } catch { return 0; } }\n";

    // Extended Math & Stats
    धावकः = धावकः + "    public static double GanitaLog(object x) { return Math.Log(Convert.ToDouble(x)); }\n";
    धावकः = धावकः + "    public static double GanitaLog10(object x) { return Math.Log10(Convert.ToDouble(x)); }\n";
    धावकः = धावकः + "    public static double GanitaMadhyamam(object list) { if (list is IList) { IList il = (IList)list; if (il.Count > 0) return Yogah(list) / il.Count; } return 0; }\n";
    धावकः = धावकः + "    public static double GanitaMadhyika(object list) { if (list is IList) { var nums = new List<double>(); foreach (var x in (IList)list) { double d = 0; if (double.TryParse(x.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out d)) nums.Add(d); } if (nums.Count > 0) { nums.Sort(); int mid = nums.Count / 2; if (nums.Count % 2 == 1) return nums[mid]; else return (nums[mid - 1] + nums[mid]) / 2.0; } } return 0; }\n";

