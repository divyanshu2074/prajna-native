// ============================================================================
// प्रज्ञा (Prajna) — आँकडाप्रवाह-रेखा (Dataflow Dependency Graph)
// सञ्चिका: prajna/madhyapratinidhih/ankadapravaha_rekha.pr
// ============================================================================

फलनम् आँकडा_बिन्दु_रचय(क्रमाङ्कः, क्रिया, निर्देशः) {
    चलम् बिन्दुः = कोष_रचय();
    कोष_स्थापय(बिन्दुः, "क्रमाङ्कः", क्रमाङ्कः);
    कोष_स्थापय(बिन्दुः, "क्रिया", क्रिया);
    कोष_स्थापय(बिन्दुः, "निर्देशः", निर्देशः);
    कोष_स्थापय(बिन्दुः, "निवेश_स्रोतः", सूची_रचय());
    कोष_स्थापय(बिन्दुः, "निर्गत_लक्ष्यम्", सूची_रचय());
    कोष_स्थापय(बिन्दुः, "स्तरः", ०);
    कोष_स्थापय(बिन्दुः, "सम्पूर्णम्", असत्यम्);
    प्रत्यागच्छ बिन्दुः;
}

फलनम् आँकडा_जाल_रचय() {
    चलम् जालम् = कोष_रचय();
    कोष_स्थापय(जालम्, "बिन्दवः", कोष_रचय());
    कोष_स्थापय(जालम्, "संख्या", ०);
    प्रत्यागच्छ जालम्;
}

फलनम् जाल_बिन्दु_योजय(जालम्, बिन्दुः) {
    चलम् बिन्दवः = कोष_प्राप्नु(जालम्, "बिन्दवः");
    चलम् आइडी = सूत्र_परिवर्तय(कोष_प्राप्नु(बिन्दुः, "क्रमाङ्कः"));
    कोष_स्थापय(बिन्दवः, आइडी, बिन्दुः);
    चलम् सं = कोष_प्राप्नु(जालम्, "संख्या");
    कोष_स्थापय(जालम्, "संख्या", सं + १);
}

फलनम् जाल_सम्बन्ध_योजय(जालम्, स्रोतः_आइडी, लक्ष्य_आइडी) {
    चलम् बिन्दवः = कोष_प्राप्नु(जालम्, "बिन्दवः");
    चलम् स्रो = सूत्र_परिवर्तय(स्रोतः_आइडी);
    चलम् लक्ष = सूत्र_परिवर्तय(लक्ष्य_आइडी);

    यदि (कोष_अस्ति(बिन्दवः, स्रो) तथा कोष_अस्ति(बिन्दवः, लक्ष)) {
        चलम् स्रो_बिन्दु = कोष_प्राप्नु(बिन्दवः, स्रो);
        चलम् लक्ष_बिन्दु = कोष_प्राप्नु(बिन्दवः, लक्ष);
        सूची_योजय(कोष_प्राप्नु(स्रो_बिन्दु, "निर्गत_लक्ष्यम्"), लक्ष्य_आइडी);
        सूची_योजय(कोष_प्राप्नु(लक्ष_बिन्दु, "निवेश_स्रोतः"), स्रोतः_आइडी);
    }
}

// आँकडाप्रवाह-परीक्षणम् (Self-test)
फलनम् आँकडाप्रवाह_परीक्षणम्() {
    लिख "--- [परीक्षणम्: आँकडाप्रवाह-रेखा] ---";
    चलम् जालम् = आँकडा_जाल_रचय();
    चलम् ब१ = आँकडा_बिन्दु_रचय(१, "LOAD_CONST", "१०");
    चलम् ब२ = आँकडा_बिन्दु_रचय(२, "LOAD_CONST", "२०");
    चलम् ब३ = आँकडा_बिन्दु_रचय(३, "ADD", "+");

    जाल_बिन्दु_योजय(जालम्, ब१);
    जाल_बिन्दु_योजय(जालम्, ब२);
    जाल_बिन्दु_योजय(जालम्, ब३);

    जाल_सम्बन्ध_योजय(जालम्, १, ३);
    जाल_सम्बन्ध_योजय(जालम्, २, ३);

    लिख "जालस्य बिन्दुसंख्या = " + सूत्र_परिवर्तय(कोष_प्राप्नु(जालम्, "संख्या"));
    लिख "ब३ निवेशसंख्या = " + सूत्र_परिवर्तय(सूची_दीर्घता(कोष_प्राप्नु(ब३, "निवेश_स्रोतः")));
    लिख "आँकडाप्रवाह-परीक्षणं सम्पूर्णम्!\n";
}

आँकडाप्रवाह_परीक्षणम्();
